---
// Programs component - 9 Certified Training Course Tracks from index.md
import Container from '@/components/Container.astro';
---

<section id="programs" class="relative isolate bg-background text-foreground py-16 md:py-24 border-b border-border" data-ps="src/components/home/Programs.astro:vzf91c">
  <Container>
    <div class="max-w-3xl mb-14" data-ps="src/components/home/Programs.astro:eaa693">
      <h2 class="text-h2 font-bold text-foreground tracking-tight mb-4 reveal" data-ps="src/components/home/Programs.astro:5xwexd">
        FIRST AID AND CPR CERTIFICATION CLASSES
      </h2>
      <p class="text-lg font-semibold text-foreground reveal reveal-delay-1" data-ps="src/components/home/Programs.astro:trmckp">
        Custom Based CPR Certification & First Aid and AED Training for your business, facility, or civic or private groups needs.
      </p>
      <p class="text-base text-muted-foreground mt-2 leading-relaxed reveal reveal-delay-2" data-ps="src/components/home/Programs.astro:trmcko">
        KRE Security will provide the following CPR certification and first aid classes (as approved by the American Heart Association and the American Red Cross) to provide the following customized safety and CPR certification programs such as: healthcare providers and lay rescuers (this includes any course in the AHA and BLS Family of courses curriculum).
      </p>
    </div>

    <!-- 9 Certified Course Tracks Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/components/home/Programs.astro:eaa692">
      <!-- 1. Heartsaver First Aid -->
      <div class="flex flex-col justify-between p-6 bg-surface rounded-xl border border-border hover:border-primary/60 transition-all duration-200 hover:-translate-y-0.5 shadow-sm reveal" data-ps="src/components/home/Programs.astro:eaa691">
        <div data-ps="src/components/home/Programs.astro:eaa690">
          <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Programs.astro:eaa68z">
            <span class="px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider" data-ps="src/components/home/Programs.astro:8sur2f">AHA / Red Cross</span>
            <span class="text-xs text-muted-foreground font-medium" data-ps="src/components/home/Programs.astro:8sur2e">Eastern PA</span>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-2" data-ps="src/components/home/Programs.astro:kmbc5r">Heartsaver First Aid</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4" data-ps="src/components/home/Programs.astro:trmckn">
            Comprehensive first aid training certification taught in accordance with all rules, regulations, and standards of the American Heart Association curriculum.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between" data-ps="src/components/home/Programs.astro:eaa68y">
          <span class="text-xs font-semibold text-muted-foreground" data-ps="src/components/home/Programs.astro:8sur2d">Lay Rescuers & Business</span>
          <a href="/#contact" class="text-xs font-bold text-foreground hover:text-muted-foreground hover:underline inline-flex items-center gap-1 no-underline" data-ps="src/components/home/Programs.astro:7x2zbi">
            <span data-ps="src/components/home/Programs.astro:8sur2c">Request Class</span>
            <svg class="w-3.5 h-3.5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <!-- 2. Heartsaver CPR/AED -->
      <div class="flex flex-col justify-between p-6 bg-surface rounded-xl border border-border hover:border-primary/60 transition-all duration-200 hover:-translate-y-0.5 shadow-sm reveal reveal-delay-1" data-ps="src/components/home/Programs.astro:eaa68x">
        <div data-ps="src/components/home/Programs.astro:eaa68w">
          <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Programs.astro:eaa68a">
            <span class="px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider" data-ps="src/components/home/Programs.astro:8sur2b">AHA / Red Cross</span>
            <span class="text-xs text-muted-foreground font-medium" data-ps="src/components/home/Programs.astro:8sur2a">Eastern PA</span>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-2" data-ps="src/components/home/Programs.astro:kmbc5q">Heartsaver CPR/AED</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4" data-ps="src/components/home/Programs.astro:trmckm">
            Hands-on CPR and automated external defibrillator (AED) training with up-to-date realistic equipment and adult/child techniques.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between" data-ps="src/components/home/Programs.astro:eaa689">
          <span class="text-xs font-semibold text-muted-foreground" data-ps="src/components/home/Programs.astro:8sur1o">Workplace & Community</span>
          <a href="/#contact" class="text-xs font-bold text-foreground hover:text-muted-foreground hover:underline inline-flex items-center gap-1 no-underline" data-ps="src/components/home/Programs.astro:7x2zbj">
            <span data-ps="src/components/home/Programs.astro:8sur1n">Request Class</span>
            <svg class="w-3.5 h-3.5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <!-- 3. Friends and Family CPR Certification -->
      <div class="flex flex-col justify-between p-6 bg-surface rounded-xl border border-border hover:border-primary/60 transition-all duration-200 hover:-translate-y-0.5 shadow-sm reveal reveal-delay-2" data-ps="src/components/home/Programs.astro:eaa688">
        <div data-ps="src/components/home/Programs.astro:eaa687">
          <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Programs.astro:eaa686">
            <span class="px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider" data-ps="src/components/home/Programs.astro:8sur1m">Community</span>
            <span class="text-xs text-muted-foreground font-medium" data-ps="src/components/home/Programs.astro:8sur1l">Eastern PA</span>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-2" data-ps="src/components/home/Programs.astro:kmbc5p">Friends and Family CPR Certification</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4" data-ps="src/components/home/Programs.astro:trmckl">
            Essential life-saving CPR skills designed for family members, new parents, civic groups, and community members who want confidence in an emergency.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between" data-ps="src/components/home/Programs.astro:eaa685">
          <span class="text-xs font-semibold text-muted-foreground" data-ps="src/components/home/Programs.astro:8sur1k">Civic & Private Groups</span>
          <a href="/#contact" class="text-xs font-bold text-foreground hover:text-muted-foreground hover:underline inline-flex items-center gap-1 no-underline" data-ps="src/components/home/Programs.astro:7x2zbk">
            <span data-ps="src/components/home/Programs.astro:8sur1j">Request Class</span>
            <svg class="w-3.5 h-3.5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <!-- 4. BLS for Healthcare Providers -->
      <div class="flex flex-col justify-between p-6 bg-surface rounded-xl border-2 border-primary/40 hover:border-primary transition-all duration-200 hover:-translate-y-0.5 shadow-sm reveal" data-ps="src/components/home/Programs.astro:eaa684">
        <div data-ps="src/components/home/Programs.astro:eaa683">
          <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Programs.astro:eaa682">
            <span class="px-2.5 py-1 rounded bg-primary text-primary-foreground text-xs font-bold uppercase tracking-wider" data-ps="src/components/home/Programs.astro:8sur1i">AHA / BLS Family</span>
            <span class="text-xs text-muted-foreground font-medium" data-ps="src/components/home/Programs.astro:8sur1h">Clinical</span>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-2" data-ps="src/components/home/Programs.astro:kmbc5o">BLS for the Healthcare Providers</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4" data-ps="src/components/home/Programs.astro:trmckk">
            Basic Life Support for healthcare professionals, emergency medical technicians, nurses, dentists, and pre-hospital responders across Pennsylvania.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between" data-ps="src/components/home/Programs.astro:eaa681">
          <span class="text-xs font-semibold text-muted-foreground" data-ps="src/components/home/Programs.astro:8sur1g">Healthcare Providers</span>
          <a href="/#contact" class="text-xs font-bold text-foreground hover:text-muted-foreground hover:underline inline-flex items-center gap-1 no-underline" data-ps="src/components/home/Programs.astro:7x2zbl">
            <span data-ps="src/components/home/Programs.astro:8sur1f">Request Class</span>
            <svg class="w-3.5 h-3.5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <!-- 5. Pediatric First Aid -->
      <div class="flex flex-col justify-between p-6 bg-surface rounded-xl border border-border hover:border-primary/60 transition-all duration-200 hover:-translate-y-0.5 shadow-sm reveal reveal-delay-1" data-ps="src/components/home/Programs.astro:eaa67f">
        <div data-ps="src/components/home/Programs.astro:eaa67e">
          <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Programs.astro:eaa67d">
            <span class="px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider" data-ps="src/components/home/Programs.astro:8sur0t">Childcare & School</span>
            <span class="text-xs text-muted-foreground font-medium" data-ps="src/components/home/Programs.astro:8sur0s">Eastern PA</span>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-2" data-ps="src/components/home/Programs.astro:kmbc5n">Pediatric First Aid</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4" data-ps="src/components/home/Programs.astro:trmckj">
            Specialized pediatric emergency training tailored for daycare providers, preschool teachers, babysitters, and school staff. Meets PA Key Registry requirements.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between" data-ps="src/components/home/Programs.astro:eaa67c">
          <span class="text-xs font-semibold text-muted-foreground" data-ps="src/components/home/Programs.astro:8sur0r">Educators & Daycares</span>
          <a href="/#contact" class="text-xs font-bold text-foreground hover:text-muted-foreground hover:underline inline-flex items-center gap-1 no-underline" data-ps="src/components/home/Programs.astro:7x2zbm">
            <span data-ps="src/components/home/Programs.astro:8sur0q">Request Class</span>
            <svg class="w-3.5 h-3.5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <!-- 6. Bloodborne Pathogen Training -->
      <div class="flex flex-col justify-between p-6 bg-surface rounded-xl border border-border hover:border-primary/60 transition-all duration-200 hover:-translate-y-0.5 shadow-sm reveal reveal-delay-2" data-ps="src/components/home/Programs.astro:eaa67b">
        <div data-ps="src/components/home/Programs.astro:eaa67a">
          <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Programs.astro:eaa679">
            <span class="px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider" data-ps="src/components/home/Programs.astro:8sur0p">OSHA 1910.1030</span>
            <span class="text-xs text-muted-foreground font-medium" data-ps="src/components/home/Programs.astro:8sur0o">Compliance</span>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-2" data-ps="src/components/home/Programs.astro:kmbc5m">Bloodborne Pathogen Training</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4" data-ps="src/components/home/Programs.astro:trmcki">
            In-classroom instruction on Bloodborne Pathogens (BBP & OPIM) in strict accordance with the OSHA 1910.1030 regulatory standard.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between" data-ps="src/components/home/Programs.astro:eaa678">
          <span class="text-xs font-semibold text-muted-foreground" data-ps="src/components/home/Programs.astro:8sur0n">OSHA Standard Place</span>
          <a href="/#contact" class="text-xs font-bold text-foreground hover:text-muted-foreground hover:underline inline-flex items-center gap-1 no-underline" data-ps="src/components/home/Programs.astro:mnofyb">
            <span data-ps="src/components/home/Programs.astro:8sur0m">Request Class</span>
            <svg class="w-3.5 h-3.5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <!-- 7. Fire Extinguisher Training -->
      <div class="flex flex-col justify-between p-6 bg-surface rounded-xl border border-border hover:border-primary/60 transition-all duration-200 hover:-translate-y-0.5 shadow-sm reveal" data-ps="src/components/home/Programs.astro:eaa677">
        <div data-ps="src/components/home/Programs.astro:eaa676">
          <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Programs.astro:l2z6l2">
            <span class="px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider" data-ps="src/components/home/Programs.astro:8sur0l">NFPA Standards</span>
            <span class="text-xs text-muted-foreground font-medium" data-ps="src/components/home/Programs.astro:8sur0k">Safety</span>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-2" data-ps="src/components/home/Programs.astro:kmbc5l">Fire Extinguisher Training</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4" data-ps="src/components/home/Programs.astro:trmckh">
            In-classroom safety instruction on basic fire extinguisher use and operation, PASS techniques, and workplace hazard recognition.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between" data-ps="src/components/home/Programs.astro:l2z6l1">
          <span class="text-xs font-semibold text-muted-foreground" data-ps="src/components/home/Programs.astro:8suqzy">Facility & Industrial</span>
          <a href="/#contact" class="text-xs font-bold text-foreground hover:text-muted-foreground hover:underline inline-flex items-center gap-1 no-underline" data-ps="src/components/home/Programs.astro:mnofya">
            <span data-ps="src/components/home/Programs.astro:8suqzx">Request Class</span>
            <svg class="w-3.5 h-3.5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <!-- 8. PennDOT Flagger Certification -->
      <div class="flex flex-col justify-between p-6 bg-surface rounded-xl border border-border hover:border-primary/60 transition-all duration-200 hover:-translate-y-0.5 shadow-sm reveal reveal-delay-1" data-ps="src/components/home/Programs.astro:l2z6l0">
        <div data-ps="src/components/home/Programs.astro:l2z6kz">
          <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Programs.astro:l2z6ky">
            <span class="px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider" data-ps="src/components/home/Programs.astro:8suqzw">State Certified</span>
            <span class="text-xs text-muted-foreground font-medium" data-ps="src/components/home/Programs.astro:8suqzv">Highway</span>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-2" data-ps="src/components/home/Programs.astro:kmbc5k">PennDOT Flagger Class</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4" data-ps="src/components/home/Programs.astro:trmckg">
            Official PennDOT flagger certification and training for highway safety, construction workers, and traffic control specialists.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between" data-ps="src/components/home/Programs.astro:l2z6kx">
          <span class="text-xs font-semibold text-muted-foreground" data-ps="src/components/home/Programs.astro:8suqzu">PennDOT Approved</span>
          <a href="/#contact" class="text-xs font-bold text-foreground hover:text-muted-foreground hover:underline inline-flex items-center gap-1 no-underline" data-ps="src/components/home/Programs.astro:mnofy9">
            <span data-ps="src/components/home/Programs.astro:8suqzt">Request Class</span>
            <svg class="w-3.5 h-3.5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <!-- 9. Red Cross CPR & First Aid Courses -->
      <div class="flex flex-col justify-between p-6 bg-surface rounded-xl border border-border hover:border-primary/60 transition-all duration-200 hover:-translate-y-0.5 shadow-sm reveal reveal-delay-2" data-ps="src/components/home/Programs.astro:l2z6kw">
        <div data-ps="src/components/home/Programs.astro:l2z6kv">
          <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Programs.astro:l2z6ku">
            <span class="px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider" data-ps="src/components/home/Programs.astro:8suqzs">Red Cross</span>
            <span class="text-xs text-muted-foreground font-medium" data-ps="src/components/home/Programs.astro:8suqzr">Eastern PA</span>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-2" data-ps="src/components/home/Programs.astro:kmbc5j">Red Cross CPR & First Aid Courses</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4" data-ps="src/components/home/Programs.astro:trmcju">
            Certified American Red Cross training programs designed to prepare individuals and organizations to respond with confidence to life-threatening emergencies.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between" data-ps="src/components/home/Programs.astro:l2z6kt">
          <span class="text-xs font-semibold text-muted-foreground" data-ps="src/components/home/Programs.astro:8suqzq">Certified Curriculum</span>
          <a href="/#contact" class="text-xs font-bold text-foreground hover:text-muted-foreground hover:underline inline-flex items-center gap-1 no-underline" data-ps="src/components/home/Programs.astro:mnofy8">
            <span data-ps="src/components/home/Programs.astro:8suqzp">Request Class</span>
            <svg class="w-3.5 h-3.5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>
