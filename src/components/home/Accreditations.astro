---
// Accreditations & Compliance Section - Proof dashboard with official logos
import Container from '@/components/Container.astro';
---

<section id="accreditations" class="relative isolate bg-surface text-foreground py-14 md:py-20 border-b border-border" data-ps="src/components/home/Accreditations.astro:imj5l7">
  <Container>
    <div class="max-w-3xl mb-12" data-ps="src/components/home/Accreditations.astro:97v3q4">
      <h2 class="text-h2 font-bold text-foreground tracking-tight mb-4 reveal" data-ps="src/components/home/Accreditations.astro:9vpw7z">
        AHA and Red Cross Approved First Aid Training and CPR Certification Class
      </h2>
      <p class="text-base md:text-lg text-muted-foreground leading-relaxed reveal reveal-delay-1" data-ps="src/components/home/Accreditations.astro:cgc6tg">
        First aid training certification and training material is taught in accordance with all rules, regulations, and standards in accordance with both the American Heart Association and the American Red Cross curriculums.
      </p>
      <div class="mt-4 inline-flex items-center gap-2 px-3.5 py-2 rounded-md bg-amber-subtle border border-amber-200 text-xs font-semibold text-foreground reveal reveal-delay-2" data-ps="src/components/home/Accreditations.astro:97v3q3">
        <svg class="w-4 h-4 text-warning shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span data-ps="src/components/home/Accreditations.astro:unqn0c">Our CPR certification and first aid training programs are able to be submitted under the PA Volunteer Fire Department relief-approved training.</span>
      </div>
    </div>

    <!-- Official Accreditation Logo Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 items-stretch reveal reveal-delay-2" data-ps="src/components/home/Accreditations.astro:97v3q2">
      <!-- American Heart Association -->
      <div class="flex flex-col items-center justify-center p-5 bg-background rounded-lg border border-border shadow-sm text-center hover:border-primary/50 transition-colors" data-ps="src/components/home/Accreditations.astro:97v3q1">
        <div class="h-16 flex items-center justify-center mb-2" data-ps="src/components/home/Accreditations.astro:97v3q0">
          <img
            src="https://pagesmith-cdn.com/e5b58edc/images/american_heart_association_logo-8fc04c-122.webp"
            alt="American Heart Association Logo"
            class="max-h-12 w-auto object-contain"
            width="122"
            height="60"
            loading="lazy" data-ps="src/components/home/Accreditations.astro:bq482c" />
        </div>
        <span class="text-xs font-bold text-foreground" data-ps="src/components/home/Accreditations.astro:unqn0d">AHA Certified</span>
        <span class="text-[11px] text-muted-foreground mt-0.5" data-ps="src/components/home/Accreditations.astro:unqn0e">Approved Curriculum</span>
      </div>

      <!-- American Red Cross -->
      <div class="flex flex-col items-center justify-center p-5 bg-background rounded-lg border border-border shadow-sm text-center hover:border-primary/50 transition-colors" data-ps="src/components/home/Accreditations.astro:rsjzq8">
        <div class="h-16 flex items-center justify-center mb-2" data-ps="src/components/home/Accreditations.astro:rsjzq7">
          <img
            src="https://pagesmith-cdn.com/e5b58edc/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc~-824966-114.webp"
            alt="American Red Cross Logo"
            class="max-h-12 w-auto object-contain"
            width="114"
            height="112"
            loading="lazy" data-ps="src/components/home/Accreditations.astro:bq482b" />
        </div>
        <span class="text-xs font-bold text-foreground" data-ps="src/components/home/Accreditations.astro:unqn0f">American Red Cross</span>
        <span class="text-[11px] text-muted-foreground mt-0.5" data-ps="src/components/home/Accreditations.astro:unqn0g">Approved Standards</span>
      </div>

      <!-- OSHA -->
      <div class="flex flex-col items-center justify-center p-5 bg-background rounded-lg border border-border shadow-sm text-center hover:border-primary/50 transition-colors" data-ps="src/components/home/Accreditations.astro:rsjzq6">
        <div class="h-16 flex items-center justify-center mb-2" data-ps="src/components/home/Accreditations.astro:rsjzq5">
          <img
            src="https://pagesmith-cdn.com/e5b58edc/images/osha-logo-dceaa1-100.webp"
            alt="OSHA Logo"
            class="max-h-8 w-auto object-contain"
            width="100"
            height="29"
            loading="lazy" data-ps="src/components/home/Accreditations.astro:bq481p" />
        </div>
        <span class="text-xs font-bold text-foreground" data-ps="src/components/home/Accreditations.astro:unqn0h">OSHA Standard</span>
        <span class="text-[11px] text-muted-foreground mt-0.5" data-ps="src/components/home/Accreditations.astro:unqn0i">1910.1030 Compliant</span>
      </div>

      <!-- ASHI -->
      <div class="flex flex-col items-center justify-center p-5 bg-background rounded-lg border border-border shadow-sm text-center hover:border-primary/50 transition-colors" data-ps="src/components/home/Accreditations.astro:rsjzq4">
        <div class="h-16 flex items-center justify-center mb-2" data-ps="src/components/home/Accreditations.astro:rsjzq3">
          <img
            src="https://pagesmith-cdn.com/e5b58edc/images/ashi-approved-training-center-logo-799753-67.webp"
            alt="ASHI Approved Training Center Logo"
            class="max-h-14 w-auto object-contain"
            width="67"
            height="70"
            loading="lazy" data-ps="src/components/home/Accreditations.astro:bq481o" />
        </div>
        <span class="text-xs font-bold text-foreground" data-ps="src/components/home/Accreditations.astro:unqn14">ASHI Approved</span>
        <span class="text-[11px] text-muted-foreground mt-0.5" data-ps="src/components/home/Accreditations.astro:unqn15">Training Center</span>
      </div>

      <!-- NFPA -->
      <div class="flex flex-col items-center justify-center p-5 bg-background rounded-lg border border-border shadow-sm text-center hover:border-primary/50 transition-colors" data-ps="src/components/home/Accreditations.astro:rsjzq2">
        <div class="h-16 flex items-center justify-center mb-2" data-ps="src/components/home/Accreditations.astro:rsjzq1">
          <img
            src="https://pagesmith-cdn.com/e5b58edc/images/nfpa-member-logo-31BDF5EC99-seeklogo_com-dec389-79.webp"
            alt="NFPA Member Logo"
            class="max-h-14 w-auto object-contain"
            width="79"
            height="90"
            loading="lazy" data-ps="src/components/home/Accreditations.astro:bq481n" />
        </div>
        <span class="text-xs font-bold text-foreground" data-ps="src/components/home/Accreditations.astro:unqn16">NFPA Member</span>
        <span class="text-[11px] text-muted-foreground mt-0.5" data-ps="src/components/home/Accreditations.astro:unqn17">Fire Safety Training</span>
      </div>

      <!-- The Pennsylvania Key Registry -->
      <div class="flex flex-col items-center justify-center p-5 bg-background rounded-lg border border-border shadow-sm text-center hover:border-primary/50 transition-colors" data-ps="src/components/home/Accreditations.astro:rsjzq0">
        <div class="h-16 flex items-center justify-center mb-2" data-ps="src/components/home/Accreditations.astro:rsjzpz">
          <img
            src="https://pagesmith-cdn.com/e5b58edc/images/pastedImage-32b76d-228.webp"
            alt="The Pennsylvania Key Registry Details"
            class="max-h-14 w-auto object-contain"
            width="228"
            height="330"
            loading="lazy" data-ps="src/components/home/Accreditations.astro:bq481m" />
        </div>
        <span class="text-xs font-bold text-foreground" data-ps="src/components/home/Accreditations.astro:unqn18">PA Key Registry</span>
        <span class="text-[11px] text-muted-foreground mt-0.5" data-ps="src/components/home/Accreditations.astro:unqn19">ID: 6855495</span>
      </div>
    </div>
  </Container>
</section>
