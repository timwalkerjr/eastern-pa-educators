---
// Contact & Quote Section with ALTCHA Protection & Newsletter
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';
---

<section id="contact" class="relative isolate bg-background text-foreground py-16 md:py-24" data-ps="src/components/home/ContactQuote.astro:k3ajm5">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12" data-ps="src/components/home/ContactQuote.astro:n5t0ii">
      <!-- Left: Contact Details & Facility Information (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between reveal" data-ps="src/components/home/ContactQuote.astro:n5t0ih">
        <div data-ps="src/components/home/ContactQuote.astro:n5t0ig">
          <span class="text-xs font-bold uppercase tracking-wider text-primary mb-2 block" data-ps="src/components/home/ContactQuote.astro:elan0b">
            Get In Touch
          </span>
          <h2 class="text-h2 font-bold text-foreground tracking-tight mb-4" data-ps="src/components/home/ContactQuote.astro:2eidc4">
            CONTACT US FOR A QUOTE
          </h2>
          <p class="text-base text-muted-foreground leading-relaxed mb-8" data-ps="src/components/home/ContactQuote.astro:2hmcl5">
            Reach out today to schedule custom CPR, First Aid, AED, Bloodborne Pathogens, or Fire Extinguisher training for your team or organization.
          </p>

          <!-- Direct Phone & Email Cards -->
          <div class="space-y-4 mb-8" data-ps="src/components/home/ContactQuote.astro:n5t0if">
            <a
              href={`tel:${SITE.phone}`}
              class="flex items-center gap-4 p-4 rounded-xl bg-surface border border-border hover:border-primary transition-colors no-underline group shadow-sm"
             data-ps="src/components/home/ContactQuote.astro:4mbk3u">
              <div class="w-12 h-12 rounded-lg bg-amber-subtle flex items-center justify-center text-foreground font-bold shrink-0" data-ps="src/components/home/ContactQuote.astro:n5t0ie">
                <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div data-ps="src/components/home/ContactQuote.astro:n5t0id">
                <span class="block text-xs uppercase tracking-wider text-muted-foreground font-bold" data-ps="src/components/home/ContactQuote.astro:elan0a">Direct Phone</span>
                <span class="text-lg font-bold text-foreground group-hover:text-primary transition-colors" data-ps="src/components/home/ContactQuote.astro:elamzo">{SITE.phone}</span>
              </div>
            </a>

            <a
              href={`mailto:${SITE.email}`}
              class="flex items-center gap-4 p-4 rounded-xl bg-surface border border-border hover:border-primary transition-colors no-underline group shadow-sm"
             data-ps="src/components/home/ContactQuote.astro:4mbk3v">
              <div class="w-12 h-12 rounded-lg bg-amber-subtle flex items-center justify-center text-foreground font-bold shrink-0" data-ps="src/components/home/ContactQuote.astro:n5t0ic">
                <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div data-ps="src/components/home/ContactQuote.astro:n5t0hq">
                <span class="block text-xs uppercase tracking-wider text-muted-foreground font-bold" data-ps="src/components/home/ContactQuote.astro:elamzn">Email Inquiries</span>
                <span class="text-base font-bold text-foreground group-hover:text-primary transition-colors" data-ps="src/components/home/ContactQuote.astro:elamzm">{SITE.email}</span>
              </div>
            </a>
          </div>

          <!-- Physical Addresses -->
          <div class="p-5 rounded-xl bg-surface border border-border text-sm text-muted-foreground space-y-3" data-ps="src/components/home/ContactQuote.astro:n5t0hp">
            <div data-ps="src/components/home/ContactQuote.astro:n5t0ho">
              <span class="block font-bold text-foreground" data-ps="src/components/home/ContactQuote.astro:elamzl">Training Center Address:</span>
              <a href="https://maps.app.goo.gl/muXmn7KridwPnmVn9" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors no-underline" data-ps="src/components/home/ContactQuote.astro:4mbk3w">
                16600 Pottsville Pike, Hamburg, PA 19526
              </a>
            </div>
            <div class="pt-2 border-t border-border" data-ps="src/components/home/ContactQuote.astro:n5t0hn">
              <span class="block font-bold text-foreground" data-ps="src/components/home/ContactQuote.astro:elamzk">Main Office:</span>
              <p class="m-0" data-ps="src/components/home/ContactQuote.astro:2hmcl4">301 Chris Drive, Lenhartsville, PA 19534</p>
            </div>
          </div>
        </div>

        <!-- Licensing Notice -->
        <div class="mt-8 p-4 rounded-lg bg-amber-subtle border border-amber-200 text-xs text-foreground font-medium" data-ps="src/components/home/ContactQuote.astro:n5t0hm">
          We Are Fully Licensed and Insured. We Accept All Major Credit Card and Payment Plans.
        </div>
      </div>

      <!-- Right: Interactive Quote Form & Newsletter (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col gap-8 reveal reveal-delay-1" data-ps="src/components/home/ContactQuote.astro:n5t0hl">
        <!-- Quote Request Form -->
        <div class="p-8 bg-surface rounded-2xl border border-border shadow-md" data-ps="src/components/home/ContactQuote.astro:n5t0hk">
          <h3 class="text-xl font-bold text-foreground mb-2" data-ps="src/components/home/ContactQuote.astro:h2xakb">Request a Training Quote</h3>
          <p class="text-sm text-muted-foreground mb-6" data-ps="src/components/home/ContactQuote.astro:2hmcl3">
            Fill out the details below and our instructor will get back to you promptly with a custom training proposal.
          </p>

          <form id="quote-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactQuote.astro:n5t0hj">
              <div data-ps="src/components/home/ContactQuote.astro:n5t0hi">
                <label for="name" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/components/home/ContactQuote.astro:4287bn">Your Name *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. John Doe"
                  class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                />
              </div>
              <div data-ps="src/components/home/ContactQuote.astro:n5t0hh">
                <label for="organization" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/components/home/ContactQuote.astro:4287bo">Organization / Business</label>
                <input
                  type="text"
                  id="organization"
                  name="organization"
                  placeholder="e.g. Acme Health / Daycare"
                  class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactQuote.astro:hl03z1">
              <div data-ps="src/components/home/ContactQuote.astro:hl03z2">
                <label for="email" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/components/home/ContactQuote.astro:4287bp">Email Address *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                />
              </div>
              <div data-ps="src/components/home/ContactQuote.astro:hl03z3">
                <label for="phone" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/components/home/ContactQuote.astro:4287cb">Phone Number *</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="484-000-0000"
                  class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactQuote.astro:hl03z4">
              <div data-ps="src/components/home/ContactQuote.astro:hl03z5">
                <label for="program" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/components/home/ContactQuote.astro:4287cc">Program of Interest</label>
                <select
                  id="program"
                  name="program"
                  class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                >
                  <option value="Heartsaver First Aid">Heartsaver First Aid</option>
                  <option value="Heartsaver CPR AED">Heartsaver CPR AED</option>
                  <option value="Friends & Family CPR">Friends & Family CPR</option>
                  <option value="BLS for Healthcare Providers">BLS for Healthcare Providers</option>
                  <option value="Pediatric First Aid">Pediatric First Aid</option>
                  <option value="Bloodborne Pathogen Training">Bloodborne Pathogen Training</option>
                  <option value="Fire Extinguisher Training">Fire Extinguisher Training</option>
                  <option value="PennDOT Flagger Certification">PennDOT Flagger Certification</option>
                  <option value="Red Cross CPR & First Aid">Red Cross CPR & First Aid</option>
                  <option value="Custom Group Package">Custom Group Package</option>
                </select>
              </div>
              <div data-ps="src/components/home/ContactQuote.astro:hl03z6">
                <label for="group-size" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/components/home/ContactQuote.astro:4287cd">Estimated Group Size</label>
                <input
                  type="text"
                  id="group-size"
                  name="groupSize"
                  placeholder="e.g. 5-10 people"
                  class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                />
              </div>
            </div>

            <div data-ps="src/components/home/ContactQuote.astro:hl03z7">
              <label for="message" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/components/home/ContactQuote.astro:4287ce">Training Location / Notes</label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Tell us about your preferred schedule, location (Hamburg training center vs on-site at your facility), and any specific requirements..."
                class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary resize-none"
              ></textarea>
            </div>

            <!-- Captcha Widget -->
            <altcha-widget challenge="/psapi-internal-v1/altcha/challenge" display="invisible" auto="onfocus"></altcha-widget>

            <button
              type="submit"
              id="submit-btn"
              class="w-full py-3.5 px-6 rounded-md bg-primary text-primary-foreground font-bold text-base hover:bg-primary-hover transition-colors shadow-sm"
             data-ps="src/components/home/ContactQuote.astro:ohtadb">
              Submit Quote Request
            </button>

            <!-- Status Message Area -->
            <div id="form-status" class="hidden text-sm font-semibold p-3 rounded-md mt-2 text-center" data-ps="src/components/home/ContactQuote.astro:hl03z8"></div>
          </form>
        </div>

        <!-- Newsletter Signup Box from index.md -->
        <div class="p-6 bg-surface rounded-2xl border border-border shadow-sm" data-ps="src/components/home/ContactQuote.astro:hl03z9">
          <h3 class="text-base font-bold text-foreground mb-1" data-ps="src/components/home/ContactQuote.astro:h2xajp">STAY UPDATED with EASTERN PA EDUCATORS</h3>
          <p class="text-xs text-muted-foreground mb-4" data-ps="src/components/home/ContactQuote.astro:2hmcl2">Sign Up for Our Newsletter Here</p>
          <form id="newsletter-form" class="flex flex-col sm:flex-row gap-2">
            <input
              type="email"
              id="newsletter-email"
              name="email"
              required
              placeholder="Enter your email"
              aria-label="Email for newsletter"
              class="flex-1 px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <button
              type="submit"
              class="py-2.5 px-6 rounded-md bg-secondary text-secondary-foreground font-semibold text-sm hover:bg-secondary-hover transition-colors"
            >
              Submit
            </button>
          </form>
          <div id="newsletter-status" class="hidden text-xs font-semibold p-2 rounded mt-2 text-center" data-ps="src/components/home/ContactQuote.astro:hl03za"></div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import 'altcha';

  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
    statusEl.className = 'hidden';

    const formData = new FormData(form);
    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      organization: formData.get('organization'),
      program: formData.get('program'),
      groupSize: formData.get('groupSize'),
      message: formData.get('message'),
      altcha: formData.get('altcha'),
      subject: 'New CPR / First Aid Training Quote Request - Eastern PA Educators',
    };

    try {
      const res = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-green-100 text-green-800 border border-green-200';
        statusEl.textContent = 'Thanks for submitting! We will contact you soon.';
        form.reset();
      } else {
        throw new Error('Submission failed');
      }
    } catch (err) {
      statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-red-100 text-red-800 border border-red-200';
      statusEl.textContent = 'Submission error. Please call us at 484-334-3577.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Quote Request';
    }
  });

  const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const newsletterStatus = document.getElementById('newsletter-status');

  newsletterForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!newsletterStatus) return;

    const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
    const email = emailInput?.value;
    if (!email) return;

    try {
      const res = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          subject: 'Newsletter Signup - Eastern PA Educators',
        }),
      });

      if (res.ok) {
        newsletterStatus.className = 'block text-xs font-semibold p-2 rounded mt-2 text-center bg-green-100 text-green-800';
        newsletterStatus.textContent = 'Thanks for submitting!';
        newsletterForm.reset();
      } else {
        throw new Error('Failed');
      }
    } catch {
      newsletterStatus.className = 'block text-xs font-semibold p-2 rounded mt-2 text-center bg-green-100 text-green-800';
      newsletterStatus.textContent = 'Thanks for submitting!';
      newsletterForm.reset();
    }
  });
</script>
