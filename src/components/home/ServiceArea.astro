---
// Service Area Section
import Container from '@/components/Container.astro';
---

<section id="service-area" class="relative isolate bg-surface text-foreground py-16 md:py-24 border-b border-border" data-ps="src/components/home/ServiceArea.astro:ipyfjg">
  <Container>
    <div class="max-w-3xl mb-12" data-ps="src/components/home/ServiceArea.astro:r9lrib">
      <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-2 block reveal" data-ps="src/components/home/ServiceArea.astro:f4pfrz">
        Service Area
      </span>
      <h2 class="text-h2 font-bold text-foreground tracking-tight mb-4 reveal reveal-delay-1" data-ps="src/components/home/ServiceArea.astro:z3oydh">
        OUR CPR CERTIFICATION & FIRST AID CLASSES SERVE:
      </h2>
      <p class="text-base md:text-lg text-muted-foreground leading-relaxed reveal reveal-delay-2" data-ps="src/components/home/ServiceArea.astro:36tord">
        We provide custom on-site first aid and CPR certification classes across Eastern Pennsylvania businesses, daycares, fire departments, civic groups, and private organizations.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center" data-ps="src/components/home/ServiceArea.astro:r9lria">
      <!-- 7-Col Map Graphic -->
      <div class="lg:col-span-7 reveal" data-ps="src/components/home/ServiceArea.astro:r9lri9">
        <div class="rounded-xl overflow-hidden border border-border shadow-lg bg-background p-2" data-ps="src/components/home/ServiceArea.astro:r9lri8">
          <img
            src="https://pagesmith-cdn.com/e5b58edc/images/Screenshot-2026-03-10-at-10_56_54_AM-71f19b-768.webp"
            srcset="
              https://pagesmith-cdn.com/e5b58edc/images/Screenshot-2026-03-10-at-10_56_54_AM-71f19b-320.webp 320w,
              https://pagesmith-cdn.com/e5b58edc/images/Screenshot-2026-03-10-at-10_56_54_AM-71f19b-640.webp 640w,
              https://pagesmith-cdn.com/e5b58edc/images/Screenshot-2026-03-10-at-10_56_54_AM-71f19b-768.webp 768w
            "
            sizes="(max-width: 1024px) 100vw, 55vw"
            alt="Eastern PA Educators Regional Service Area Map"
            class="w-full h-auto object-cover rounded-lg"
            width="969"
            height="508"
            loading="lazy" data-ps="src/components/home/ServiceArea.astro:dw9btj" />
        </div>
      </div>

      <!-- 5-Col Location Directory -->
      <div class="lg:col-span-5 flex flex-col gap-6 reveal reveal-delay-1" data-ps="src/components/home/ServiceArea.astro:r9lri7">
        <div class="p-6 bg-background rounded-xl border border-border shadow-sm" data-ps="src/components/home/ServiceArea.astro:r9lri6">
          <h3 class="text-base font-bold text-foreground mb-4" data-ps="src/components/home/ServiceArea.astro:kfa15v">
            CPR and First Aid Certification Classes are offered in the following PA locations:
          </h3>
          <div class="flex flex-wrap gap-2" data-ps="src/components/home/ServiceArea.astro:r9lri5">
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfs0">Reading</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfs1">Pottsville</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfs2">Allentown</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfs3">Bethlehem</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfs4">Easton</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfs5">Lancaster</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfs6">Lebanon</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfss">Pottstown</span>
            <span class="px-3 py-1.5 rounded-md bg-primary/20 text-foreground font-bold text-xs border border-primary/40" data-ps="src/components/home/ServiceArea.astro:f4pfst">Philadelphia</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfsu">Canton</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfsv">Williamsport</span>
            <span class="px-3 py-1.5 rounded-md bg-surface text-foreground font-semibold text-xs border border-border" data-ps="src/components/home/ServiceArea.astro:f4pfsw">Danville</span>
          </div>
        </div>

        <div class="p-6 bg-background rounded-xl border border-border shadow-sm" data-ps="src/components/home/ServiceArea.astro:r9lri4">
          <h3 class="text-sm font-bold text-foreground mb-2" data-ps="src/components/home/ServiceArea.astro:kfa15w">On-Site Travel & Facility Training</h3>
          <p class="text-xs text-muted-foreground leading-relaxed m-0" data-ps="src/components/home/ServiceArea.astro:36torc">
            Our instructors travel directly to your facility with full equipment, manikins, and training aids, or host classes at our Hamburg PA training center.
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
