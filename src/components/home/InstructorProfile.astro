---
// Meet Our Safety Training Instructor Section
import Container from '@/components/Container.astro';
---

<section id="instructor" class="relative isolate bg-dark-background text-dark-foreground py-16 md:py-24 border-b border-dark-border" data-ps="src/components/home/InstructorProfile.astro:m9qkua">
  <Container>
    <div class="max-w-3xl mb-12" data-ps="src/components/home/InstructorProfile.astro:bpc3fb">
      <span class="text-xs font-bold uppercase tracking-wider text-primary mb-2 block reveal" data-ps="src/components/home/InstructorProfile.astro:z60wnj">
        Meet the Staff
      </span>
      <h2 class="text-h2 font-bold text-dark-foreground tracking-tight reveal reveal-delay-1" data-ps="src/components/home/InstructorProfile.astro:jd3h9o">
        MEET OUR SAFETY TRAINING INSTRUCTOR
      </h2>
    </div>

    <!-- Instructor Card -->
    <div class="bg-dark-border/40 rounded-2xl border border-dark-border p-6 md:p-10 shadow-xl" data-ps="src/components/home/InstructorProfile.astro:hyb3vz">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" data-ps="src/components/home/InstructorProfile.astro:hyb3vy">
        <!-- Photo & Basic Title (4 Cols) -->
        <div class="lg:col-span-4 flex flex-col items-center text-center p-6 bg-dark-background rounded-xl border border-dark-border/80 reveal" data-ps="src/components/home/InstructorProfile.astro:hyb3vx">
          <div class="w-44 h-56 rounded-lg overflow-hidden border-2 border-primary/60 shadow-md mb-4 bg-dark-border/30" data-ps="src/components/home/InstructorProfile.astro:hyb3vw">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/newphoto-7eabc2-174.webp"
              alt="Jarrod K. Emes - Owner and Instructor"
              class="w-full h-full object-cover object-top"
              width="174"
              height="244"
              loading="lazy" data-ps="src/components/home/InstructorProfile.astro:972z3t" />
          </div>
          <h3 class="text-h3 font-bold text-dark-foreground m-0" data-ps="src/components/home/InstructorProfile.astro:4ook23">Jarrod K. Emes</h3>
          <p class="text-sm font-semibold text-primary mt-1 mb-4" data-ps="src/components/home/InstructorProfile.astro:7se0hd">Owner and Instructor</p>

          <!-- Featured Article Link -->
          <div class="w-full pt-4 border-t border-dark-border text-left" data-ps="src/components/home/InstructorProfile.astro:hyb3vv">
            <span class="text-xs font-bold uppercase tracking-wider text-dark-muted-foreground block mb-1" data-ps="src/components/home/InstructorProfile.astro:z60wnk">Featured Article:</span>
            <a
              href="http://www.readingeagle.com/business-weekly/article/post-911-a-new-world-emerges-for-security"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-primary hover:underline leading-snug block no-underline"
             data-ps="src/components/home/InstructorProfile.astro:og3sa">
              "Post-9/11, A New World Emerges for Security," an article written by Reading Eagle's Carole Duran
            </a>
          </div>
        </div>

        <!-- 8-Col Detailed Credentials & Background -->
        <div class="lg:col-span-8 flex flex-col gap-6 text-dark-muted-foreground text-sm leading-relaxed reveal reveal-delay-1" data-ps="src/components/home/InstructorProfile.astro:hyb3vu">
          <p class="text-base text-dark-foreground font-medium leading-relaxed" data-ps="src/components/home/InstructorProfile.astro:7se0hc">
            Jarrod brings over 20 years in the Emergency Services Field, specializing in Fire/Rescue and Emergency Management Field where he oversees a municipal hazard plan, mitigation projects and ongoing safety assessments and building. Jarrod is a current certified instructor in American Heart CPR, First Aid, Non Lethal Phazzer Instructor. He has worked for KRE Security/Investigations Inc. for 15 years. He is now the Director of Security for the company and works directly on a one-on-one level with the clients daily.
          </p>

          <!-- Education & Honors Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/InstructorProfile.astro:hyb3vt">
            <div class="p-4 rounded-lg bg-dark-background border border-dark-border/60" data-ps="src/components/home/InstructorProfile.astro:hyb3vs">
              <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-1" data-ps="src/components/home/InstructorProfile.astro:z60wo6">Education & Honors</span>
              <ul class="list-none p-0 m-0 space-y-1.5 text-xs text-dark-foreground">
                <li data-ps="src/components/home/InstructorProfile.astro:k42dql">• Graduate of Alvernia College</li>
                <li data-ps="src/components/home/InstructorProfile.astro:k42dqm">• Bachelor's Degree in Criminal Justice, Minor in Sociology</li>
                <li data-ps="src/components/home/InstructorProfile.astro:k42dqn">• Awarded the Saint Michael Archangel Award 2007</li>
                <li data-ps="src/components/home/InstructorProfile.astro:k42dqo">• Berks Technical Institute "Program Advisory Board Member" Criminal Justice Department</li>
              </ul>
            </div>

            <div class="p-4 rounded-lg bg-dark-background border border-dark-border/60" data-ps="src/components/home/InstructorProfile.astro:hyb3vr">
              <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-1" data-ps="src/components/home/InstructorProfile.astro:z60wo7">Leadership & Certifications</span>
              <ul class="list-none p-0 m-0 space-y-1.5 text-xs text-dark-foreground">
                <li data-ps="src/components/home/InstructorProfile.astro:k42dqp">• Owner KRE Security LLC (2016 - Present)</li>
                <li data-ps="src/components/home/InstructorProfile.astro:k42drb">• Member of KRE Security Management Team (2007 - 2016)</li>
                <li data-ps="src/components/home/InstructorProfile.astro:k42drc">• Certified Instructor in American Heart CPR & First Aid</li>
                <li data-ps="src/components/home/InstructorProfile.astro:k42drd">• Phazzer-Non Lethal Instructor</li>
                <li data-ps="src/components/home/InstructorProfile.astro:k42dre">• PA Act 235 - Lethal Weapon Agent</li>
              </ul>
            </div>
          </div>

          <!-- Verified Work Experiences -->
          <div class="p-4 rounded-lg bg-dark-background border border-dark-border/60" data-ps="src/components/home/InstructorProfile.astro:hyb3vq">
            <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-2" data-ps="src/components/home/InstructorProfile.astro:z60wo8">Work Experiences Include:</span>
            <ul class="list-none p-0 m-0 space-y-1.5 text-xs text-dark-foreground">
              <li data-ps="src/components/home/InstructorProfile.astro:k42drf">• Berks County Juvenile Detention Center</li>
              <li data-ps="src/components/home/InstructorProfile.astro:k42drg">• Berks County Dept of Emergency Services, as a Special Projects Officer</li>
              <li data-ps="src/components/home/InstructorProfile.astro:k42drh">• Investigation experience as a Deputy Coroner for the Schuylkill County Coroner's Office</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
