---
// Footer component - Dark authoritative public safety footer
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';
---

<footer class="bg-dark-background text-dark-foreground border-t border-dark-border py-14" data-ps="src/components/Footer.astro:7iejvu">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12" data-ps="src/components/Footer.astro:256hn1">
      <!-- Brand & Public Safety Pedigree -->
      <div class="flex flex-col gap-4" data-ps="src/components/Footer.astro:256hn0">
        <a href="/" class="no-underline" data-ps="src/components/Footer.astro:7gqbxu">
          <img
            src="https://pagesmith-cdn.com/e5b58edc/images/63861c_bd41880454694c7b95c201a820110e04~mv2-84d75c-768.webp"
            alt="Eastern PA Educators Logo"
            class="h-11 w-auto object-contain"
            width="843"
            height="325" data-ps="src/components/Footer.astro:4nflyj" />
        </a>
        <p class="text-sm text-dark-muted-foreground leading-relaxed" data-ps="src/components/Footer.astro:csf9t">
          First Aid and CPR Certification provided by KRE Security LLC. Certified instructors with over 35 years of field experience providing custom safety programs across Eastern Pennsylvania.
        </p>
        <div class="pt-2" data-ps="src/components/Footer.astro:256hmz">
          <p class="text-xs text-dark-muted-foreground/80" data-ps="src/components/Footer.astro:csf9u">
            We Are Fully Licensed and Insured. We Accept All Major Credit Card and Payment Plans.
          </p>
        </div>
      </div>

      <!-- Certified Training Programs -->
      <div data-ps="src/components/Footer.astro:256hmy">
        <h2 class="text-base font-bold text-dark-foreground mb-4 tracking-tight" data-ps="src/components/Footer.astro:w7klom">Certified Programs</h2>
        <ul class="list-none p-0 m-0 flex flex-col gap-2.5">
          <li data-ps="src/components/Footer.astro:wyji3w"><a href="/#programs" class="text-sm text-dark-muted-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbxv">Heartsaver First Aid</a></li>
          <li data-ps="src/components/Footer.astro:wyji3x"><a href="/#programs" class="text-sm text-dark-muted-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbxw">Heartsaver CPR AED</a></li>
          <li data-ps="src/components/Footer.astro:wyji3y"><a href="/#programs" class="text-sm text-dark-muted-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbxx">Friends & Family CPR Certification</a></li>
          <li data-ps="src/components/Footer.astro:wyji3z"><a href="/#programs" class="text-sm text-dark-muted-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbxy">BLS for Healthcare Providers</a></li>
          <li data-ps="src/components/Footer.astro:wyji40"><a href="/#programs" class="text-sm text-dark-muted-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbxz">Pediatric First Aid</a></li>
          <li data-ps="src/components/Footer.astro:wyji41"><a href="/#programs" class="text-sm text-dark-muted-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqby0">Bloodborne Pathogen Training</a></li>
          <li data-ps="src/components/Footer.astro:wyji42"><a href="/#programs" class="text-sm text-dark-muted-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqby1">Fire Extinguisher Training</a></li>
          <li data-ps="src/components/Footer.astro:wyji4o"><a href="/#programs" class="text-sm text-dark-muted-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyn">PennDOT Flagger Certification</a></li>
          <li data-ps="src/components/Footer.astro:wyji4p"><a href="/#programs" class="text-sm text-dark-muted-foreground no-underline hover:text-primary transition-colors" data-ps="src/components/Footer.astro:7gqbyo">Red Cross CPR & First Aid Courses</a></li>
        </ul>
      </div>

      <!-- Training Locations & Contacts -->
      <div data-ps="src/components/Footer.astro:p4vf82">
        <h2 class="text-base font-bold text-dark-foreground mb-4 tracking-tight" data-ps="src/components/Footer.astro:w7klon">Locations & Contact</h2>
        <div class="flex flex-col gap-3 text-sm text-dark-muted-foreground" data-ps="src/components/Footer.astro:p4vf83">
          <div data-ps="src/components/Footer.astro:p4vf84">
            <span class="block font-semibold text-dark-foreground" data-ps="src/components/Footer.astro:abywyu">Training Address:</span>
            <a href="https://maps.app.goo.gl/muXmn7KridwPnmVn9" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyp">
              16600 Pottsville Pike, Hamburg, PA 19526
            </a>
          </div>
          <div data-ps="src/components/Footer.astro:p4vf85">
            <span class="block font-semibold text-dark-foreground" data-ps="src/components/Footer.astro:abywyv">Main Office:</span>
            <p data-ps="src/components/Footer.astro:csf9v">301 Chris Drive, Lenhartsville, PA 19534</p>
          </div>
          <div class="pt-1" data-ps="src/components/Footer.astro:p4vf86">
            <span class="block font-semibold text-dark-foreground" data-ps="src/components/Footer.astro:abywyw">Direct Line:</span>
            <a href={`tel:${SITE.phone}`} class="text-primary hover:underline font-semibold no-underline" data-ps="src/components/Footer.astro:7gqbyq">{SITE.phone}</a>
          </div>
          <div data-ps="src/components/Footer.astro:p4vf87">
            <span class="block font-semibold text-dark-foreground" data-ps="src/components/Footer.astro:abywyx">Email:</span>
            <a href={`mailto:${SITE.email}`} class="hover:text-primary transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyr">{SITE.email}</a>
          </div>
        </div>
      </div>

      <!-- Regulatory Compliance & Affiliations -->
      <div data-ps="src/components/Footer.astro:p4vf88">
        <h2 class="text-base font-bold text-dark-foreground mb-4 tracking-tight" data-ps="src/components/Footer.astro:w7kloo">Approved Standards</h2>
        <p class="text-sm text-dark-muted-foreground mb-4 leading-relaxed" data-ps="src/components/Footer.astro:csf9w">
          Taught in accordance with American Heart Association, American Red Cross, OSHA Standard 1910.1030, ASHI, and NFPA standards.
        </p>
        <p class="text-xs text-dark-muted-foreground/90 bg-dark-border/40 p-3 rounded border border-dark-border" data-ps="src/components/Footer.astro:csf9x">
          Programs are able to be submitted under the PA Volunteer Fire Department relief-approved training.
        </p>
        <div class="mt-4 pt-2" data-ps="src/components/Footer.astro:p4vf89">
          <a
            href="https://www.kresecurity.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1 no-underline"
           data-ps="src/components/Footer.astro:7gqbys">
            <span data-ps="src/components/Footer.astro:abywyy">Visit KRE Security LLC</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-dark-border pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-dark-muted-foreground" data-ps="src/components/Footer.astro:p4vf8a">
      <p class="m-0" data-ps="src/components/Footer.astro:csfaj">
        © 2026 Eastern PA Educators | First Aid Training & CPR Certification Training in Eastern PA. All rights reserved.
      </p>
      <div class="flex flex-wrap gap-4" data-ps="src/components/Footer.astro:p4vf8b">
        <a href="/#about" class="hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyt">About</a>
        <a href="/#programs" class="hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyu">Programs</a>
        <a href="/#service-area" class="hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyv">Service Area</a>
        <a href="/#contact" class="hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyw">Contact</a>
      </div>
    </div>
  </Container>
</footer>
