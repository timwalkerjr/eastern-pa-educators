---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const pageTitle = "Bucks County CPR & First Aid Courses | Eastern PA Educators";
const pageDescription = "Our first aid instructors teach educational safety classes & workshops to Levittown, Quakertown, Doylestown & all of Bucks County Pennsylvania.";
---

<BaseLayout headerVariant="solid"
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://www.easternpaeducators.com/bucks-county-cpr-first-aid-courses/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Bucks County CPR & First Aid Courses',
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
    areaServed: {
      '@type': 'AdministrativeArea',
      name: 'Bucks County, Pennsylvania',
    },
    description: pageDescription,
  }}
>
  <!-- 1. Hero Banner Section -->
  <section class="relative bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:f6kupp">
    <div class="relative w-full h-[220px] md:h-[280px] lg:h-[320px]" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt727o">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="Bucks County CPR Teachers Demonstrating Proper CPR Technique"
        class="w-full h-full object-cover object-center brightness-60"
        loading="eager"
        width="1920"
        height="320" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:iaxxup" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background via-dark-background/60 to-transparent flex items-center justify-center" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt727p">
        <Container class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white uppercase drop-shadow-md" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:7ildf8">
            Bucks County First Aid &amp; CPR Training
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Main Curriculum & Overview Section -->
  <section class="py-12 md:py-20 bg-background text-foreground" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:f6kupo">
    <Container>
      <!-- Sub-heading Bar -->
      <div class="mb-10 text-center" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt727q">
        <span class="inline-block px-4 py-1.5 rounded bg-primary/10 text-primary font-bold text-xs uppercase tracking-widest mb-3" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2j">
          Certified Regional Education
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight uppercase text-foreground" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:75tjsg">
          FIRST AID CLASSES &amp; CPR COURSES IN BUCKS COUNTY PA
        </h2>
        <div class="w-20 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt727r"></div>
      </div>

      <!-- Video / Media Showcase + Introductory Text -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-16" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt727s">
        <!-- Media / Video Poster Card (5 Cols) -->
        <div class="lg:col-span-5 relative group rounded-2xl overflow-hidden shadow-lg border border-border bg-dark-background" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt727t">
          <div class="relative aspect-video" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt727u">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/63861c_e045c4fbd32242aebf8d84d0fa599553f000-0a755b-320.webp"
              alt="cpr certification classes in pa - first aid training king of prussia pa red cross"
              class="w-full h-full object-cover"
              loading="lazy"
              width="526"
              height="294" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:iaxxuq" />
            <div class="absolute inset-0 bg-black/30 flex items-center justify-center transition-all duration-300 group-hover:bg-black/40" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt727v">
              <a
                href={`tel:${SITE.phone}`}
                class="w-16 h-16 rounded-full bg-primary/90 hover:bg-primary text-primary-foreground flex items-center justify-center shadow-2xl transition-transform transform group-hover:scale-110"
                aria-label="Call for class schedules"
               data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:x310wu">
                <svg class="w-8 h-8 fill-current ml-1" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </a>
            </div>
          </div>
          <div class="p-4 bg-dark-background text-dark-foreground text-xs font-semibold flex items-center justify-between" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt727w">
            <span class="flex items-center gap-2" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2k">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2l"></span>
              On-Site &amp; Class Training
            </span>
            <span class="text-dark-muted-foreground" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2m">Bucks County, PA</span>
          </div>
        </div>

        <!-- Introductory Lead Copy (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col justify-center" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728i">
          <p class="text-base sm:text-lg text-foreground/90 leading-relaxed mb-6 font-medium" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60os">
            Eastern PA Educators is dedicated to equipping individuals across Bucks County, PA, with the skills, knowledge, and confidence to handle real-world emergencies effectively. Serving communities like Doylestown, New Hope, Quakertown, Perkasie, Warminster, Levittown, Langhorne, Bensalem, Yardley, Chalfont, Morrisville, Bristol, Upper Makefield, Newtown, Plumsteadville, Richboro, Sellersville, and more, we provide expert training in CPR, first aid, and automated external defibrillator (AED) use.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728j">
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728k">
              <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:lu8h0q">
                <span class="w-2 h-2 rounded-full bg-primary shrink-0" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2n"></span>
                Empowering Skills
              </h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60pe">
                Designed for educators, childcare providers, healthcare workers, and individuals eager to build practical emergency response expertise.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728l">
              <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:lu8h0p">
                <span class="w-2 h-2 rounded-full bg-primary shrink-0" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2o"></span>
                Real-World Value
              </h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60pf">
                Evidence-based courses focused on building muscle memory and critical thinking to act decisively during cardiac and airway emergencies.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Core Differentiators Breakdown (4 Points) -->
      <div class="mb-16" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728m">
        <div class="text-center max-w-2xl mx-auto mb-10" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728n">
          <h3 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight mb-3" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:lu8h03">
            Why Choose Eastern PA Educators?
          </h3>
          <p class="text-sm text-muted-foreground" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60pg">
            Trusted certified instructors delivering high-impact life safety training with realistic equipment.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728o">
          <!-- Card 1 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728p">
            <div data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728q">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt728r">
                01
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:yignqq">1. Practical, Hands-On Training</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60ph">
                We emphasize skill-building through interactive simulations. Using top-tier CPR manikins, AED trainers, and other medical tools, participants develop muscle memory and practical abilities for real-world scenarios.
              </p>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729d">
            <div data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729e">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729f">
                02
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:yignqr">2. Instruction from Experienced Professionals</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60pi">
                Our certified instructors, with backgrounds in emergency medical services (EMS), firefighting, and healthcare, bring real-world insights to the classroom. They guide you through crisis management and patient care with a focus on practical applications of your training.
              </p>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729g">
            <div data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729h">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729i">
                03
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:yignqs">3. Flexible Learning for Every Schedule</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60pj">
                We tailor our courses to fit your busy life, with options including evening sessions, weekend programs, group in-person classes, and hybrid learning formats. This flexibility ensures you can prioritize skill development at your convenience.
              </p>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729j">
            <div data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729k">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729l">
                04
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:yignqt">4. Recognized Certifications</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60pk">
                Our programs meet Pennsylvania regulatory standards and are accredited by the American Heart Association (AHA) and the American Red Cross. These certifications are valued by healthcare employers, educational institutions, and regulatory agencies, enhancing your professional credentials and preparedness.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 p-6 rounded-xl bg-amber-subtle border border-amber-200/80 text-foreground text-center max-w-4xl mx-auto" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt729m">
          <p class="text-sm sm:text-base leading-relaxed font-medium m-0" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60pl">
            At Eastern PA Educators, our mission is to enhance your skillset, broaden your knowledge, and prepare you for real-life emergencies. With our training, you’ll become a confident, capable responder who can make a difference when every second counts. Take the first step toward mastering life-saving techniques today!
          </p>
        </div>
      </div>

      <!-- Official Accreditation Logos Strip -->
      <div class="border-t border-border pt-10" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72a8">
        <p class="text-center text-xs font-bold text-muted-foreground uppercase tracking-widest mb-8" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60pm">
          Nationally Recognized Training Standards &amp; Certifications
        </p>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72a9">
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72aa">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/american_heart_association_logo-8fc04c-122.webp"
              alt="AHA Logo"
              class="max-h-12 w-auto object-contain"
              width="122"
              height="60" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:iaxxvc" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72ab">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc~-824966-114.webp"
              alt="American Red Cross Logo"
              class="max-h-12 w-auto object-contain"
              width="114"
              height="112" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:iaxxvd" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72ac">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/osha-logo-dceaa1-100.webp"
              alt="OSHA Logo"
              class="max-h-8 w-auto object-contain"
              width="100"
              height="29" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:iaxxve" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72ad">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/ashi-approved-training-center-logo-799753-67.webp"
              alt="ASHI Approved Training Center Logo"
              class="max-h-12 w-auto object-contain"
              width="67"
              height="70" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:iaxxvf" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72ae">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/nfpa-member-logo-31BDF5EC99-seeklogo_com-dec389-79.webp"
              alt="NFPA Member Logo"
              class="max-h-12 w-auto object-contain"
              width="79"
              height="90" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:iaxxvg" />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. Bucks County First Aid Classes & Workshops Details -->
  <section class="py-12 md:py-20 bg-surface border-y border-border" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:f6kupn">
    <Container>
      <div class="max-w-4xl mx-auto" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72af">
        <!-- Prominent Program Frame -->
        <div class="p-8 sm:p-10 rounded-2xl bg-background border-2 border-primary shadow-lg" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72ag">
          <span class="inline-block px-3 py-1 rounded bg-primary text-primary-foreground font-bold text-xs uppercase tracking-wider mb-4" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2p">
            Comprehensive Course Offerings
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight mb-4" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:75tjsf">
            First Aid, AED, &amp; CPR Training in Quakertown, Levittown, Doylestown, Sellersville, Perkasie, Chalfont, &amp; Throughout Bucks County PA
          </h2>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:ps60pn">
            Eastern PA Educators offers affordable, top-quality certification courses tailored for businesses, community groups, and organizations. Approved by the American Heart Association and Red Cross, our training delivers exceptional value without compromising quality. Whether you're a healthcare professional or new to lifesaving skills, our AHA and BLS courses provide everything you need to confidently save lives.
          </p>

          <h3 class="text-xl font-bold text-foreground mb-6 pb-2 border-b border-border" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:lu8h02">
            Our Bucks County First Aid Classes:
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:kt72ah">
            <a
              href="/#programs"
              class="flex items-center gap-3 p-4 rounded-xl bg-surface border border-border hover:border-primary hover:bg-amber-subtle/30 transition-all no-underline text-foreground font-semibold group"
             data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:x310xg">
              <span class="w-8 h-8 rounded-full bg-primary/20 text-foreground flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2q">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2r">Heartsaver First Aid</span>
            </a>

            <a
              href="/#programs"
              class="flex items-center gap-3 p-4 rounded-xl bg-surface border border-border hover:border-primary hover:bg-amber-subtle/30 transition-all no-underline text-foreground font-semibold group"
             data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:x310xh">
              <span class="w-8 h-8 rounded-full bg-primary/20 text-foreground flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/bucks-county-cpr-first-aid-courses.astro:57o2s">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
