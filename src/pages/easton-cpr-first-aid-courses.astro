---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'Easton CPR & First Aid Training | Eastern PA Educators';
const description = 'For top-notch CPR & first aid classes in Easton Pennsylvania, choose Eastern PA Educators! Our safety instructors are experienced & effective teachers.';
const canonicalUrl = 'https://www.easternpaeducators.com/easton-cpr-first-aid-courses/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Easton CPR & First Aid Training',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US'
      }
    },
    areaServed: {
      '@type': 'City',
      name: 'Easton, Pennsylvania'
    }
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/easton-cpr-first-aid-courses.astro:10f334">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6swh">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="Easton CPR Teachers Demonstrating Proper CPR Technique"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1905"
        height="250" data-ps="src/pages/easton-cpr-first-aid-courses.astro:ayxoji" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6swi"></div>
      
      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6swj">
        <Container>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/easton-cpr-first-aid-courses.astro:mxysof">
            EASTON CPR & FIRST AID TRAINING
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Regional Education Overview & 4 Key Benefits -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/easton-cpr-first-aid-courses.astro:10f335">
    <Container class="max-w-6xl">
      <!-- Badge + Heading -->
      <div class="text-center mb-12" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6swk">
        <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndem">
          Certified Regional Education
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground tracking-tight font-heading uppercase" data-ps="src/pages/easton-cpr-first-aid-courses.astro:xeqc32">
          BEST-IN-CLASS SAFETY & FIRST AID COURSES IN EASTON PA
        </h2>
      </div>

      <!-- Top Row: Video/Thumbnail Left (6 Cols) + Content Right (6 Cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-16" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6swl">
        <!-- Media Block -->
        <div class="lg:col-span-6" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6swm">
          <div class="relative rounded-2xl overflow-hidden border border-border shadow-xl bg-dark-background aspect-[16/10] group" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6swn">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/63861c_e045c4fbd32242aebf8d84d0fa599553f000-0a755b-320.webp"
              alt="cpr certification classes in pa - first aid training king of prussia pa red cross"
              class="w-full h-full object-cover brightness-90 group-hover:scale-105 transition-transform duration-500"
              width="526"
              height="294"
              loading="lazy" data-ps="src/pages/easton-cpr-first-aid-courses.astro:ayxojj" />
            <div class="absolute inset-0 bg-dark-background/40 flex items-center justify-center" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6swo">
              <a
                href={`tel:${SITE.phone}`}
                class="w-16 h-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center shadow-lg transition-transform group-hover:scale-110 no-underline"
                aria-label="Call for class schedules"
               data-ps="src/pages/easton-cpr-first-aid-courses.astro:mxpee9">
                <svg class="w-8 h-8 ml-1 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </a>
            </div>
            <div class="absolute bottom-0 inset-x-0 bg-dark-background/90 backdrop-blur-sm px-4 py-2.5 flex items-center justify-between text-xs text-dark-muted-foreground border-t border-dark-border" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6swp">
              <span class="inline-flex items-center gap-1.5 font-medium text-dark-foreground" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxnden">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndeo"></span>
                On-Site & Class Training
              </span>
              <span data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndep">Easton, PA</span>
            </div>
          </div>
        </div>

        <!-- Editorial Text -->
        <div class="lg:col-span-6 space-y-4" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxb">
          <p class="text-base sm:text-lg text-foreground/90 leading-relaxed" data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue67">
            Eastern PA Educators is your partner in saving lives. Our first aid courses in Easton, Pennsylvania, are designed to prepare you with the essential skills needed to respond confidently in life-threatening situations. From CPR and wound care to managing burns, fractures, and choking emergencies, our American Heart Association-certified instructors ensure you’re ready to act when every second counts.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed" data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue6t">
            Emergencies can happen anywhere, at any time. Knowing how to stop bleeding, perform CPR, or stabilize someone in distress can mean the difference between life and death. That’s why our training goes beyond theory—we focus on practical, hands-on techniques that equip you to handle real-world emergencies effectively.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxc">
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxd">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxe">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndeq"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxnder">Critical Preparation</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue6u">Designed for educators, healthcare professionals, childcare staff, and local organizations.</p>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxf">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxg">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndes"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndet">Life-Saving Readiness</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue6v">Evidence-based instruction with hands-on clinical simulation for emergency scenarios.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Why Choose Section -->
      <div class="text-center mb-10 pt-6 border-t border-border" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxh">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-foreground font-heading tracking-tight mb-2" data-ps="src/pages/easton-cpr-first-aid-courses.astro:iqbevf">
          How Our Easton CPR & First Aid Instructors Prepare People to Save Lives
        </h3>
        <p class="text-sm text-muted-foreground" data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue6w">
          Trusted certified instructors delivering high-impact life safety training with realistic equipment.
        </p>
      </div>

      <!-- 4 Numbered Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxi">
        <!-- 01 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxj">
          <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndeu">
            01
          </span>
          <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/easton-cpr-first-aid-courses.astro:41whn5">1. Expert Instruction You Can Trust</h4>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue6x">
            Our courses are led by highly qualified instructors with extensive experience. They deliver more than just knowledge—they instill confidence, ensuring you can act decisively in critical moments.
          </p>
        </div>

        <!-- 02 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sxk">
          <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndev">
            02
          </span>
          <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/easton-cpr-first-aid-courses.astro:41whn6">2. Flexible Training Options</h4>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue6y">
            We make life-saving skills accessible to everyone, offering flexible scheduling with evening, weekend, and group sessions to fit your busy life, whether you’re a healthcare professional, teacher, parent, or caregiver.
          </p>
        </div>

        <!-- 03 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sy6">
          <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndfh">
            03
          </span>
          <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/easton-cpr-first-aid-courses.astro:41whn7">3. Industry-Recognized Certifications</h4>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue6z">
            Our certifications, issued through the American Heart Association (AHA) and American Red Cross (ARC), meet Pennsylvania state regulations and are trusted by employers across healthcare, education, and childcare sectors. With these credentials, you’ll be prepared to make an impact wherever you go.
          </p>
        </div>

        <!-- 04 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sy7">
          <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndfi">
            04
          </span>
          <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/easton-cpr-first-aid-courses.astro:41whn8">4. Hands-On, Real-World Training</h4>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue70">
            We focus on practical application, using state-of-the-art simulation tools like advanced manikins and AEDs. By practicing high-quality CPR and other techniques, you’ll leave our courses ready to respond confidently to any emergency.
          </p>
        </div>
      </div>

      <!-- Accreditation Row -->
      <div class="text-center pt-6 border-t border-border" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sy8">
        <span class="block text-xs uppercase tracking-widest text-muted-foreground font-bold mb-6" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndfj">
          Nationally Recognized Training Standards & Certifications
        </span>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sy9">
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sya">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/american_heart_association_logo-8fc04c-122.webp"
              alt="AHA Logo"
              class="h-10 w-auto object-contain"
              width="122"
              height="60"
              loading="lazy" data-ps="src/pages/easton-cpr-first-aid-courses.astro:ayxok5" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6syb">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc~-824966-114.webp"
              alt="Red Cross Logo"
              class="h-10 w-auto object-contain"
              width="114"
              height="112"
              loading="lazy" data-ps="src/pages/easton-cpr-first-aid-courses.astro:ayxok6" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6syc">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/osha-logo-dceaa1-100.webp"
              alt="OSHA Logo"
              class="h-7 w-auto object-contain"
              width="100"
              height="29"
              loading="lazy" data-ps="src/pages/easton-cpr-first-aid-courses.astro:ayxok7" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6syd">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/ashi-approved-training-center-logo-799753-67.webp"
              alt="ASHI Approved Training Center Logo"
              class="h-12 w-auto object-contain"
              width="67"
              height="70"
              loading="lazy" data-ps="src/pages/easton-cpr-first-aid-courses.astro:ayxok8" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sye">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/nfpa-member-logo-31BDF5EC99-seeklogo_com-dec389-79.webp"
              alt="NFPA Member Logo"
              class="h-12 w-auto object-contain"
              width="79"
              height="90"
              loading="lazy" data-ps="src/pages/easton-cpr-first-aid-courses.astro:ayxok9" />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. Comprehensive Course Offerings Card Container -->
  <section class="py-14 md:py-20 bg-surface text-foreground border-y border-border" data-ps="src/pages/easton-cpr-first-aid-courses.astro:10f336">
    <Container class="max-w-4xl">
      <div class="bg-background rounded-3xl border border-border shadow-xl overflow-hidden" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6syf">
        <div class="p-8 sm:p-10 md:p-12" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sz1">
          <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndfk">
            Comprehensive Course Offerings
          </span>

          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground font-heading tracking-tight mb-4" data-ps="src/pages/easton-cpr-first-aid-courses.astro:xeqc33">
            Easton Pennsylvania CPR Lessons & First Aid Classes
          </h2>

          <div class="space-y-4 text-sm sm:text-base text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sz2">
            <p data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue71">
              KRE Security provides customized CPR certification, First Aid, and Automated External Defibrillator (AED) training programs tailored to the unique requirements of businesses, healthcare facilities, community organizations, and private groups in Easton, PA. Our courses are accredited by the American Heart Association (AHA) and the American Red Cross, ensuring compliance with the latest evidence-based protocols in emergency response training.
            </p>
            <p data-ps="src/pages/easton-cpr-first-aid-courses.astro:fmue72">
              For medical professionals, emergency responders, or community members seeking preparedness, we offer a comprehensive range of training options, including AHA-certified Basic Life Support (BLS) and advanced First Aid courses. These programs are designed to equip participants with critical interventions for cardiac arrest, respiratory emergencies, and trauma scenarios.
            </p>
          </div>

          <!-- Courses Grid -->
          <div class="mb-8" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sz3">
            <h3 class="text-base font-bold text-foreground uppercase tracking-wider font-heading mb-4" data-ps="src/pages/easton-cpr-first-aid-courses.astro:iqbevg">
              Our First Aid & CPR Training Options Include:
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sz4">
              <a href="/heartsaver-first-aid" class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group" data-ps="src/pages/easton-cpr-first-aid-courses.astro:mxpeev">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sz5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndfl">Heartsaver First Aid</span>
              </a>

              <a href="/heartsaver-cpr-aed" class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group" data-ps="src/pages/easton-cpr-first-aid-courses.astro:mxpeew">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sz6">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndfm">Heartsaver CPR/AED</span>
              </a>

              <a href="/friends-family-cpr-certification" class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group" data-ps="src/pages/easton-cpr-first-aid-courses.astro:mxpeex">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sz7">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndfn">Friends and Family CPR Certification</span>
              </a>

              <a href="/basic-life-support-certification" class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group" data-ps="src/pages/easton-cpr-first-aid-courses.astro:mxpeey">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0" data-ps="src/pages/easton-cpr-first-aid-courses.astro:dh6sz8">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/easton-cpr-first-aid-courses.astro:hxndfo">BLS for the Healthcare Providers</span>
