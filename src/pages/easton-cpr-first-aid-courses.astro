<script>
  import 'altcha';

  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
    statusEl.className = 'hidden';

    const formData = new FormData(form);
    const payload = {
      _formId: formData.get('_formId'),
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      organization: formData.get('organization'),
      program: formData.get('program'),
      groupSize: formData.get('groupSize'),
      message: formData.get('message'),
      altcha: formData.get('altcha'),
      subject: 'Easton CPR & First Aid Training Quote Request - Eastern PA Educators',
    };

    try {
      const res = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await res.json();

      if (res.ok && result.success !== false) {
        statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-green-100 text-green-800 border border-green-200';
        statusEl.textContent = 'Thanks for submitting! We will contact you promptly.';
        form.reset();
      } else {
        throw new Error(result.error || 'Submission failed');
      }
    } catch (err) {
      statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-red-100 text-red-800 border border-red-200';
      statusEl.textContent = err instanceof Error ? err.message : 'Submission error. Please call us at 484-334-3577.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Quote Request';
    }
  });
</script>
