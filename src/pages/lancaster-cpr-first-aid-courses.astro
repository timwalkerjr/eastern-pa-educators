              src="https://pagesmith-cdn.com/e5b58edc/images/osha-logo-dceaa1-100.webp"
              alt="OSHA Logo"
              class="h-7 w-auto object-contain"
              width="100"
              height="29"
              loading="lazy" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:69wli3" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pwy">
