          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pwz">
