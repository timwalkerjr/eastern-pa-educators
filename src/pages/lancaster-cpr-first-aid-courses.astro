---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const pageTitle = 'Lancaster CPR & First Aid Training | Eastern PA Educators';
const pageDescription = "Our educational CPR & first aid certification courses are Lancaster PA's best. Get Red Cross, OSHA, AHA or BLS certified by contacting our team today!";
const canonicalUrl = 'https://www.easternpaeducators.com/lancaster-cpr-first-aid-courses/';
---

<BaseLayout
  headerVariant="solid"
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Lancaster CPR & First Aid Training',
    description: pageDescription,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
    areaServed: {
      '@type': 'City',
      name: 'Lancaster, Pennsylvania',
    },
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:xlfveh">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pud">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="Lancaster CPR Teachers Demonstrating Proper CPR Technique"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1905"
        height="250" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:69wlhz" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pue"></div>

      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5puf">
        <Container>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:iqgzkm">
            Lancaster CPR &amp; First Aid Training
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Regional Education Overview & 4 Key Benefits -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:xlfvei">
    <Container class="max-w-6xl">
      <!-- Badge + Heading -->
      <div class="text-center mb-12" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pv1">
        <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19ft">
          Certified Regional Education
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground tracking-tight font-heading uppercase" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:xevws9">
          THE #1 FIRST AID &amp; CPR COURSES IN LANCASTER PENNSYLVANIA
        </h2>
      </div>

      <!-- Top Row: Video/Thumbnail Left (6 Cols) + Content Right (6 Cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-16" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pv2">
        <!-- Media Block -->
        <div class="lg:col-span-6" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pv3">
          <div class="relative rounded-2xl overflow-hidden border border-border shadow-xl bg-dark-background aspect-[16/10] group" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pv4">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/63861c_e045c4fbd32242aebf8d84d0fa599553f000-0a755b-320.webp"
              alt="cpr certification classes in pa - first aid training king of prussia pa red cross"
              class="w-full h-full object-cover brightness-90 group-hover:scale-105 transition-transform duration-500"
              width="526"
              height="294"
              loading="lazy" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:69wli0" />
            <div class="absolute inset-0 bg-dark-background/40 flex items-center justify-center" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pv5">
              <a
                href={`tel:${SITE.phone}`}
                class="w-16 h-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center shadow-lg transition-transform group-hover:scale-110"
                aria-label="Call for Lancaster CPR training details"
               data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:rc4rvk">
                <svg class="w-8 h-8 ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </a>
            </div>
            <div class="absolute bottom-0 inset-x-0 bg-dark-background/90 backdrop-blur-sm px-4 py-2.5 flex items-center justify-between text-xs text-dark-muted-foreground border-t border-dark-border" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pv6">
              <span class="inline-flex items-center gap-1.5 font-medium text-dark-foreground" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19fu">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19fv"></span>
                On-Site &amp; Class Training
              </span>
              <span data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19gh">Lancaster, PA</span>
            </div>
          </div>
        </div>

        <!-- Editorial Text -->
        <div class="lg:col-span-6 space-y-4" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pv7">
          <p class="text-base sm:text-lg text-foreground/90 leading-relaxed" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:ymzs3l">
            At Eastern PA Educators, we make CPR and first aid training simple, practical, and accessible for everyone in Lancaster. Whether you’re a teacher, childcare worker, healthcare professional, or just someone who wants to be prepared to save a life, our classes are designed to give you the skills and confidence to handle emergencies.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:ymzs3k">
            Emergencies can happen anytime, anywhere. Knowing what to do can save a life. At Eastern PA Educators, we’ll teach you how to perform CPR, use an AED, and provide first aid in a way that’s easy to understand and apply.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pv8">
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pv9">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pva">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19gi"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19gj">Critical Skills</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:ymzs3j">
                Tailored for educators, childcare staff, healthcare providers, and Lancaster organizations.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pvw">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pvx">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19gk"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19gl">Life-Saving Readiness</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:ymzs3i">
                Hands-on practical training on lifelike manikins to act quickly and decisively in emergencies.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Why Choose Section -->
      <div class="text-center mb-10 pt-6 border-t border-border" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pvy">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-foreground font-heading tracking-tight mb-2" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:mxt7yn">
          Benefits of Choosing Eastern PA Educators for Your CPR &amp; First Aid Training
        </h3>
        <p class="text-sm text-muted-foreground" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:ymzs2w">
          Trusted certified instructors delivering high-impact life safety training with realistic equipment.
        </p>
      </div>

      <!-- 4 Numbered Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pvz">
        <!-- 01 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pw0">
          <div data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pw1">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19gm">
              01
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:89eaqy">1. Learn from Experienced Instructors</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:ymzs2v">
              Our certified trainers have hands-on emergency experience. They share real-world tips to help you stay calm and act confidently if an emergency happens.
            </p>
          </div>
        </div>

        <!-- 02 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pw2">
          <div data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pw3">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19gn">
              02
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:89eaqz">2. Flexible Scheduling for Busy People</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:ymzs2u">
              We know your time is valuable, so we offer evening, weekend, and group sessions to fit your schedule.
            </p>
          </div>
        </div>

        <!-- 03 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pw4">
          <div data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pw5">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19go">
              03
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:89ear0">3. Certifications Employers Trust</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:ymzs2t">
              Our courses are backed by the American Heart Association (AHA) and American Red Cross. They meet Pennsylvania state requirements and are accepted by employers, schools, and healthcare organizations.
            </p>
          </div>
        </div>

        <!-- 04 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pwr">
          <div data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pws">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19gp">
              04
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:89ear1">4. Hands-On, Practical Training</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:ymzs2s">
              You’ll practice key skills like CPR, using an AED, and performing first aid on lifelike manikins. Our classes are interactive, so you’ll feel confident applying what you’ve learned.
            </p>
          </div>
        </div>
      </div>

      <!-- Accreditation Row -->
      <div class="text-center pt-6 border-t border-border" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pwt">
        <span class="block text-xs uppercase tracking-widest text-muted-foreground font-bold mb-6" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:o19gq">
