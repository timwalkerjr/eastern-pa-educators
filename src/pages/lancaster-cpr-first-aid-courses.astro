          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pwv">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/american_heart_association_logo-8fc04c-122.webp"
              alt="AHA Logo"
              class="h-10 w-auto object-contain"
              width="122"
              height="60"
              loading="lazy" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:69wli1" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pww">
