      <div class="bg-background rounded-3xl border border-border shadow-xl overflow-hidden" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5px0">
        <div class="p-8 sm:p-10 md:p-12" data-ps="src/pages/lancaster-cpr-first-aid-courses.astro:8s5pxm">
