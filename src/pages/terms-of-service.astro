---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'Terms of Service | Eastern PA Educators | Denver Pennsylvania';
const description = "At Eastern PA Educators, PA's #1 first aid & CPR training courses, transparency is of the utmost importance. Click here to read our Terms of Service.";
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl="https://www.easternpaeducators.com/terms-of-service/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Terms of Service',
    description: description,
    url: 'https://www.easternpaeducators.com/terms-of-service/',
    publisher: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
    },
  }}
>
  <section class="relative isolate bg-dark-background text-dark-foreground py-16 md:py-24 min-h-[60vh] border-b border-dark-border" data-ps="src/pages/terms-of-service.astro:t0s101">
    <Container>
      <div class="max-w-3xl mx-auto" data-ps="src/pages/terms-of-service.astro:t0s102">
        <!-- Cadence Accent Marker -->
        <div class="w-12 h-1 bg-primary mb-6 rounded-full" data-ps="src/pages/terms-of-service.astro:t0s103"></div>

        <h1 class="text-3xl sm:text-4xl md:text-[40px] font-bold text-dark-foreground uppercase tracking-tight mb-10 font-heading leading-tight" data-ps="src/pages/terms-of-service.astro:t0s104">
          TERMS OF SERVICE
        </h1>

        <div class="space-y-10 text-base md:text-[18px] text-dark-foreground/90 leading-relaxed font-sans" data-ps="src/pages/terms-of-service.astro:t0s105">
          <!-- 1. Terms -->
          <div class="space-y-4" data-ps="src/pages/terms-of-service.astro:t0s106">
            <h2 class="text-xl sm:text-2xl md:text-[28px] font-bold text-dark-foreground font-heading tracking-tight" data-ps="src/pages/terms-of-service.astro:t0s107">
              1. Terms
            </h2>
            <p data-ps="src/pages/terms-of-service.astro:t0s108">
              By accessing the website at <a href="https://www.easternpaeducators.com/" class="text-primary hover:underline font-medium transition-colors" data-ps="src/pages/terms-of-service.astro:t0s109">easternpaeducators.com</a>, you are agreeing to be bound by these terms of service, all applicable laws and regulations, and agree that you are responsible for compliance with any applicable local laws. If you do not agree with any of these terms, you are prohibited from using or accessing this site. The materials contained in this website are protected by applicable copyright and trademark law.
            </p>
          </div>

          <!-- 2. Use License -->
          <div class="space-y-4" data-ps="src/pages/terms-of-service.astro:t0s110">
            <h2 class="text-xl sm:text-2xl md:text-[28px] font-bold text-dark-foreground font-heading tracking-tight" data-ps="src/pages/terms-of-service.astro:t0s111">
              2. Use License
            </h2>
            <ol class="list-[lower-alpha] pl-6 space-y-4 text-dark-foreground/90">
              <li class="pl-2" data-ps="src/pages/terms-of-service.astro:xfsc7">
                Permission is granted to temporarily download one copy of the materials (information or software) on Eastern PA Educators' website for personal, non-commercial transitory viewing only. This is the grant of a license, not a transfer of title, and under this license you may not:
                <ol class="list-[lower-roman] pl-6 mt-3 space-y-2 text-dark-muted-foreground">
                  <li class="pl-2" data-ps="src/pages/terms-of-service.astro:xfsc6">modify or copy the materials;</li>
                  <li class="pl-2" data-ps="src/pages/terms-of-service.astro:xfsc5">use the materials for any commercial purpose, or for any public display (commercial or non-commercial);</li>
                  <li class="pl-2" data-ps="src/pages/terms-of-service.astro:xfsc4">attempt to decompile or reverse engineer any software contained on Eastern PA Educators’ website;</li>
                  <li class="pl-2" data-ps="src/pages/terms-of-service.astro:xfsc3">remove any copyright or other proprietary notations from the materials; or</li>
                  <li class="pl-2" data-ps="src/pages/terms-of-service.astro:xfsc2">transfer the materials to another person or “mirror” the materials on any other server.</li>
                </ol>
              </li>
              <li class="pl-2" data-ps="src/pages/terms-of-service.astro:xfsc1">
                This license shall automatically terminate if you violate any of these restrictions and may be terminated by Eastern PA Educators at any time. Upon terminating your viewing of these materials or upon the termination of this license, you must destroy any downloaded materials in your possession whether in electronic or printed format.
              </li>
            </ol>
          </div>

          <!-- 3. Disclaimer -->
          <div class="space-y-4" data-ps="src/pages/terms-of-service.astro:t0s112">
            <h2 class="text-xl sm:text-2xl md:text-[28px] font-bold text-dark-foreground font-heading tracking-tight" data-ps="src/pages/terms-of-service.astro:t0s113">
              3. Disclaimer
            </h2>
            <ol class="list-[lower-alpha] pl-6 space-y-4 text-dark-foreground/90">
              <li class="pl-2" data-ps="src/pages/terms-of-service.astro:xfsc0">
                The materials on Eastern PA Educators' website are provided on an ‘as is’ basis. Eastern PA Educators makes no warranties, expressed or implied, and hereby disclaims and negates all other warranties including, without limitation, implied warranties or conditions of merchantability, fitness for a particular purpose, or non-infringement of intellectual property or other violation of rights.
              </li>
              <li class="pl-2" data-ps="src/pages/terms-of-service.astro:xfsbz">
                Further, Eastern PA Educators does not warrant or make any representations concerning the accuracy, likely results, or reliability of the use of the materials on its website or otherwise relating to such materials or on any sites linked to this site.
              </li>
            </ol>
          </div>

          <!-- 4. Limitations -->
          <div class="space-y-4" data-ps="src/pages/terms-of-service.astro:t0s114">
            <h2 class="text-xl sm:text-2xl md:text-[28px] font-bold text-dark-foreground font-heading tracking-tight" data-ps="src/pages/terms-of-service.astro:t0s115">
              4. Limitations
            </h2>
            <p data-ps="src/pages/terms-of-service.astro:t0s116">
              In no event shall Eastern PA Educators or its suppliers be liable for any damages (including, without limitation, damages for loss of data or profit, or due to business interruption) arising out of the use or inability to use the materials on Eastern PA Educators' website, even if Eastern PA Educators or an Eastern PA Educators authorized representative has been notified orally or in writing of the possibility of such damage. Because some jurisdictions do not allow limitations on implied warranties, or limitations of liability for consequential or incidental damages, these limitations may not apply to you.
            </p>
          </div>

          <!-- 5. Accuracy of Materials -->
          <div class="space-y-4" data-ps="src/pages/terms-of-service.astro:t0s117">
            <h2 class="text-xl sm:text-2xl md:text-[28px] font-bold text-dark-foreground font-heading tracking-tight" data-ps="src/pages/terms-of-service.astro:t0s118">
              5. Accuracy of Materials
            </h2>
            <p data-ps="src/pages/terms-of-service.astro:t0s119">
              The materials appearing on Eastern PA Educators' website could include technical, typographical, or photographic errors. Eastern PA Educators does not warrant that any of the materials on its website are accurate, complete or current. Eastern PA Educators may make changes to the materials contained on its website at any time without notice. However, Eastern PA Educators does not make any commitment to update the materials.
            </p>
          </div>

          <!-- 6. Links -->
          <div class="space-y-4" data-ps="src/pages/terms-of-service.astro:t0s120">
            <h2 class="text-xl sm:text-2xl md:text-[28px] font-bold text-dark-foreground font-heading tracking-tight" data-ps="src/pages/terms-of-service.astro:t0s121">
              6. Links
            </h2>
            <p data-ps="src/pages/terms-of-service.astro:t0s122">
              Eastern PA Educators has not reviewed all of the sites linked to its website and is not responsible for the contents of any such linked site. The inclusion of any link does not imply endorsement by Eastern PA Educators of the site. Use of any such linked website is at the user’s own risk.
            </p>
          </div>

          <!-- 7. Modifications -->
          <div class="space-y-4" data-ps="src/pages/terms-of-service.astro:t0s123">
            <h2 class="text-xl sm:text-2xl md:text-[28px] font-bold text-dark-foreground font-heading tracking-tight" data-ps="src/pages/terms-of-service.astro:t0s124">
              7. Modifications
            </h2>
            <p data-ps="src/pages/terms-of-service.astro:t0s125">
              Eastern PA Educators may revise these terms of service for its website at any time without notice. By using this website you are agreeing to be bound by the then current version of these terms of service.
            </p>
          </div>

          <!-- 8. Governing Law -->
          <div class="space-y-4" data-ps="src/pages/terms-of-service.astro:t0s126">
            <h2 class="text-xl sm:text-2xl md:text-[28px] font-bold text-dark-foreground font-heading tracking-tight" data-ps="src/pages/terms-of-service.astro:t0s127">
              8. Governing Law
            </h2>
            <p data-ps="src/pages/terms-of-service.astro:t0s128">
              These terms and conditions are governed by and construed in accordance with the laws of Pennsylvania and you irrevocably submit to the exclusive jurisdiction of the courts in that State or location.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
