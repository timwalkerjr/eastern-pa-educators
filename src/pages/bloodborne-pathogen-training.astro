---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'Bloodborne Pathogen Training | BBP OPIM | Eastern PA Educator';
const description = 'We offer bloodborne pathogen training to help lab techs, first responders, healthcare professionals & others learn about PPE, exposure control & more.';
const canonicalUrl = 'https://www.easternpaeducators.com/bloodborne-pathogen-training/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Bloodborne Pathogen Training',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/bloodborne-pathogen-training.astro:a5o90z">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x1g">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="cpr certification PA - first aid certification training ready response bucks county pa"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="420" data-ps="src/pages/bloodborne-pathogen-training.astro:ojwjnz" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x1f"></div>

      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x1e">
        <Container>
          <div class="inline-block px-4 py-1.5 rounded bg-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-3 border border-primary/30" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x1d">
            OSHA Standard 1910.1030 Compliance
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/bloodborne-pathogen-training.astro:ynjcvu">
            Bloodborne Pathogen Training
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Why Bloodborne Pathogen Training is Essential Section -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/bloodborne-pathogen-training.astro:a5o90y">
    <Container class="max-w-4xl text-center">
      <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/bloodborne-pathogen-training.astro:nwwjhg">
        Workplace Safety &amp; Protection
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-6 uppercase" data-ps="src/pages/bloodborne-pathogen-training.astro:5td37j">
        Why Bloodborne Pathogen Training is Essential
      </h2>
      <div class="w-16 h-1 bg-primary mx-auto mb-8 rounded-full" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x1c"></div>
      <div class="p-6 sm:p-8 md:p-10 rounded-2xl bg-surface border border-border shadow-sm text-left sm:text-center" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x1b">
        <p class="text-base sm:text-lg text-foreground/90 leading-relaxed font-medium m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr6m">
          In today’s workplaces, especially in health care, it’s crucial to have a thorough understanding of bloodborne pathogens (BBPs) and how to handle potential exposure scenarios. Our training courses are designed to equip you with the knowledge and skills needed to protect yourself and others from the risks associated with bloodborne pathogens.
        </p>
      </div>
    </Container>
  </section>

  <!-- 3. What You'll Learn Through Our BBP & OPIM Classes Section (Amber Accent) -->
  <section class="py-14 md:py-20 bg-primary text-primary-foreground border-y border-amber-500/30" data-ps="src/pages/bloodborne-pathogen-training.astro:a5o90x">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0p">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary-foreground font-heading tracking-tight uppercase" data-ps="src/pages/bloodborne-pathogen-training.astro:5td37k">
          What You'll Learn Through Our BBP &amp; OPIM Classes
        </h2>
        <div class="w-16 h-1 bg-black mx-auto mt-4 rounded-full" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0o"></div>
        <p class="text-base sm:text-lg font-medium text-primary-foreground/90 mt-4 max-w-2xl mx-auto" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr78">
          Our comprehensive training covers:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0n">
        <!-- 1. Understanding Bloodborne Pathogens -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0m">
          <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0l">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0k">
              01
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6h2">
              Understanding Bloodborne Pathogens
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr79">
              Learn what BBPs are, how they spread, and the potential risks involved.
            </p>
          </div>
        </div>

        <!-- 2. Safety Precautions and Procedures -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0j">
          <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0i">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0h">
              02
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6h1">
              Safety Precautions and Procedures
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr7a">
              Get to know the best practices for handling blood and other potentially infectious materials (OPIM).
            </p>
          </div>
        </div>

        <!-- 3. Personal Protective Equipment (PPE) -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3x0g">
          <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzu">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzt">
              03
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6h0">
              Personal Protective Equipment (PPE)
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr7b">
              Discover how to choose, use, and dispose of PPE correctly.
            </p>
          </div>
        </div>

        <!-- 4. Exposure Control Plans -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between md:col-span-1 lg:col-span-1" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzs">
          <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzr">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzq">
              04
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6gz">
              Exposure Control Plans
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr7c">
              Develop and implement effective strategies to minimize exposure in the workplace.
            </p>
          </div>
        </div>

        <!-- 5. Emergency Response -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between md:col-span-2 lg:col-span-2" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzp">
          <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzo">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzn">
              05
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6gy">
              Emergency Response
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr7d">
              Gain the confidence to respond effectively in the event of an exposure incident.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. Key Features of Our Blood Borne Pathogen Safety Courses Section (Dark Obsidian) -->
  <section class="py-14 md:py-20 bg-dark-background text-dark-foreground border-b border-dark-border" data-ps="src/pages/bloodborne-pathogen-training.astro:ovke5c">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzm">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle/10 text-primary text-xs font-bold uppercase tracking-wider mb-3 border border-primary/20" data-ps="src/pages/bloodborne-pathogen-training.astro:nwwjhh">
          Professional Safety Standards
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/bloodborne-pathogen-training.astro:5td386">
          Key Features of Our Blood Borne Pathogen Safety Courses
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wzl">
        <!-- Feature 1: Expert Instruction -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wyz">
          <div class="flex items-start gap-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wyy">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wyx">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wyw">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6gx">
                Expert Instruction
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr7e">
                Our courses are led by certified professionals with extensive experience in occupational health and safety.
              </p>
            </div>
          </div>
        </div>

        <!-- Feature 2: Interactive Learning -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wyv">
          <div class="flex items-start gap-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wyu">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wyt">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wys">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6gw">
                Interactive Learning
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr7f">
                Engage with interactive modules, real-life scenarios, and hands-on activities that make learning practical and enjoyable.
              </p>
            </div>
          </div>
        </div>

        <!-- Feature 3: Flexible Scheduling -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wyr">
          <div class="flex items-start gap-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wyq">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wy4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wy3">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6gv">
                Flexible Scheduling
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr7g">
                Choose from a variety of scheduling options to suit your needs.
              </p>
            </div>
          </div>
        </div>

        <!-- Feature 4: Certification -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wy2">
          <div class="flex items-start gap-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wy1">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wy0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wxz">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6g9">
                Certification
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr7h">
                Upon successful completion, receive a certificate that demonstrates your commitment to workplace safety and compliance with OSHA standards.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 5. Who Should Attend Our Bloodborne Pathogen Training Sessions? Section -->
  <section class="py-14 md:py-20 bg-surface border-b border-border" data-ps="src/pages/bloodborne-pathogen-training.astro:ovke5d">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wxy">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/bloodborne-pathogen-training.astro:nwwji3">
          Target Audience &amp; Professions
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/bloodborne-pathogen-training.astro:5td387">
          Who Should Attend Our Bloodborne Pathogen Training Sessions?
        </h2>
        <div class="w-16 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wxx"></div>
        <p class="text-base sm:text-lg text-muted-foreground mt-4 max-w-2xl mx-auto" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr83">
          Our training courses are ideal for:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wxw">
        <!-- 1. Health care professionals -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wxv">
          <div class="flex items-start gap-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx9">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx8">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx7">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6g8">
                Health Care Professionals
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr84">
                Doctors, nurses, medical assistants, and dental staff in clinical settings.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Laboratory technicians -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx6">
          <div class="flex items-start gap-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx5">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <div data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx3">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/bloodborne-pathogen-training.astro:n0t6g7">
                Laboratory Technicians
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/bloodborne-pathogen-training.astro:ccfr85">
                Personnel handling diagnostic specimens, blood products, and body fluids.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. First responders -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx2">
          <div class="flex items-start gap-4" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx1">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/bloodborne-pathogen-training.astro:jm3wx0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
