---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const pageTitle = "Carbon County CPR & First Aid Courses | Eastern PA Educators";
const pageDescription = "We offer educational first aid classes & CPR training to Jim Thorpe, Lehighton, Palmerton, Nesquehoning, Lansford & all of Carbon County Pennsylvania.";
---

<BaseLayout headerVariant="solid"
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://www.easternpaeducators.com/carbon-county-cpr-first-aid-courses/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Carbon County CPR & First Aid Courses',
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
    areaServed: {
      '@type': 'AdministrativeArea',
      name: 'Carbon County, Pennsylvania',
    },
    description: pageDescription,
  }}
>
  <!-- 1. Hero Banner Section -->
  <section class="relative bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:q7nqpu">
    <div class="relative w-full h-[220px] md:h-[280px] lg:h-[320px]" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmb7">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="Carbon County CPR Teachers Demonstrating Proper CPR Technique"
        class="w-full h-full object-cover object-center brightness-60"
        loading="eager"
        width="1920"
        height="320" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:7zdhy8" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background via-dark-background/60 to-transparent flex items-center justify-center" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmb8">
        <Container class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white uppercase drop-shadow-md" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:upgz9p">
            Carbon County First Aid &amp; CPR Training
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Main Curriculum & Overview Section -->
  <section class="py-12 md:py-20 bg-background text-foreground" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:q7nqpv">
    <Container>
      <!-- Sub-heading Bar -->
      <div class="mb-10 text-center" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmb9">
        <span class="inline-block px-4 py-1.5 rounded bg-primary/10 text-primary font-bold text-xs uppercase tracking-widest mb-3" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puik">
          Certified Regional Education
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight uppercase text-foreground" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:pn85hr">
          CARBON COUNTY PA'S TOP FIRST AID, AED, SAFETY, &amp; CPR COURSES
        </h2>
        <div class="w-20 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmba"></div>
      </div>

      <!-- Video / Media Showcase + Introductory Text -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-16" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmbb">
        <!-- Media / Video Poster Card (5 Cols) -->
        <div class="lg:col-span-5 relative group rounded-2xl overflow-hidden shadow-lg border border-border bg-dark-background" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmbc">
          <div class="relative aspect-video" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmbd">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/63861c_e045c4fbd32242aebf8d84d0fa599553f000-0a755b-320.webp"
              alt="cpr certification classes in pa - first aid training king of prussia pa red cross"
              class="w-full h-full object-cover"
              loading="lazy"
              width="526"
              height="294" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:7zdhy9" />
            <div class="absolute inset-0 bg-black/30 flex items-center justify-center transition-all duration-300 group-hover:bg-black/40" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmbe">
              <a
                href={`tel:${SITE.phone}`}
                class="w-16 h-16 rounded-full bg-primary/90 hover:bg-primary text-primary-foreground flex items-center justify-center shadow-2xl transition-transform transform group-hover:scale-110"
                aria-label="Call for class schedules"
               data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:oz6d33">
                <svg class="w-8 h-8 fill-current ml-1" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </a>
            </div>
          </div>
          <div class="p-4 bg-dark-background text-dark-foreground text-xs font-semibold flex items-center justify-between" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmbf">
            <span class="flex items-center gap-2" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puil">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puim"></span>
              On-Site &amp; Class Training
            </span>
            <span class="text-dark-muted-foreground" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puin">Carbon County, PA</span>
          </div>
        </div>

        <!-- Introductory Lead Copy (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col justify-center" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmc1">
          <p class="text-base sm:text-lg text-foreground/90 leading-relaxed mb-6 font-medium" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcv1">
            Eastern PA Educators is the trusted choice for emergency training in Carbon County, PA. With years of experience serving communities like Jim Thorpe, Lehighton, Palmerton, Weatherly, Nesquehoning, Summit Hill, Albrightsville, Bowmanstown, Lansford, Parryville, and beyond, we specialize in teaching essential life-saving skills like CPR, first aid, and AED use with confidence and expertise.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmc2">
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmc3">
              <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ayt89h">
                <span class="w-2 h-2 rounded-full bg-primary shrink-0" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puio"></span>
                Learn Life-Saving Skills
              </h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvn">
                Our classes are designed for anyone—from educators and healthcare professionals to childcare workers and everyday individuals—who wants to feel prepared for emergencies with practical, real-world training.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmc4">
              <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ayt89i">
                <span class="w-2 h-2 rounded-full bg-primary shrink-0" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puip"></span>
                Why Training Matters
              </h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvo">
                Emergencies happen without warning. Whether it's a cardiac event or choking, our courses help you stay calm, think clearly, and act fast when it matters most.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Core Differentiators Breakdown (4 Points) -->
      <div class="mb-16" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmc5">
        <div class="text-center max-w-2xl mx-auto mb-10" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmc6">
          <h3 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight mb-3" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ayt8a4">
            Why Are We Considered Carbon County's Best First Aid Instructors?
          </h3>
          <p class="text-sm text-muted-foreground" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvp">
            Trusted certified instructors delivering high-impact life safety training with realistic equipment.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmc7">
          <!-- Card 1 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmc8">
            <div data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmc9">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmca">
                01
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:3ploy7">1. Trusted Hands-On Practice</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvq">
                We prioritize practical learning with interactive sessions. You’ll work directly with CPR manikins, AED trainers, and medical tools, ensuring you’re fully prepared to apply your skills in real-life scenarios.
              </p>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmcw">
            <div data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmcx">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmcy">
                02
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:3ploy6">2. Experienced, Reliable Instructors</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvr">
                Our team consists of emergency medical services (EMS) professionals, firefighters, and healthcare experts. With years of real-world experience, they’ll guide you step by step, sharing proven techniques and real-life examples to build your confidence.
              </p>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmcz">
            <div data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmd0">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmd1">
                03
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:3ploy5">3. Flexible, Accessible Training</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvs">
                We offer flexible training options to fit your busy schedule, including evening and weekend classes, in-person group sessions, and hybrid learning options tailored to your needs.
              </p>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmd2">
            <div data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmd3">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmd4">
                04
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:3ploy4">4. Recognized Certifications You Can Rely On</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvt">
                Our programs are certified by the American Heart Association (AHA) and the American Red Cross, meeting Pennsylvania standards. These respected certifications are widely trusted by employers and ensure you’re fully prepared to handle emergencies.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 p-6 rounded-xl bg-amber-subtle border border-amber-200/80 text-foreground text-center max-w-4xl mx-auto" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmd5">
          <p class="text-sm sm:text-base leading-relaxed font-medium m-0" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvu">
            At Eastern PA Educators, we combine experience, reliability, and expertise to give you the skills and confidence to save lives. Join us today and become the trusted person who can make a difference when every second counts!
          </p>
        </div>
      </div>

      <!-- Official Accreditation Logos Strip -->
      <div class="border-t border-border pt-10" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmdr">
        <p class="text-center text-xs font-bold text-muted-foreground uppercase tracking-widest mb-8" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvv">
          Nationally Recognized Training Standards &amp; Certifications
        </p>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmds">
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmdt">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/american_heart_association_logo-8fc04c-122.webp"
              alt="AHA Logo"
              class="max-h-12 w-auto object-contain"
              width="122"
              height="60" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:7zdhyv" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmdu">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc~-824966-114.webp"
              alt="American Red Cross Logo"
              class="max-h-12 w-auto object-contain"
              width="114"
              height="112" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:7zdhyw" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmdv">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/osha-logo-dceaa1-100.webp"
              alt="OSHA Logo"
              class="max-h-8 w-auto object-contain"
              width="100"
              height="29" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:7zdhyx" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmdw">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/ashi-approved-training-center-logo-799753-67.webp"
              alt="ASHI Approved Training Center Logo"
              class="max-h-12 w-auto object-contain"
              width="67"
              height="70" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:7zdhyy" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmdx">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/nfpa-member-logo-31BDF5EC99-seeklogo_com-dec389-79.webp"
              alt="NFPA Member Logo"
              class="max-h-12 w-auto object-contain"
              width="79"
              height="90" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:7zdhyz" />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. Carbon County First Aid Classes & Workshops Details -->
  <section class="py-12 md:py-20 bg-surface border-y border-border" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:q7nqpw">
    <Container>
      <div class="max-w-4xl mx-auto" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmdy">
        <!-- Prominent Program Frame -->
        <div class="p-8 sm:p-10 rounded-2xl bg-background border-2 border-primary shadow-lg" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmmdz">
          <span class="inline-block px-3 py-1 rounded bg-primary text-primary-foreground font-bold text-xs uppercase tracking-wider mb-4" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puiq">
            Comprehensive Course Offerings
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight mb-4" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:pn85hs">
            First Aid, AED, &amp; CPR Lessons in Weatherly, Palmerton, Jim Thorpe, Lansford, Nesquehoning, Lehighton, &amp; Throughout Carbon County PA
          </h2>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:hobcvw">
            Eastern PA Educators empowers individuals, businesses, and organizations with the skills needed to save lives and strengthen their communities. Our affordable, high-quality certification courses, approved by the American Heart Association and Red Cross, are designed to make lifesaving knowledge accessible to everyone. Whether you're a seasoned professional or just starting out, our AHA and BLS training equips you with the confidence to take action when it matters most.
          </p>

          <h3 class="text-xl font-bold text-foreground mb-6 pb-2 border-b border-border" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ayt8a5">
            Our Carbon County First Aid Workshops:
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:ahmme0">
            <a
              href="/#programs"
              class="flex items-center gap-3 p-4 rounded-xl bg-surface border border-border hover:border-primary hover:bg-amber-subtle/30 transition-all no-underline text-foreground font-semibold group"
             data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:oz6d3p">
              <span class="w-8 h-8 rounded-full bg-primary/20 text-foreground flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puir">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puis">Heartsaver First Aid</span>
            </a>

            <a
              href="/#programs"
              class="flex items-center gap-3 p-4 rounded-xl bg-surface border border-border hover:border-primary hover:bg-amber-subtle/30 transition-all no-underline text-foreground font-semibold group"
             data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:oz6d3q">
              <span class="w-8 h-8 rounded-full bg-primary/20 text-foreground flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8puit">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8pujf">Heartsaver CPR/AED</span>
            </a>

            <a
              href="/#programs"
              class="flex items-center gap-3 p-4 rounded-xl bg-surface border border-border hover:border-primary hover:bg-amber-subtle/30 transition-all no-underline text-foreground font-semibold group"
             data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:oz6d3r">
              <span class="w-8 h-8 rounded-full bg-primary/20 text-foreground flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8pujg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:a8pujh">Friends and Family CPR Certification</span>
            </a>

            <a
              href="/#programs"
              class="flex items-center gap-3 p-4 rounded-xl bg-surface border border-border hover:border-primary hover:bg-amber-subtle/30 transition-all no-underline text-foreground font-semibold group"
             data-ps="src/pages/carbon-county-cpr-first-aid-courses.astro:oz6d3s">
