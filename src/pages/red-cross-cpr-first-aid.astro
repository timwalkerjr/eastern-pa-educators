---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'American Red Cross CPR & First Aid | Eastern PA Educators';
const description = 'Learn American Red Cross CPR best practices & essential first aid skills relating to choking, overdoses, bleeding, shock & more. Get started today!';
const canonicalUrl = 'https://www.easternpaeducators.com/red-cross-cpr-first-aid/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'American Red Cross CPR & First Aid',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/red-cross-cpr-first-aid.astro:hero-sec">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/red-cross-cpr-first-aid.astro:hero-wrap">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="cpr certification PA - first aid certification training ready response bucks county pa"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="420"
        data-ps="src/pages/red-cross-cpr-first-aid.astro:hero-img"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/red-cross-cpr-first-aid.astro:hero-overlay"></div>

      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/red-cross-cpr-first-aid.astro:hero-content">
        <Container>
          <div class="inline-block px-4 py-1.5 rounded bg-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-3 border border-primary/30" data-ps="src/pages/red-cross-cpr-first-aid.astro:hero-badge">
            American Red Cross Program
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/red-cross-cpr-first-aid.astro:hero-h1">
            Red Cross CPR &amp; First Aid Courses
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Introduction Section -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/red-cross-cpr-first-aid.astro:intro-sec">
    <Container class="max-w-4xl text-center">
      <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/red-cross-cpr-first-aid.astro:intro-badge">
        American Red Cross Certification
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-6 uppercase" data-ps="src/pages/red-cross-cpr-first-aid.astro:intro-h2">
        PA's #1 American Red Cross First Aid Safety &amp; CPR Classes
      </h2>
      <div class="w-16 h-1 bg-primary mx-auto mb-8 rounded-full" data-ps="src/pages/red-cross-cpr-first-aid.astro:intro-cadence"></div>
      <div class="p-6 sm:p-8 md:p-10 rounded-2xl bg-surface border border-border shadow-sm text-left sm:text-center space-y-4" data-ps="src/pages/red-cross-cpr-first-aid.astro:intro-card">
        <p class="text-base sm:text-lg text-foreground/90 leading-relaxed font-medium m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:intro-p">
          In emergencies, every second counts, and being prepared can save lives. Equip yourself with the skills to respond effectively and confidently with our expert-led courses, designed to cover a wide range of scenarios. Whether you're at home, work, or play, understanding how to handle a medical emergency—from performing CPR to stopping bleeding—can make all the difference. Our courses provide hands-on practice and detailed guidance, ensuring you feel ready to take action when it matters most. Join us to gain the invaluable knowledge that could help protect your loved ones and community.
        </p>
      </div>
    </Container>
  </section>

  <!-- 3. Topics Covered During Our Educational Safety Programs (Amber Tone) -->
  <section class="py-14 md:py-20 bg-primary text-primary-foreground border-y border-amber-500/30" data-ps="src/pages/red-cross-cpr-first-aid.astro:topics-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/red-cross-cpr-first-aid.astro:topics-header">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary-foreground font-heading tracking-tight uppercase" data-ps="src/pages/red-cross-cpr-first-aid.astro:topics-h2">
          Topics Covered During Our Educational Safety Programs
        </h2>
        <div class="w-16 h-1 bg-black mx-auto mt-4 rounded-full" data-ps="src/pages/red-cross-cpr-first-aid.astro:topics-line"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/red-cross-cpr-first-aid.astro:topics-grid">
        <!-- 1. First Aid Training -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/red-cross-cpr-first-aid.astro:topic-card-1">
          <div data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod1i">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/red-cross-cpr-first-aid.astro:topic-icon-1">
              01
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:topic-title-1">
              First Aid Training
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:topic-desc-1">
              Injuries and accidents can happen to anyone at any time, which is why it's important to be prepared with first aid training. Our courses cover the basics of treating common injuries such as burns, cuts, and sprains, as well as more serious situations like fractures and head injuries. You'll also learn how to use basic medical equipment like bandages and splints. With our comprehensive training, you'll have the confidence to provide immediate care until professional help arrives.
            </p>
          </div>
        </div>

        <!-- 2. CPR Training -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/red-cross-cpr-first-aid.astro:topic-card-2">
          <div data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod24">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/red-cross-cpr-first-aid.astro:topic-icon-2">
              02
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:topic-title-2">
              CPR Training
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:topic-desc-2">
              Cardiopulmonary resuscitation (CPR) is a lifesaving skill that everyone should know. In our courses, you'll learn how to perform chest compressions and rescue breathing for adults, children, and infants. You'll also learn how to use an automated external defibrillator (AED), which can significantly improve the chances of survival during a cardiac emergency. Our training follows the latest guidelines from the American Red Cross and is suitable for both healthcare providers and members of the general public.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. Who Should Sign Up for Our Red Cross Training? (Dark Obsidian) -->
  <section class="py-14 md:py-20 bg-dark-background text-dark-foreground border-b border-dark-border" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle/10 text-primary text-xs font-bold uppercase tracking-wider mb-3 border border-primary/20" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-badge">
          Target Audience
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-h2">
          Who Should Sign Up for Our Red Cross Training?
        </h2>
        <p class="text-base sm:text-lg text-white max-w-3xl mx-auto leading-relaxed" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-intro">
          Our courses are meticulously designed to cater to a wide range of participants, ensuring they are equipped with the knowledge and skills needed for safety and preparedness:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-grid">
        <!-- 1. Individuals -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-card-1">
          <div class="flex items-start gap-4" data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod25">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-icon-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod26">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-title-1">
                Individuals
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-desc-1">
                Whether you're a student, a professional, or someone simply interested in personal development, our courses provide invaluable insights and techniques to enhance your personal safety and preparedness in various situations.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Families -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-card-2">
          <div class="flex items-start gap-4" data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod27">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-icon-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <div data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod28">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-title-2">
                Families
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-desc-2">
                Parents and guardians can gain peace of mind by learning how to protect their loved ones. Our courses cover essential safety measures, emergency preparedness, and strategies to ensure the well-being of family members in any circumstance.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Employees -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-card-3">
          <div class="flex items-start gap-4" data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod29">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-icon-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod2a">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-title-3">
                Employees
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-desc-3">
                For businesses, ensuring workplace safety is crucial. Our courses offer comprehensive training tailored to different industries, focusing on hazard identification, risk management, and creating a safe work environment for all employees.
              </p>
            </div>
          </div>
        </div>

        <!-- 4. Community Groups -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-card-4">
          <div class="flex items-start gap-4" data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod2b">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-icon-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div data-ps="src/pages/red-cross-cpr-first-aid.astro:2pod2c">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-title-4">
                Community Groups
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:who-desc-4">
                Organizations committed to community health and safety can greatly benefit from our courses. We provide strategies for effective communication, emergency response, and fostering a safe and supportive environment for all community members.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 5. Benefits of Red Cross CPR & First Aid Certifications Section -->
  <section class="py-14 md:py-20 bg-surface border-b border-border" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefits-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefits-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefits-badge">
          Certification Advantages
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefits-h2">
          Benefits of Red Cross CPR &amp; First Aid Certifications
        </h2>
        <div class="w-16 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefits-line"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefits-grid">
        <!-- Benefit 1: Expert Instruction -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-card-1">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/red-cross-cpr-first-aid.astro:b-num-1">
            01
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-title-1">
            Expert Instruction
          </h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-desc-1">
            Gain valuable insights from certified instructors who possess years of hands-on experience in emergency response. These experts provide comprehensive training, ensuring that you develop a deep understanding of critical techniques and best practices.
          </p>
        </div>

        <!-- Benefit 2: Lifesaving Skills -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-card-2">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/red-cross-cpr-first-aid.astro:b-num-2">
            02
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-title-2">
            Lifesaving Skills
          </h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-desc-2">
            Acquire the knowledge to react swiftly and efficiently during emergencies, equipping yourself with the skills necessary to potentially save lives. Our program focuses on practical applications for a wide range of scenarios, preparing you for real-world challenges.
          </p>
        </div>

        <!-- Benefit 3: Peace of Mind -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-card-3">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/red-cross-cpr-first-aid.astro:b-num-3">
            03
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-title-3">
            Peace of Mind
          </h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-desc-3">
            Feel confident and prepared, knowing you have received thorough training that empowers you to handle unexpected situations with competence. Our curriculum is designed to build your confidence through hands-on practice and expert guidance.
          </p>
        </div>

        <!-- Benefit 4: Nationwide Recognition -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-card-4">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/red-cross-cpr-first-aid.astro:b-num-4">
            04
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-title-4">
            Nationwide Recognition
          </h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:benefit-desc-4">
            Obtain a certification that is widely accepted and respected across the country, providing you with credentials that carry significant weight. This recognition opens doors to opportunities and assures others of your capability and professionalism.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- 6. "Ready to Get Started?" Media Banner Section -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden py-20 md:py-28" data-ps="src/pages/red-cross-cpr-first-aid.astro:ready-sec">
    <div class="absolute inset-0 z-0" data-ps="src/pages/red-cross-cpr-first-aid.astro:ready-bg-wrap">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_469d743bfd38472a8549e40154518014~mv2_d_2016_1512_s_2-b6c82d-1536.webp"
        alt="IMG_1212.jpg - American Red Cross CPR and First Aid Training in Eastern PA"
        class="w-full h-full object-cover object-center brightness-40"
        loading="lazy"
        width="1920"
        height="500"
        data-ps="src/pages/red-cross-cpr-first-aid.astro:ready-img"
      />
      <div class="absolute inset-0 bg-dark-background/70 backdrop-blur-[2px]" data-ps="src/pages/red-cross-cpr-first-aid.astro:ready-blur"></div>
    </div>

    <Container class="relative z-10 max-w-3xl text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white font-heading uppercase tracking-tight mb-6 drop-shadow-md" data-ps="src/pages/red-cross-cpr-first-aid.astro:ready-h2">
        Ready to Get Started?
      </h2>
      <p class="text-base sm:text-xl text-white/95 leading-relaxed font-medium mb-8" data-ps="src/pages/red-cross-cpr-first-aid.astro:ready-p">
        Don't wait until it’s too late. Ensure the safety of yourself, your family, your coworkers, and the general public by enrolling in our American Red Cross CPR &amp; First Aid Safety courses today.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4" data-ps="src/pages/red-cross-cpr-first-aid.astro:ready-actions">
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-md bg-primary text-primary-foreground font-bold text-base hover:bg-primary-hover transition-colors shadow-lg no-underline"
          data-ps="src/pages/red-cross-cpr-first-aid.astro:ready-btn-quote"
        >
          Contact Us for a Quote
        </a>
        <a
          href={`tel:${SITE.phone}`}
