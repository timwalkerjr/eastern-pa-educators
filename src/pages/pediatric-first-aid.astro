---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'Pediatric First Aid Training Courses | Eastern PA Educators';
const description = 'From CPR & choking relief emergency care & more, our pediatric first aid training courses are essential to protecting children, toddlers, babies & infants.';
const canonicalUrl = 'https://www.easternpaeducators.com/pediatric-first-aid/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Pediatric First Aid Training',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/pediatric-first-aid.astro:hero-sec">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/pediatric-first-aid.astro:hero-wrap">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="cpr certification PA - first aid certification training ready response bucks county pa"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="420"
        data-ps="src/pages/pediatric-first-aid.astro:hero-img"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/pediatric-first-aid.astro:hero-overlay"></div>

      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/pediatric-first-aid.astro:hero-content">
        <Container>
          <div class="inline-block px-4 py-1.5 rounded bg-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-3 border border-primary/30" data-ps="src/pages/pediatric-first-aid.astro:hero-badge">
            Child &amp; Infant Life-Saving Program
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/pediatric-first-aid.astro:hero-h1">
            Pediatric First Aid
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Introduction & Child Safety Section -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/pediatric-first-aid.astro:intro-sec">
    <Container class="max-w-4xl text-center">
      <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/pediatric-first-aid.astro:intro-badge">
        Pediatric Life-Safety Education
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-6 uppercase" data-ps="src/pages/pediatric-first-aid.astro:intro-h2">
        Ensure Child Safety with Expert Training
      </h2>
      <div class="w-16 h-1 bg-primary mx-auto mb-8 rounded-full" data-ps="src/pages/pediatric-first-aid.astro:intro-cadence"></div>
      <div class="p-6 sm:p-8 md:p-10 rounded-2xl bg-surface border border-border shadow-sm text-left sm:text-center space-y-4" data-ps="src/pages/pediatric-first-aid.astro:intro-card">
        <p class="text-base sm:text-lg text-foreground/90 leading-relaxed font-medium m-0" data-ps="src/pages/pediatric-first-aid.astro:intro-p">
          When it comes to the safety of our children, nothing less than the best will do. At Eastern PA Educators, we understand the importance of being prepared for any emergency. Our Pediatric First Aid courses are designed to equip you with the knowledge and skills you need to confidently handle a variety of situations.
        </p>
      </div>
    </Container>
  </section>

  <!-- 3. What Do Our Pediatric First Aid Classes Focus On? Section (Golden Amber Accent) -->
  <section class="py-14 md:py-20 bg-primary text-primary-foreground border-y border-amber-500/30" data-ps="src/pages/pediatric-first-aid.astro:focus-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/pediatric-first-aid.astro:focus-header">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary-foreground font-heading tracking-tight uppercase" data-ps="src/pages/pediatric-first-aid.astro:focus-h2">
          What Do Our Pediatric First Aid Classes Focus On?
        </h2>
        <div class="w-16 h-1 bg-black mx-auto mt-4 rounded-full" data-ps="src/pages/pediatric-first-aid.astro:focus-line"></div>
        <p class="text-base sm:text-lg font-medium text-primary-foreground/90 mt-4 max-w-2xl mx-auto" data-ps="src/pages/pediatric-first-aid.astro:focus-intro">
          Our courses cover a wide range of essential topics, including:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/pediatric-first-aid.astro:focus-grid">
        <!-- 1. CPR and Choking Relief -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/pediatric-first-aid.astro:focus-card-1">
          <div data-ps="src/pages/pediatric-first-aid.astro:r4gbco">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/pediatric-first-aid.astro:focus-icon-1">
              01
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:focus-title-1">
              CPR and Choking Relief
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:focus-desc-1">
              Learn life-saving techniques to assist a child in distress.
            </p>
          </div>
        </div>

        <!-- 2. Injury Management -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/pediatric-first-aid.astro:focus-card-2">
          <div data-ps="src/pages/pediatric-first-aid.astro:r4gbcn">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/pediatric-first-aid.astro:focus-icon-2">
              02
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:focus-title-2">
              Injury Management
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:focus-desc-2">
              From cuts and scrapes to fractures, know how to provide immediate care.
            </p>
          </div>
        </div>

        <!-- 3. Illness Recognition and Care -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/pediatric-first-aid.astro:focus-card-3">
          <div data-ps="src/pages/pediatric-first-aid.astro:r4gbc1">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/pediatric-first-aid.astro:focus-icon-3">
              03
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:focus-title-3">
              Illness Recognition and Care
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:focus-desc-3">
              Identify signs of common illnesses and respond effectively.
            </p>
          </div>
        </div>

        <!-- 4. Emergency Procedures -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/pediatric-first-aid.astro:focus-card-4">
          <div data-ps="src/pages/pediatric-first-aid.astro:r4gbc0">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/pediatric-first-aid.astro:focus-icon-4">
              04
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:focus-title-4">
              Emergency Procedures
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:focus-desc-4">
              Understand how to act quickly and efficiently in urgent situations.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. Why Choose Our Pediatric First Aid Courses? Section (Dark Obsidian) -->
  <section class="py-14 md:py-20 bg-dark-background text-dark-foreground border-b border-dark-border" data-ps="src/pages/pediatric-first-aid.astro:why-choose-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/pediatric-first-aid.astro:why-choose-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle/10 text-primary text-xs font-bold uppercase tracking-wider mb-3 border border-primary/20" data-ps="src/pages/pediatric-first-aid.astro:why-choose-badge">
          Certified Instruction
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/pediatric-first-aid.astro:why-choose-h2">
          Why Choose Our Pediatric First Aid Courses?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-ps="src/pages/pediatric-first-aid.astro:why-choose-grid">
        <!-- 1. Expert Instructors -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/pediatric-first-aid.astro:why-card-1">
          <div data-ps="src/pages/pediatric-first-aid.astro:r4gbbz">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm mb-4" data-ps="src/pages/pediatric-first-aid.astro:why-icon-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:why-title-1">
              Expert Instructors
            </h3>
            <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:why-desc-1">
              Our certified trainers are experienced professionals who specialize in pediatric care. They bring real-world knowledge to the classroom, ensuring you receive the highest quality education.
            </p>
          </div>
        </div>

        <!-- 2. Hands-On Training -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/pediatric-first-aid.astro:why-card-2">
          <div data-ps="src/pages/pediatric-first-aid.astro:r4gbby">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm mb-4" data-ps="src/pages/pediatric-first-aid.astro:why-icon-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:why-title-2">
              Hands-On Training
            </h3>
            <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:why-desc-2">
              Interactive sessions provide practical experience. You’ll practice techniques on manikins and participate in scenario-based exercises to build your confidence.
            </p>
          </div>
        </div>

        <!-- 3. Flexible Scheduling -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/pediatric-first-aid.astro:why-card-3">
          <div data-ps="src/pages/pediatric-first-aid.astro:r4gbbx">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm mb-4" data-ps="src/pages/pediatric-first-aid.astro:why-icon-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:why-title-3">
              Flexible Scheduling
            </h3>
            <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:why-desc-3">
              We offer multiple course schedules to fit your busy life.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 5. Who Should Enroll in a First Aid Class for Infants, Toddlers & Children? Section -->
  <section class="py-14 md:py-20 bg-surface border-b border-border" data-ps="src/pages/pediatric-first-aid.astro:who-enroll-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/pediatric-first-aid.astro:who-enroll-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/pediatric-first-aid.astro:who-enroll-badge">
          Audience &amp; Caregivers
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/pediatric-first-aid.astro:who-enroll-h2">
          Who Should Enroll in a First Aid Class for Infants, Toddlers &amp; Children?
        </h2>
        <div class="w-16 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/pediatric-first-aid.astro:who-enroll-line"></div>
        <p class="text-base sm:text-lg text-muted-foreground mt-4 max-w-2xl mx-auto" data-ps="src/pages/pediatric-first-aid.astro:who-enroll-intro">
          Our Pediatric First Aid courses are perfect for:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/pediatric-first-aid.astro:who-enroll-grid">
        <!-- 1. Parents and Guardians -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/pediatric-first-aid.astro:who-card-1">
          <div class="flex items-start gap-4" data-ps="src/pages/pediatric-first-aid.astro:r4gbbw">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/pediatric-first-aid.astro:who-icon-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <div data-ps="src/pages/pediatric-first-aid.astro:r4gbbv">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:who-title-1">
                Parents and Guardians
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:who-desc-1">
                Ensure you’re prepared to protect your little ones.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Childcare Providers -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/pediatric-first-aid.astro:who-card-2">
          <div class="flex items-start gap-4" data-ps="src/pages/pediatric-first-aid.astro:r4gbbu">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/pediatric-first-aid.astro:who-icon-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div data-ps="src/pages/pediatric-first-aid.astro:r4gbbt">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:who-title-2">
                Childcare Providers
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:who-desc-2">
                Meet licensing requirements and increase your professional skills.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Teachers and Educators -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/pediatric-first-aid.astro:who-card-3">
          <div class="flex items-start gap-4" data-ps="src/pages/pediatric-first-aid.astro:r4gbbs">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/pediatric-first-aid.astro:who-icon-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <div data-ps="src/pages/pediatric-first-aid.astro:xhtb1c">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:who-title-3">
                Teachers and Educators
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:who-desc-3">
                Create a safer learning environment for your students.
              </p>
            </div>
          </div>
        </div>

        <!-- 4. Community Members -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/pediatric-first-aid.astro:who-card-4">
          <div class="flex items-start gap-4" data-ps="src/pages/pediatric-first-aid.astro:xhtb1d">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/pediatric-first-aid.astro:who-icon-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div data-ps="src/pages/pediatric-first-aid.astro:xhtb1e">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/pediatric-first-aid.astro:who-title-4">
                Community Members
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/pediatric-first-aid.astro:who-desc-4">
                Anyone who regularly interacts with children and wants to be prepared.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 6. "Ready to Get Started?" Media Banner Section -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden py-20 md:py-28" data-ps="src/pages/pediatric-first-aid.astro:ready-sec">
    <div class="absolute inset-0 z-0" data-ps="src/pages/pediatric-first-aid.astro:ready-bg-wrap">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_469d743bfd38472a8549e40154518014~mv2_d_2016_1512_s_2-79015e-1536.webp"
        alt="IMG_1212.jpg - Pediatric First Aid Equipment and Child CPR Training in Eastern PA"
        class="w-full h-full object-cover object-center brightness-40"
        loading="lazy"
        width="1920"
        height="500"
        data-ps="src/pages/pediatric-first-aid.astro:ready-img"
      />
      <div class="absolute inset-0 bg-dark-background/70 backdrop-blur-[2px]" data-ps="src/pages/pediatric-first-aid.astro:ready-blur"></div>
    </div>

    <Container class="relative z-10 max-w-3xl text-center">
