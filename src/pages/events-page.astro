---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'Events & Training Schedule | Eastern PA Educators';
const description = 'View upcoming CPR, First Aid, AED, and life safety training sessions or schedule custom on-site group certification courses across Eastern Pennsylvania.';
const canonicalUrl = 'https://www.easternpaeducators.com/events-page/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Events & Training Schedule',
    description: description,
    url: canonicalUrl,
    publisher: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
  }}
>
  <!-- 1. Hero Banner Section -->
  <section class="relative bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/events-page.astro:hero-sec">
    <div class="relative w-full h-[220px] sm:h-[280px] md:h-[340px] overflow-hidden" data-ps="src/pages/events-page.astro:hero-wrap">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="CPR and First Aid Training Instructors in Eastern Pennsylvania"
        class="w-full h-full object-cover object-center brightness-60"
        loading="eager"
        width="1920"
        height="340"
        data-ps="src/pages/events-page.astro:hero-img"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background via-dark-background/60 to-transparent flex items-center justify-center text-center p-4" data-ps="src/pages/events-page.astro:hero-overlay">
        <Container>
          <div class="w-12 h-1 bg-primary mx-auto mb-4 rounded-full" data-ps="src/pages/events-page.astro:hero-cadence"></div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/events-page.astro:hero-h1">
            Events &amp; Training Schedule
          </h1>
          <p class="mt-3 text-sm sm:text-base text-dark-muted-foreground max-w-2xl mx-auto" data-ps="src/pages/events-page.astro:hero-p">
            Certified First Aid, CPR, AED &amp; Life Safety Training Courses throughout Eastern Pennsylvania
          </p>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Events Overview & Scheduling Details -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/events-page.astro:events-content-sec">
    <Container class="max-w-5xl">
      <!-- Intro Information Card -->
      <div class="bg-surface rounded-3xl border border-border shadow-md overflow-hidden p-8 sm:p-12 mb-12" data-ps="src/pages/events-page.astro:main-card">
        <div class="max-w-3xl mx-auto text-center" data-ps="src/pages/events-page.astro:90wst0">
          <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/events-page.astro:badge">
            Upcoming Classes &amp; Custom Sessions
          </span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-6 uppercase" data-ps="src/pages/events-page.astro:card-h2">
            Schedule a Class for Your Organization or Facility
          </h2>
          <p class="text-base sm:text-lg text-foreground/90 leading-relaxed mb-6 font-medium" data-ps="src/pages/events-page.astro:lead-p">
            Eastern PA Educators provides on-demand and scheduled training sessions for businesses, healthcare professionals, educational institutions, child care centers, and community groups throughout Eastern Pennsylvania.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/events-page.astro:desc-p">
            Whether you need on-site group training at your facility or wish to attend a class at our Hamburg training center, our certified instructors offer flexible scheduling, including weekday, evening, and weekend options.
          </p>

          <!-- Quick Action Buttons -->
          <div class="flex flex-wrap items-center justify-center gap-4" data-ps="src/pages/events-page.astro:actions-wrap">
            <a
              href={`tel:${SITE.phone}`}
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-primary text-primary-foreground font-bold text-sm hover:bg-primary-hover transition-colors shadow-sm no-underline"
              data-ps="src/pages/events-page.astro:btn-call"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span data-ps="src/pages/events-page.astro:i9siry">Call to Inquire: {SITE.phone}</span>
            </a>
            <a
              href="/#programs"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-background border border-border text-foreground font-semibold text-sm hover:border-primary hover:text-primary transition-colors no-underline shadow-sm"
              data-ps="src/pages/events-page.astro:btn-programs"
            >
              <span data-ps="src/pages/events-page.astro:i9sirz">Explore Training Programs</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- 3 Feature Highlight Columns -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 pt-10 border-t border-border" data-ps="src/pages/events-page.astro:features-grid">
          <div class="p-5 rounded-2xl bg-background border border-border text-left" data-ps="src/pages/events-page.astro:feat-1">
            <div class="w-8 h-8 rounded-lg bg-amber-subtle flex items-center justify-center text-foreground font-bold mb-3 text-xs" data-ps="src/pages/events-page.astro:f1-icon">01</div>
            <h3 class="text-base font-bold text-foreground font-heading mb-1.5" data-ps="src/pages/events-page.astro:f1-title">On-Site Group Training</h3>
            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/events-page.astro:f1-desc">
              We bring training manikins, AED units, and materials directly to your business, school, or municipal facility.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-background border border-border text-left" data-ps="src/pages/events-page.astro:feat-2">
            <div class="w-8 h-8 rounded-lg bg-amber-subtle flex items-center justify-center text-foreground font-bold mb-3 text-xs" data-ps="src/pages/events-page.astro:f2-icon">02</div>
            <h3 class="text-base font-bold text-foreground font-heading mb-1.5" data-ps="src/pages/events-page.astro:f2-title">Hamburg Training Center</h3>
            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/events-page.astro:f2-desc">
              Classroom sessions held at 16600 Pottsville Pike, Hamburg, PA with hands-on practice simulations.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-background border border-border text-left" data-ps="src/pages/events-page.astro:feat-3">
            <div class="w-8 h-8 rounded-lg bg-amber-subtle flex items-center justify-center text-foreground font-bold mb-3 text-xs" data-ps="src/pages/events-page.astro:f3-icon">03</div>
            <h3 class="text-base font-bold text-foreground font-heading mb-1.5" data-ps="src/pages/events-page.astro:f3-title">AHA &amp; ARC Certified</h3>
            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/events-page.astro:f3-desc">
              Industry-standard, OSHA-compliant 2-year certification cards issued upon course completion.
            </p>
          </div>
        </div>
      </div>

      <!-- Contact & Schedule Request Form -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" data-ps="src/pages/events-page.astro:form-grid">
        <!-- Left: Direct Info (5 cols) -->
        <div class="lg:col-span-5 space-y-4" data-ps="src/pages/events-page.astro:contact-left">
          <div class="p-6 rounded-2xl bg-surface border border-border space-y-4" data-ps="src/pages/events-page.astro:info-box">
            <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/events-page.astro:info-h3">Direct Contact Details</h3>
            
            <a
              href={`tel:${SITE.phone}`}
              class="flex items-center gap-3 p-3 rounded-xl bg-background border border-border hover:border-primary transition-colors no-underline group"
              data-ps="src/pages/events-page.astro:contact-phone"
            >
              <div class="w-9 h-9 rounded-lg bg-amber-subtle flex items-center justify-center text-foreground font-bold shrink-0" data-ps="src/pages/events-page.astro:90wst1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div data-ps="src/pages/events-page.astro:90wst2">
                <span class="block text-xs uppercase tracking-wider text-muted-foreground font-bold" data-ps="src/pages/events-page.astro:i9sis0">Call Today</span>
                <span class="text-sm font-bold text-foreground group-hover:text-primary transition-colors" data-ps="src/pages/events-page.astro:i9sis1">{SITE.phone}</span>
              </div>
            </a>

            <a
              href={`mailto:${SITE.email}`}
              class="flex items-center gap-3 p-3 rounded-xl bg-background border border-border hover:border-primary transition-colors no-underline group"
              data-ps="src/pages/events-page.astro:contact-email"
            >
              <div class="w-9 h-9 rounded-lg bg-amber-subtle flex items-center justify-center text-foreground font-bold shrink-0" data-ps="src/pages/events-page.astro:90wst3">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div data-ps="src/pages/events-page.astro:90wst4">
                <span class="block text-xs uppercase tracking-wider text-muted-foreground font-bold" data-ps="src/pages/events-page.astro:i9sis2">Email Inquiries</span>
                <span class="text-sm font-bold text-foreground group-hover:text-primary transition-colors" data-ps="src/pages/events-page.astro:i9sis3">{SITE.email}</span>
              </div>
            </a>

            <div class="pt-3 border-t border-border text-xs text-muted-foreground space-y-2" data-ps="src/pages/events-page.astro:address-info">
              <div data-ps="src/pages/events-page.astro:90wst5">
                <span class="font-bold text-foreground block" data-ps="src/pages/events-page.astro:i9sisp">Training Address:</span>
                <a href="https://maps.app.goo.gl/muXmn7KridwPnmVn9" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors no-underline" data-ps="src/pages/events-page.astro:2lwvyt">
                  16600 Pottsville Pike, Hamburg, PA 19526
                </a>
              </div>
              <div data-ps="src/pages/events-page.astro:90wst6">
                <span class="font-bold text-foreground block" data-ps="src/pages/events-page.astro:i9sisq">Main Office:</span>
                <p class="m-0" data-ps="src/pages/events-page.astro:4i10q7">301 Chris Drive, Lenhartsville, PA 19534</p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-amber-subtle border border-amber-200 text-xs text-foreground font-medium" data-ps="src/pages/events-page.astro:license-note">
            We Are Fully Licensed and Insured. We Accept All Major Credit Cards and Payment Plans.
          </div>
        </div>

        <!-- Right: Inquiry / Schedule Form (7 cols) -->
        <div class="lg:col-span-7" data-ps="src/pages/events-page.astro:form-right">
          <div class="p-6 sm:p-8 bg-surface rounded-2xl border border-border shadow-md" data-ps="src/pages/events-page.astro:form-box">
            <h3 class="text-xl font-bold text-foreground font-heading mb-1" data-ps="src/pages/events-page.astro:form-title">Inquire About Class Dates &amp; Events</h3>
            <p class="text-xs text-muted-foreground mb-6" data-ps="src/pages/events-page.astro:form-subtitle">
              Fill out the form below to check available dates or request a custom training session.
            </p>

            <form id="events-inquiry-form" class="space-y-4" data-ps="src/pages/events-page.astro:form-el">
              <input type="hidden" name="_formId" value="events-inquiry" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/events-page.astro:mme6oi">
                <div data-ps="src/pages/events-page.astro:mme6oh">
                  <label for="name" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/events-page.astro:mtjzj5">Your Name *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="e.g. Jane Doe"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
                <div data-ps="src/pages/events-page.astro:mme6og">
                  <label for="organization" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/events-page.astro:mtjzj4">Organization / Group</label>
                  <input
                    type="text"
                    id="organization"
                    name="organization"
                    placeholder="e.g. School District, Company, Healthcare"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/events-page.astro:mme6of">
                <div data-ps="src/pages/events-page.astro:mme6oe">
                  <label for="email" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/events-page.astro:mtjzj3">Email Address *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="you@example.com"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
                <div data-ps="src/pages/events-page.astro:mme6od">
                  <label for="phone" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/events-page.astro:mtjzj2">Phone Number *</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="484-000-0000"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/events-page.astro:mme6oc">
                <div data-ps="src/pages/events-page.astro:mme6ob">
                  <label for="program" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/events-page.astro:mtjzig">Program of Interest</label>
                  <select
                    id="program"
                    name="program"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  >
                    <option value="Heartsaver First Aid">Heartsaver First Aid</option>
                    <option value="Heartsaver CPR AED">Heartsaver CPR AED</option>
                    <option value="Friends & Family CPR">Friends & Family CPR</option>
                    <option value="BLS for Healthcare Providers">BLS for Healthcare Providers</option>
                    <option value="Pediatric First Aid">Pediatric First Aid</option>
                    <option value="Bloodborne Pathogen Training">Bloodborne Pathogen Training</option>
                    <option value="Fire Extinguisher Training">Fire Extinguisher Training</option>
                    <option value="PennDOT Flagger Certification">PennDOT Flagger Certification</option>
                    <option value="Red Cross CPR & First Aid">Red Cross CPR & First Aid</option>
                    <option value="Custom Group / Facility Training">Custom Group / Facility Training</option>
                  </select>
                </div>
                <div data-ps="src/pages/events-page.astro:mme6oa">
                  <label for="group-size" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/events-page.astro:mtjzif">Estimated Group Size</label>
                  <input
                    type="text"
                    id="group-size"
                    name="groupSize"
                    placeholder="e.g. Individual or 5-20 participants"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
              </div>

              <div data-ps="src/pages/events-page.astro:mme6o9">
                <label for="message" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/events-page.astro:mtjzie">Preferred Dates / Location / Details</label>
                <textarea
                  id="message"
                  name="message"
                  rows="3"
                  placeholder="Let us know your preferred dates, training location preference (on-site vs Hamburg training center), or specific certification requirements..."
                  class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary resize-none"
                ></textarea>
              </div>

              <!-- Invisible Captcha Protection Widget -->
              <altcha-widget challenge="/psapi-internal-v1/altcha/challenge" display="invisible" auto="onfocus"></altcha-widget>

              <button
                type="submit"
                id="events-submit-btn"
                class="w-full py-3.5 px-6 rounded-md bg-primary text-primary-foreground font-bold text-base hover:bg-primary-hover transition-colors shadow-sm cursor-pointer"
                data-ps="src/pages/events-page.astro:submit-btn"
              >
                Submit Event &amp; Schedule Inquiry
              </button>

              <div id="events-form-status" class="hidden text-sm font-semibold p-3 rounded-md mt-2 text-center" data-ps="src/pages/events-page.astro:form-status"></div>
            </form>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <script>
    import 'altcha';

    const eventsForm = document.getElementById('events-inquiry-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('events-form-status');
    const submitBtn = document.getElementById('events-submit-btn') as HTMLButtonElement | null;

    eventsForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!statusEl || !submitBtn) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
      statusEl.className = 'hidden';

      const formData = new FormData(eventsForm);
      const payload = {
        _formId: formData.get('_formId') || 'events-inquiry',
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        organization: formData.get('organization'),
        program: formData.get('program'),
        groupSize: formData.get('groupSize'),
        message: formData.get('message'),
        altcha: formData.get('altcha'),
        subject: 'Events & Schedule Inquiry - Eastern PA Educators',
      };

      try {
        const res = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await res.json();

        if (res.ok && result.success !== false) {
          statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-green-100 text-green-800 border border-green-200';
          statusEl.textContent = 'Thank you! Your event inquiry has been sent. We will contact you promptly.';
          eventsForm.reset();
        } else {
          throw new Error(result.error || 'Submission failed');
        }
      } catch (err) {
        statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-red-100 text-red-800 border border-red-200';
        statusEl.textContent = err instanceof Error ? err.message : 'Submission error. Please call us directly at 484-334-3577.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Event & Schedule Inquiry';
      }
    });
  </script>
</BaseLayout>
