  <script>
    import 'altcha';

    const quoteForm = document.getElementById('schuylkill-quote-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('schuylkill-form-status');
    const submitBtn = document.getElementById('schuylkill-submit-btn') as HTMLButtonElement | null;

    quoteForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!statusEl || !submitBtn) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
      statusEl.className = 'hidden';

      const formData = new FormData(quoteForm);
      const payload = {
        _formId: formData.get('_formId') || 'schuylkill-county-quote',
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        organization: formData.get('organization'),
        program: formData.get('program'),
        groupSize: formData.get('groupSize'),
        message: formData.get('message'),
        altcha: formData.get('altcha'),
        subject: 'New Schuylkill County CPR / First Aid Training Quote Request - Eastern PA Educators',
      };

      try {
        const res = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-green-100 text-green-800 border border-green-200';
          statusEl.textContent = 'Thank you! Your quote request has been sent. Our team will contact you promptly.';
          quoteForm.reset();
        } else {
          throw new Error('Submission failed');
        }
      } catch (err) {
        statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-red-100 text-red-800 border border-red-200';
        statusEl.textContent = 'Submission error. Please call us directly at 484-334-3577.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Quote Request';
      }
    });
  </script>
