---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const pageTitle = "Schuylkill County CPR & First Aid Courses | Eastern PA Educators";
const pageDescription = "Our instructors are proud to provide educational first aid classes, training & workshops to Pottsville, Tamaqua, Orwigsburg & all of Schuylkill County PA.";
const canonicalUrl = "https://www.easternpaeducators.com/schuylkill-county-cpr-first-aid-courses/";
---

<BaseLayout headerVariant="solid"
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Schuylkill County CPR & First Aid Courses',
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
    areaServed: {
      '@type': 'AdministrativeArea',
      name: 'Schuylkill County, Pennsylvania',
    },
    description: pageDescription,
  }}
>
  <!-- 1. Hero Banner Section -->
  <section class="relative bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:hero-sec">
    <div class="relative w-full h-[220px] md:h-[280px] lg:h-[320px]" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kby">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="Schuylkill County CPR Teachers Demonstrating Proper CPR Technique"
        class="w-full h-full object-cover object-center brightness-60"
        loading="eager"
        width="1920"
        height="320" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:x6hoo8" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background via-dark-background/60 to-transparent flex items-center justify-center" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kbx">
        <Container class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white uppercase drop-shadow-md" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:iufwff">
            Schuylkill County First Aid &amp; CPR Training
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Main Curriculum & Overview Section -->
  <section class="py-12 md:py-20 bg-background text-foreground" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:overview-sec">
    <Container>
      <!-- Sub-heading Bar -->
      <div class="mb-10 text-center" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kbw">
        <span class="inline-block px-4 py-1.5 rounded bg-primary/10 text-primary font-bold text-xs uppercase tracking-widest mb-3" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c7267">
          Certified Regional Education
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight uppercase text-foreground" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:460z76">
          FIRST AID, AED, CPR, &amp; EDUCATIONAL CLASSES IN SCHUYLKILL COUNTY PA
        </h2>
        <div class="w-20 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kbv"></div>
      </div>

      <!-- Video / Media Showcase + Introductory Text -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-16" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kbu">
        <!-- Media / Video Poster Card (5 Cols) -->
        <div class="lg:col-span-5 relative group rounded-2xl overflow-hidden shadow-lg border border-border bg-dark-background" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kbt">
          <div class="relative aspect-video" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kbs">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/63861c_e045c4fbd32242aebf8d84d0fa599553f000-0a755b-320.webp"
              alt="cpr certification classes in pa - first aid training king of prussia pa red cross"
              class="w-full h-full object-cover"
              loading="lazy"
              width="526"
              height="294" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:x6hoo7" />
            <div class="absolute inset-0 bg-black/30 flex items-center justify-center transition-all duration-300 group-hover:bg-black/40" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kbr">
              <a
                href={`tel:${SITE.phone}`}
                class="w-16 h-16 rounded-full bg-primary/90 hover:bg-primary text-primary-foreground flex items-center justify-center shadow-2xl transition-transform transform group-hover:scale-110"
                aria-label="Call for class schedules"
               data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:q4hnc9">
                <svg class="w-8 h-8 fill-current ml-1" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </a>
            </div>
          </div>
          <div class="p-4 bg-dark-background text-dark-foreground text-xs font-semibold flex items-center justify-between" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kbq">
            <span class="flex items-center gap-2" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c7268">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c7269"></span>
              On-Site &amp; Class Training
            </span>
            <span class="text-dark-muted-foreground" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c726a">Schuylkill County, PA</span>
          </div>
        </div>

        <!-- Introductory Lead Copy (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col justify-center" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kb4">
          <p class="text-base sm:text-lg text-foreground/90 leading-relaxed mb-4 font-medium" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:xfcnkb">
            Eastern PA Educators is the go-to provider for CPR and first aid training in towns throughout Schuylkill County, PA including Pottsville, Tamaqua, Hometown, Orwigsburg, Coaldale, St. Clair, Port Clinton, McAdoo, New Ringgold, Minersville, Frackville, Schuylkill Haven, Lake Wynonah, Tower City, Valley View, Shenandoah, Tuscarora, Friedensburg, Mahanoy City, Pine Grove, Tremont, Blythe Township, West Penn Township, and surrounding communities.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed mb-4" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:xfcnka">
            Our instructors offer training for everyone, teachers, childcare workers, healthcare staff, or anyone who wants to learn how to save lives. Our courses give you the skills and confidence to act in emergencies when it matters most.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed mb-6" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:xfcnk9">
            We know how important lifesaving skills are. Emergencies can happen anytime, anywhere. Knowing how to perform CPR, give first aid, or use an AED can make all the difference. Our training helps you take quick, effective action when needed.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kb3">
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kb2">
              <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:aidy0j">
                <span class="w-2 h-2 rounded-full bg-primary shrink-0" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c726b"></span>
                Lifesaving Readiness
              </h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:xfcnk8">
                Empowering teachers, healthcare workers, childcare staff, and individuals with confidence to act in emergencies.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kb1">
              <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:aidy0i">
                <span class="w-2 h-2 rounded-full bg-primary shrink-0" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c726c"></span>
                Emergency Confidence
              </h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:xfcnk7">
                Action-oriented instruction for cardiac arrest, airway obstruction, and rapid emergency intervention.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Core Differentiators Breakdown (4 Points) -->
      <div class="mb-16" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kb0">
        <div class="text-center max-w-2xl mx-auto mb-10" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kaz">
          <h3 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight mb-3" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:aidy0h">
            Why Choose Eastern PA Educators?
          </h3>
          <p class="text-sm text-muted-foreground" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:xfcnk6">
            Trusted certified instructors delivering high-impact life safety training with realistic equipment.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kay">
          <!-- Card 1 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kax">
            <div data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kaw">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8kav">
                01
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:p6sv8s">1. Hands-On Practice</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:xfcnk5">
                We focus on learning by doing. You’ll practice CPR on manikins and learn how to use an AED, so you’re ready to handle real emergencies.
              </p>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka9">
            <div data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka8">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka7">
                02
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:p6sv8r">2. Experienced Instructors</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:xfcnk4">
                Our certified trainers have years of real-life emergency experience. They’ll teach you the skills you need and how to handle unexpected situations with confidence.
              </p>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka6">
            <div data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka5">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka4">
                03
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:p6sv85">3. Flexible Scheduling</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:xfcnk3">
                We know life gets busy. That’s why we offer evening, weekend, and group sessions to fit your schedule.
              </p>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka3">
            <div data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka2">
              <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka1">
                04
              </div>
              <h4 class="text-lg font-bold text-foreground mb-2" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:p6sv84">4. Approved Certifications</h4>
              <p class="text-sm text-muted-foreground leading-relaxed" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:5nsjny">
                Our courses meet Pennsylvania state rules and are accepted by employers, schools, hospitals, and childcare centers. With certifications from the American Heart Association (AHA) and the American Red Cross, you can trust you’re getting top-quality training.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 p-6 rounded-xl bg-amber-subtle border border-amber-200/80 text-foreground text-center max-w-4xl mx-auto" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8ka0">
          <p class="text-sm sm:text-base leading-relaxed font-medium m-0" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:5nsjnx">
            At Eastern PA Educators, our mission is to provide you with the critical skills and confidence needed to act fast in emergencies. When seconds count, our certified instructors make sure you are prepared to save lives.
          </p>
        </div>
      </div>

      <!-- Official Accreditation Logos Strip -->
      <div class="border-t border-border pt-10" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k9e">
        <p class="text-center text-xs font-bold text-muted-foreground uppercase tracking-widest mb-8" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:5nsjnw">
          Nationally Recognized Training Standards &amp; Certifications
        </p>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k9d">
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k9c">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/american_heart_association_logo-8fc04c-122.webp"
              alt="AHA Logo"
              class="max-h-12 w-auto object-contain"
              width="122"
              height="60" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:x6hoo6" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k9b">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc~-824966-114.webp"
              alt="American Red Cross Logo"
              class="max-h-12 w-auto object-contain"
              width="114"
              height="112" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:x6hoo5" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k9a">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/osha-logo-dceaa1-100.webp"
              alt="OSHA Logo"
              class="max-h-8 w-auto object-contain"
              width="100"
              height="29" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:x6hoo4" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k99">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/ashi-approved-training-center-logo-799753-67.webp"
              alt="ASHI Approved Training Center Logo"
              class="max-h-12 w-auto object-contain"
              width="67"
              height="70" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:x6hoo3" />
          </div>
          <div class="flex items-center justify-center p-3 rounded-xl bg-white border border-border shadow-sm h-20 w-36" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k98">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/nfpa-member-logo-31BDF5EC99-seeklogo_com-dec389-79.webp"
              alt="NFPA Member Logo"
              class="max-h-12 w-auto object-contain"
              width="79"
              height="90" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:x6hoo2" />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. Schuylkill County First Aid Classes & Workshops Details -->
  <section class="py-12 md:py-20 bg-surface border-y border-border" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:courses-sec">
    <Container>
      <div class="max-w-4xl mx-auto" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k97">
        <!-- Prominent Program Frame -->
        <div class="p-8 sm:p-10 rounded-2xl bg-background border-2 border-primary shadow-lg" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k96">
          <span class="inline-block px-3 py-1 rounded bg-primary text-primary-foreground font-bold text-xs uppercase tracking-wider mb-4" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c726d">
            Comprehensive Course Offerings
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight mb-4" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:460z77">
            CPR &amp; First Aid Training in Pottsville, Orwigsburg, Tamaqua, Minersville, Frackville, Coaldale, Hometown, &amp; Throughout Schuylkill County PA
          </h2>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:5nsjnv">
            We provide customized certification courses for businesses, community groups, and organizations. Our training, approved by the American Heart Association and Red Cross, is top-quality and easy to follow. Whether you're a healthcare worker or a first-timer, our courses, including AHA and BLS, cover what you need to know to save lives.
          </p>

          <h3 class="text-xl font-bold text-foreground mb-6 pb-2 border-b border-border" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:aidy0g">
            Our Schuylkill County First Aid Programs:
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:uo8k95">
            <a
              href="/heartsaver-first-aid"
              class="flex items-center gap-3 p-4 rounded-xl bg-surface border border-border hover:border-primary hover:bg-amber-subtle/30 transition-all no-underline text-foreground font-semibold group"
             data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:q4hnc8">
              <span class="w-8 h-8 rounded-full bg-primary/20 text-foreground flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c726e">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c7270">Heartsaver First Aid</span>
            </a>

            <a
              href="/heartsaver-cpr-aed"
              class="flex items-center gap-3 p-4 rounded-xl bg-surface border border-border hover:border-primary hover:bg-amber-subtle/30 transition-all no-underline text-foreground font-semibold group"
             data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:q4hnc7">
              <span class="w-8 h-8 rounded-full bg-primary/20 text-foreground flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c7271">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span data-ps="src/pages/schuylkill-county-cpr-first-aid-courses.astro:2c7272">Heartsaver CPR/AED</span>
            </a>

