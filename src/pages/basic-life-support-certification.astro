  <script>
    import 'altcha';

    // Main Contact Quote Form Handler
    const quoteForm = document.getElementById('contact-quote-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('quote-form-status');
    const submitBtn = document.getElementById('submit-quote-btn') as HTMLButtonElement | null;

    quoteForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!statusEl || !submitBtn) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      statusEl.className = 'hidden';

      const formData = new FormData(quoteForm);
      const payload = {
        _formId: formData.get('_formId') || 'bls-quote',
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        organization: formData.get('organization'),
        program: formData.get('program'),
        groupSize: formData.get('groupSize'),
        message: formData.get('message'),
        altcha: formData.get('altcha'),
        subject: 'BLS for Healthcare Providers Quote Request - Eastern PA Educators',
      };

      try {
        const res = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await res.json();

        if (res.ok && result.success !== false) {
          statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-green-100 text-green-800 border border-green-200';
          statusEl.textContent = 'Thanks for submitting! We will contact you promptly.';
          quoteForm.reset();
        } else {
          throw new Error(result.error || 'Submission failed');
        }
      } catch (err) {
        statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-red-100 text-red-800 border border-red-200';
        statusEl.textContent = err instanceof Error ? err.message : 'Submission error. Please call us directly at 484-334-3577.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Get In Touch';
      }
    });

    // Newsletter Form Handler
    const newsForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const newsStatusEl = document.getElementById('newsletter-status');
    const newsSubmitBtn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement | null;

    newsForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!newsStatusEl || !newsSubmitBtn) return;

      newsSubmitBtn.disabled = true;
      newsSubmitBtn.textContent = '...';
      newsStatusEl.className = 'hidden';

      const formData = new FormData(newsForm);
      const payload = {
        _formId: formData.get('_formId') || 'newsletter-signup',
        email: formData.get('email'),
        subject: 'Newsletter Signup - Eastern PA Educators',
      };

      try {
        const res = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await res.json();

        if (res.ok && result.success !== false) {
          newsStatusEl.className = 'block text-xs font-semibold p-2 rounded text-center bg-green-100 text-green-800 border border-green-200';
          newsStatusEl.textContent = 'Thanks for submitting!';
          newsForm.reset();
        } else {
          throw new Error(result.error || 'Submission failed');
        }
      } catch (err) {
        newsStatusEl.className = 'block text-xs font-semibold p-2 rounded text-center bg-red-100 text-red-800 border border-red-200';
        newsStatusEl.textContent = 'Error subscribing. Please try again.';
      } finally {
        newsSubmitBtn.disabled = false;
        newsSubmitBtn.textContent = 'Submit';
      }
    });
  </script>
</BaseLayout>
