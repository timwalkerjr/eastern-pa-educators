---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'BLS Courses for Healthcare Providers | Eastern PA Educators';
const description = 'Our basic life support certification, training & courses teach vital first-aid skills to medical professionals. Join our BLS for healthcare providers class today!';
const canonicalUrl = 'https://www.easternpaeducators.com/basic-life-support-certification/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'BLS for Healthcare Providers',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/basic-life-support-certification.astro:hero-sec">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/basic-life-support-certification.astro:hero-wrap">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="cpr certification PA - first aid certification training ready response bucks county pa"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="420"
        data-ps="src/pages/basic-life-support-certification.astro:hero-img"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/basic-life-support-certification.astro:hero-overlay"></div>

      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/basic-life-support-certification.astro:hero-content">
        <Container>
          <div class="inline-block px-4 py-1.5 rounded bg-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-3 border border-primary/30" data-ps="src/pages/basic-life-support-certification.astro:hero-badge">
            Professional Life-Saving Certification
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/basic-life-support-certification.astro:hero-h1">
            BLS for Healthcare Providers
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Introduction: Basic Life Support Training -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/basic-life-support-certification.astro:intro-sec">
    <Container class="max-w-4xl text-center">
      <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/basic-life-support-certification.astro:intro-badge">
        Clinical Life-Support Standards
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-6 uppercase" data-ps="src/pages/basic-life-support-certification.astro:intro-h2">
        Basic Life Support Training
      </h2>
      <div class="w-16 h-1 bg-primary mx-auto mb-8 rounded-full" data-ps="src/pages/basic-life-support-certification.astro:intro-cadence"></div>
      <div class="p-6 sm:p-8 md:p-10 rounded-2xl bg-surface border border-border shadow-sm text-left sm:text-center space-y-4" data-ps="src/pages/basic-life-support-certification.astro:intro-card">
        <p class="text-base sm:text-lg text-foreground/90 leading-relaxed font-medium m-0" data-ps="src/pages/basic-life-support-certification.astro:intro-p">
          Our Basic Life Support (BLS) programs for healthcare providers are designed to equip participants with essential life-saving techniques and expertise. These courses are structured to cultivate both the confidence and proficiency required to act decisively in high-pressure, critical medical emergencies. Participants will gain hands-on experience with CPR, the use of an automated external defibrillator (AED), and other crucial interventions, ensuring they are prepared to respond effectively in various emergencies. By engaging in our program, participants not only enhance their skill set but also reinforce their capability to positively impact patient outcomes.
        </p>
      </div>
    </Container>
  </section>

  <!-- 3. What Our BLS Courses Will Teach You Section (Amber Accent) -->
  <section class="py-14 md:py-20 bg-primary text-primary-foreground border-y border-amber-500/30" data-ps="src/pages/basic-life-support-certification.astro:teach-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/basic-life-support-certification.astro:teach-header">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary-foreground font-heading tracking-tight uppercase" data-ps="src/pages/basic-life-support-certification.astro:teach-h2">
          What Our BLS Courses Will Teach You
        </h2>
        <div class="w-16 h-1 bg-black mx-auto mt-4 rounded-full" data-ps="src/pages/basic-life-support-certification.astro:teach-line"></div>
        <p class="text-base sm:text-lg font-medium text-primary-foreground/90 mt-4 max-w-2xl mx-auto" data-ps="src/pages/basic-life-support-certification.astro:teach-intro">
          Our BLS courses cover a range of topics and techniques that are crucial in life-threatening situations. Some of the key skills you will learn include:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/basic-life-support-certification.astro:teach-grid">
        <!-- 1. CPR for adults, children, and infants -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/basic-life-support-certification.astro:teach-card-1">
          <div data-ps="src/pages/basic-life-support-certification.astro:k6j8nm">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/basic-life-support-certification.astro:teach-icon-1">
              01
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:teach-title-1">
              High-Quality CPR
            </h3>
            <p class="text-sm text-neutral-300 leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:teach-desc-1">
              CPR for adults, children, and infants with proper compression depth and rate.
            </p>
          </div>
        </div>

        <!-- 2. Use of an AED -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/basic-life-support-certification.astro:teach-card-2">
          <div data-ps="src/pages/basic-life-support-certification.astro:k6j8n0">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/basic-life-support-certification.astro:teach-icon-2">
              02
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:teach-title-2">
              Automated External Defibrillator
            </h3>
            <p class="text-sm text-neutral-300 leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:teach-desc-2">
              Use of an automated external defibrillator (AED) in rapid defibrillation protocols.
            </p>
          </div>
        </div>

        <!-- 3. Choking Relief -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/basic-life-support-certification.astro:teach-card-3">
          <div data-ps="src/pages/basic-life-support-certification.astro:k6j8mz">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/basic-life-support-certification.astro:teach-icon-3">
              03
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:teach-title-3">
              Choking Interventions
            </h3>
            <p class="text-sm text-neutral-300 leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:teach-desc-3">
              Techniques for relieving choking in conscious and unconscious individuals.
            </p>
          </div>
        </div>

        <!-- 4. Emergency Management -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/basic-life-support-certification.astro:teach-card-4">
          <div data-ps="src/pages/basic-life-support-certification.astro:k6j8my">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/basic-life-support-certification.astro:teach-icon-4">
              04
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:teach-title-4">
              Respiratory &amp; Cardiac Crises
            </h3>
            <p class="text-sm text-neutral-300 leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:teach-desc-4">
              Management of respiratory and cardiac emergencies in various healthcare settings.
            </p>
          </div>
        </div>

        <!-- 5. Team Dynamics -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between md:col-span-2 lg:col-span-2" data-ps="src/pages/basic-life-support-certification.astro:teach-card-5">
          <div data-ps="src/pages/basic-life-support-certification.astro:k6j8mx">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/basic-life-support-certification.astro:teach-icon-5">
              05
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:teach-title-5">
              Team Dynamics &amp; Multi-Rescuer Coordination
            </h3>
            <p class="text-sm text-neutral-300 leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:teach-desc-5">
              Team dynamics and communication during resuscitation efforts to optimize critical clinical workflows.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. Who Our Basic Life Support Classes Can Help Section (Dark Obsidian) -->
  <section class="py-14 md:py-20 bg-dark-background text-dark-foreground border-b border-dark-border" data-ps="src/pages/basic-life-support-certification.astro:who-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/basic-life-support-certification.astro:who-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle/10 text-primary text-xs font-bold uppercase tracking-wider mb-3 border border-primary/20" data-ps="src/pages/basic-life-support-certification.astro:who-badge">
          Target Professionals
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/basic-life-support-certification.astro:who-h2">
          Who Our Basic Life Support Classes Can Help
        </h2>
        <p class="text-base sm:text-lg text-dark-muted-foreground mt-4 max-w-2xl mx-auto" data-ps="src/pages/basic-life-support-certification.astro:who-intro">
          Our BLS courses are meticulously crafted for a wide range of individuals who prioritize preparedness in emergency situations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/basic-life-support-certification.astro:who-grid">
        <!-- 1. Healthcare Providers -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/basic-life-support-certification.astro:who-card-1">
          <div class="flex items-start gap-4" data-ps="src/pages/basic-life-support-certification.astro:k6j8mw">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/basic-life-support-certification.astro:who-icon-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div data-ps="src/pages/basic-life-support-certification.astro:k6j8mv">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:who-title-1">
                Healthcare Providers
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:who-desc-1">
                Whether you're a nurse, doctor, or other healthcare professional, our courses will help you enhance your competency in life-saving techniques essential in clinical settings. By keeping your skills sharp, you ensure optimal patient care and responsiveness during critical situations.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. First Responders -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/basic-life-support-certification.astro:who-card-2">
          <div class="flex items-start gap-4" data-ps="src/pages/basic-life-support-certification.astro:k6j8mu">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/basic-life-support-certification.astro:who-icon-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div data-ps="src/pages/basic-life-support-certification.astro:k6j8mt">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:who-title-2">
                First Responders
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:who-desc-2">
                As the first on the scene, you're equipped to make life-or-death decisions. Our program arms you with robust skills to confidently deliver prompt and effective care, significantly improving patient outcomes.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Medical Students -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/basic-life-support-certification.astro:who-card-3">
          <div class="flex items-start gap-4" data-ps="src/pages/basic-life-support-certification.astro:k6j8ms">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/basic-life-support-certification.astro:who-icon-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <div data-ps="src/pages/basic-life-support-certification.astro:k6j8mr">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:who-title-3">
                Medical Students
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:who-desc-3">
                Establish a strong foundation in basic life support early in your medical career. Our courses provide you with the fundamental skills and knowledge that will be crucial as you advance into more complex medical training and practice.
              </p>
            </div>
          </div>
        </div>

        <!-- 4. Individuals Seeking BLS Certification -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/basic-life-support-certification.astro:who-card-4">
          <div class="flex items-start gap-4" data-ps="src/pages/basic-life-support-certification.astro:hogom3">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/basic-life-support-certification.astro:who-icon-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div data-ps="src/pages/basic-life-support-certification.astro:hogom4">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:who-title-4">
                Individuals Seeking BLS Certification
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:who-desc-4">
                For those needing certification for professional requirements or personal development, our courses offer comprehensive training that meets industry standards. Not only will you fulfill your certification goals, but you'll also gain confidence in your ability to respond in emergency scenarios.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 5. Benefits of BLS Certification Section -->
  <section class="py-14 md:py-20 bg-surface border-b border-border" data-ps="src/pages/basic-life-support-certification.astro:benefits-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/basic-life-support-certification.astro:benefits-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/basic-life-support-certification.astro:benefits-badge">
          Core Advantages
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/basic-life-support-certification.astro:benefits-h2">
          Benefits of BLS Certification
        </h2>
        <div class="w-16 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/basic-life-support-certification.astro:benefits-line"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/basic-life-support-certification.astro:benefits-grid">
        <!-- 1. Confidence in Emergencies -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/basic-life-support-certification.astro:benefit-card-1">
          <div class="flex items-start gap-4" data-ps="src/pages/basic-life-support-certification.astro:hogom5">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/basic-life-support-certification.astro:benefit-icon-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div data-ps="src/pages/basic-life-support-certification.astro:hogom6">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:benefit-title-1">
                Confidence in Emergencies
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:benefit-desc-1">
                A BLS certification equips you with the essential knowledge and practical skills to respond swiftly and effectively in life-threatening situations, such as cardiac arrest or choking incidents. This confidence allows you to act decisively when every second counts, potentially saving lives.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Career Advancement -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/basic-life-support-certification.astro:benefit-card-2">
          <div class="flex items-start gap-4" data-ps="src/pages/basic-life-support-certification.astro:hogom7">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/basic-life-support-certification.astro:benefit-icon-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div data-ps="src/pages/basic-life-support-certification.astro:hogom8">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/basic-life-support-certification.astro:benefit-title-2">
                Career Advancement
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/basic-life-support-certification.astro:benefit-desc-2">
                Adding BLS certification to your list of professional qualifications can open doors to new job opportunities and promotions, especially in healthcare and emergency services. It demonstrates to employers your commitment to maintaining essential skills and your readiness to handle critical situations.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Community Impact -->
