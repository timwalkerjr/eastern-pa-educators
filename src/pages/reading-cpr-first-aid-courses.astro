---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'CPR & First Aid Training in Reading PA | Eastern PA Educators';
const description = 'The first aid instructors at Eastern PA Educators provide various trainings, workshops, certifications & educational resources to Reading Pennsylvania.';
const canonicalUrl = 'https://www.easternpaeducators.com/reading-cpr-first-aid-courses/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Reading CPR & First Aid Training',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
    areaServed: {
      '@type': 'City',
      name: 'Reading, Pennsylvania',
    },
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/reading-cpr-first-aid-courses.astro:dxmgm8">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphxg">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-ef182d-1536.webp"
        alt="Reading CPR Teachers Demonstrating Proper CPR Technique"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1905"
        height="250" data-ps="src/pages/reading-cpr-first-aid-courses.astro:chym9u" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphxf"></div>

      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphxe">
        <Container>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/reading-cpr-first-aid-courses.astro:uebc0h">
            First Aid Training &amp; CPR Courses in Reading PA
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Regional Education Overview & 4 Key Benefits -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/reading-cpr-first-aid-courses.astro:dxmgm9">
    <Container class="max-w-6xl">
      <!-- Badge + Heading -->
      <div class="text-center mb-12" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphws">
        <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jum">
          Certified Regional Education
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground tracking-tight font-heading uppercase" data-ps="src/pages/reading-cpr-first-aid-courses.astro:fpwesu">
          ABOUT EASTERN PA EDUCATORS, READING PENNSYLVANIA'S PREMIER FIRST AID CLASSES, COURSES, &amp; WORKSHOPS
        </h2>
      </div>

      <!-- Top Row: Video/Thumbnail Left (6 Cols) + Content Right (6 Cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-16" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphwr">
        <!-- Media Block -->
        <div class="lg:col-span-6" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphwq">
          <div class="relative rounded-2xl overflow-hidden border border-border shadow-xl bg-dark-background aspect-[16/10] group" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphwp">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/63861c_e045c4fbd32242aebf8d84d0fa599553f000-0a755b-320.webp"
              alt="cpr certification classes in pa - first aid training king of prussia pa red cross"
              class="w-full h-full object-cover brightness-90 group-hover:scale-105 transition-transform duration-500"
              width="526"
              height="294"
              loading="lazy" data-ps="src/pages/reading-cpr-first-aid-courses.astro:chym9t" />
            <div class="absolute inset-0 bg-dark-background/40 flex items-center justify-center" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphwo">
              <a
                href={`tel:${SITE.phone}`}
                class="w-16 h-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center shadow-lg transition-transform group-hover:scale-110"
                aria-label="Call for Reading CPR training details"
               data-ps="src/pages/reading-cpr-first-aid-courses.astro:k2oaxk">
                <svg class="w-8 h-8 ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </a>
            </div>
            <div class="absolute bottom-0 inset-x-0 bg-dark-background/90 backdrop-blur-sm px-4 py-2.5 flex items-center justify-between text-xs text-dark-muted-foreground border-t border-dark-border" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphwn">
              <span class="inline-flex items-center gap-1.5 font-medium text-dark-foreground" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jul">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3juk"></span>
                On-Site &amp; Class Training
              </span>
              <span data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jty">Reading, PA</span>
            </div>
          </div>
        </div>

        <!-- Editorial Text -->
        <div class="lg:col-span-6 space-y-4" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphwm">
          <p class="text-base sm:text-lg text-foreground/90 leading-relaxed" data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtapk">
            Welcome to Eastern PA Educators, your trusted source for CPR and first aid certification in the Reading PA area. Every day, situations arise where first aid skills can make a life-saving difference. From choking incidents at family dinners to falls at work, or car accidents on the road, emergencies can happen anywhere, anytime.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed" data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtapl">
            Our training programs are tailored for teachers, childcare providers, healthcare workers, and anyone who wants to be prepared for the unexpected. At Eastern PA Educators, we’re here to equip you with the skills and confidence to respond effectively to real-life situations. Whether it’s performing CPR, stabilizing an injury, or assisting someone in distress, your knowledge can turn a critical moment into a lifesaving one. Let us help you be ready to act when it matters most.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphwl">
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphwk">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphwj">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jtx"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jtw">Critical Preparation</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtapm">
                Tailored for educators, childcare staff, healthcare workers, and local businesses in Reading.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvx">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvw">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jtv"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jtu">Life-Saving Readiness</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtapn">
                Practical, scenario-driven instruction on AEDs, EpiPens, and high-fidelity manikins.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Why Choose Section -->
      <div class="text-center mb-10 pt-6 border-t border-border" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvv">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-foreground font-heading tracking-tight mb-2" data-ps="src/pages/reading-cpr-first-aid-courses.astro:11hhkm">
          4 Reasons Why Our First Aid &amp; CPR Training is Reading's Best
        </h3>
        <p class="text-sm text-muted-foreground" data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtaq9">
          Trusted certified instructors delivering high-impact life safety training with realistic equipment.
        </p>
      </div>

      <!-- 4 Numbered Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvu">
        <!-- 01 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvt">
          <div data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvs">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jtt">
              01
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/reading-cpr-first-aid-courses.astro:dmxfn3">1. Experienced Trainers</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtaqa">
              Learn from certified, highly skilled instructors with years of hands-on experience in real-life emergencies. They combine technical expertise with practical insights, ensuring you're prepared to handle any situation. Our trainers also demonstrate the use of essential first aid equipment, such as AEDs (automated external defibrillators), EpiPens, and more.
            </p>
          </div>
        </div>

        <!-- 02 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvr">
          <div data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvq">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jts">
              02
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/reading-cpr-first-aid-courses.astro:dmxfn2">2. Hands-On Learning with the Latest Tools</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtaqb">
              Practice makes perfect. That’s why our courses emphasize interactive, hands-on training using the latest first aid technologies and supplies. From practicing CPR on high-quality manikins to learning proper bandaging techniques, you’ll gain practical skills and confidence to respond in emergencies.
            </p>
          </div>
        </div>

        <!-- 03 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvp">
          <div data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphvo">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jtr">
              03
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/reading-cpr-first-aid-courses.astro:dmxfn1">3. State &amp; Employer Approved Courses</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtaqc">
              Our certifications meet Pennsylvania state requirements and are recognized by employers, schools, childcare organizations, and healthcare facilities. You’ll leave with the credentials you need, backed by training on industry-standard first aid supplies and tools.
            </p>
          </div>
        </div>

        <!-- 04 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphv2">
          <div data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphv1">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jtq">
              04
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/reading-cpr-first-aid-courses.astro:dmxfn0">4. Flexible Scheduling</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtaqd">
              We know life gets busy. That’s why we offer classes to fit your schedule, including evenings, weekends, and customized group sessions. Whether you're an individual learner or part of a team, we’ve got options tailored to your needs.
            </p>
          </div>
        </div>
      </div>

      <!-- Accreditation Row -->
      <div class="text-center pt-6 border-t border-border" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphv0">
        <span class="block text-xs uppercase tracking-widest text-muted-foreground font-bold mb-6" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jtp">
          Nationally Recognized Training Standards &amp; Certifications
        </span>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphuz">
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphuy">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/american_heart_association_logo-8fc04c-122.webp"
              alt="AHA Logo"
              class="h-10 w-auto object-contain"
              width="122"
              height="60"
              loading="lazy" data-ps="src/pages/reading-cpr-first-aid-courses.astro:chym9s" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphux">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc~-824966-114.webp"
              alt="Red Cross Logo"
              class="h-10 w-auto object-contain"
              width="114"
              height="112"
              loading="lazy" data-ps="src/pages/reading-cpr-first-aid-courses.astro:chym9r" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphuw">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/osha-logo-dceaa1-100.webp"
              alt="OSHA Logo"
              class="h-7 w-auto object-contain"
              width="100"
              height="29"
              loading="lazy" data-ps="src/pages/reading-cpr-first-aid-courses.astro:chym9q" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphuv">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/ashi-approved-training-center-logo-799753-67.webp"
              alt="ASHI Approved Training Center Logo"
              class="h-12 w-auto object-contain"
              width="67"
              height="70"
              loading="lazy" data-ps="src/pages/reading-cpr-first-aid-courses.astro:chym9p" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphuu">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/nfpa-member-logo-31BDF5EC99-seeklogo_com-dec389-79.webp"
              alt="NFPA Member Logo"
              class="h-12 w-auto object-contain"
              width="79"
              height="90"
              loading="lazy" data-ps="src/pages/reading-cpr-first-aid-courses.astro:chym93" />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. Comprehensive Course Offerings Card Container -->
  <section class="py-14 md:py-20 bg-surface text-foreground border-y border-border" data-ps="src/pages/reading-cpr-first-aid-courses.astro:dxmgma">
    <Container class="max-w-4xl">
      <div class="bg-background rounded-3xl border border-border shadow-xl overflow-hidden" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphut">
        <div class="p-8 sm:p-10 md:p-12" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphu7">
          <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jt3">
            Comprehensive Course Offerings
          </span>

          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground font-heading tracking-tight mb-4" data-ps="src/pages/reading-cpr-first-aid-courses.astro:fpwesv">
            CPR &amp; First Aid Training in Reading Pennsylvania
          </h2>

          <div class="space-y-4 text-sm sm:text-base text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphu6">
            <p data-ps="src/pages/reading-cpr-first-aid-courses.astro:crtaqe">
              Lifesaving skills should be accessible to everyone. That’s why we offer affordable, customized CPR, first aid, and AED certification training tailored to the unique needs of businesses, facilities, civic groups, and private organizations. Our programs are approved by the American Heart Association (AHA) and the American Red Cross, ensuring reliable, high-quality instruction for both healthcare professionals and lay rescuers.
            </p>
          </div>

          <!-- Courses Grid -->
          <div class="mb-8" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphu5">
            <h3 class="text-base font-bold text-foreground uppercase tracking-wider font-heading mb-4" data-ps="src/pages/reading-cpr-first-aid-courses.astro:11hhkn">
              Our Reading Pennyslvania First Aid Training Certifications:
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphu4">
              <a
                href="/heartsaver-first-aid"
                class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group"
               data-ps="src/pages/reading-cpr-first-aid-courses.astro:k2oaxl">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphu3">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jt2">Heartsaver First Aid</span>
              </a>

              <a
                href="/heartsaver-cpr-aed"
                class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group"
               data-ps="src/pages/reading-cpr-first-aid-courses.astro:k2oaxm">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphu2">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jt1">Heartsaver CPR AED</span>
              </a>

              <a
                href="/friends-family-cpr-certification"
                class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group"
               data-ps="src/pages/reading-cpr-first-aid-courses.astro:k2oaxn">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/reading-cpr-first-aid-courses.astro:9zphu1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/reading-cpr-first-aid-courses.astro:s3jt0">Friends &amp; Family CPR Certification</span>
              </a>

              <a
                href="/basic-life-support-certification"
