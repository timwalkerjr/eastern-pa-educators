---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'Heartsaver CPR AED Training Courses | Eastern PA Educators';
const description = 'Our Heartsaver CPR AED Training Course will help you master cardiopulmonary resuscitation techniques & the use of automated external defibrillators.';
const canonicalUrl = 'https://www.easternpaeducators.com/heartsaver-cpr-aed/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Heartsaver CPR AED Training',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/heartsaver-cpr-aed.astro:hero-sec">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/heartsaver-cpr-aed.astro:hero-wrap">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="cpr certification PA - first aid certification training ready response bucks county pa"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="420"
        data-ps="src/pages/heartsaver-cpr-aed.astro:hero-img"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/heartsaver-cpr-aed.astro:hero-overlay"></div>

      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/heartsaver-cpr-aed.astro:hero-content">
        <Container>
          <div class="inline-block px-4 py-1.5 rounded bg-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-3 border border-primary/30" data-ps="src/pages/heartsaver-cpr-aed.astro:hero-badge">
            AHA Certified Life-Saving Course
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/heartsaver-cpr-aed.astro:hero-h1">
            Heartsaver CPR AED Training
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Why Heartsaver CPR AED Training? Section -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/heartsaver-cpr-aed.astro:why-sec">
    <Container class="max-w-4xl text-center">
      <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/heartsaver-cpr-aed.astro:why-badge">
        Essential Emergency Skills
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-6 uppercase" data-ps="src/pages/heartsaver-cpr-aed.astro:why-h2">
        Why Heartsaver CPR AED Training?
      </h2>
      <div class="w-16 h-1 bg-primary mx-auto mb-8 rounded-full" data-ps="src/pages/heartsaver-cpr-aed.astro:why-cadence"></div>
      <p class="text-base sm:text-lg text-foreground/90 leading-relaxed font-medium max-w-3xl mx-auto" data-ps="src/pages/heartsaver-cpr-aed.astro:why-lead">
        Eastern PA Educators is proud to offer the Heartsaver CPR AED Training Course, designed to equip you with the essential skills needed to respond to cardiac emergencies. Whether you're a corporate employee, community member, or a concerned individual, our course provides practical knowledge and hands-on experience.
      </p>
    </Container>
  </section>

  <!-- 3. What Our Heartsaver CPR AED Class Will Teach You Section (Amber Accent) -->
  <section class="py-14 md:py-20 bg-primary text-primary-foreground border-y border-amber-500/30" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-header">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary-foreground font-heading tracking-tight uppercase" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-h2">
          What Our Heartsaver CPR AED Class Will Teach You
        </h2>
        <div class="w-16 h-1 bg-black mx-auto mt-4 rounded-full" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-line"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-grid">
        <!-- 1. CPR Techniques -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-card-1">
          <div data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj78">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-icon-1">
              01
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-title-1">
              CPR Techniques
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-desc-1">
              Master CPR techniques with clear, step-by-step instructions.
            </p>
          </div>
        </div>

        <!-- 2. AED Use -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-card-2">
          <div data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj79">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-icon-2">
              02
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-title-2">
              AED Use
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-desc-2">
              Get familiar with Automated External Defibrillators (AED) and learn how to operate them in emergency situations.
            </p>
          </div>
        </div>

        <!-- 3. Choking Relief -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-card-3">
          <div data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj7a">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-icon-3">
              03
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-title-3">
              Choking Relief
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-desc-3">
              Understand the proper methods to help someone who is choking.
            </p>
          </div>
        </div>

        <!-- 4. Critical Response -->
        <div class="bg-black/90 text-white rounded-2xl p-6 sm:p-8 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-card-4">
          <div data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj7b">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-icon-4">
              04
            </div>
            <h3 class="text-xl font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-title-4">
              Critical Response
            </h3>
            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:teach-desc-4">
              Gain confidence to act quickly and effectively during cardiac emergencies.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. Why Choose Us for Your Heartsaver CPR AED Course? Section (Dark Obsidian) -->
  <section class="py-14 md:py-20 bg-dark-background text-dark-foreground border-b border-dark-border" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle/10 text-primary text-xs font-bold uppercase tracking-wider mb-3 border border-primary/20" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-badge">
          Professional Pedigree
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-h2">
          Why Choose Us for Your Heartsaver CPR AED Course?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-grid">
        <!-- Benefit 1: Expert Instructors -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-card-1">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj7c">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-icon-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj7d">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-title-1">
                Expert Instructors
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-desc-1">
                Our experienced educators bring real-world knowledge and expertise to the classroom.
              </p>
            </div>
          </div>
        </div>

        <!-- Benefit 2: Interactive Learning -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-card-2">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj7e">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-icon-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj7f">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-title-2">
                Interactive Learning
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-desc-2">
                Engage in hands-on practice sessions to reinforce your learning.
              </p>
            </div>
          </div>
        </div>

        <!-- Benefit 3: Certification -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-card-3">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj7g">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-icon-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-cpr-aed.astro:d2uj7h">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-title-3">
                Certification
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-desc-3">
                Receive an American Heart Association Heartsaver CPR AED Certification upon successful completion of the course.
              </p>
            </div>
          </div>
        </div>

        <!-- Benefit 4: Convenient Scheduling -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-card-4">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-cpr-aed.astro:u7ixyj">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-icon-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-cpr-aed.astro:u7ixyk">
              <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-title-4">
                Convenient Scheduling
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:why-us-desc-4">
                Flexible course timings to fit into your busy schedule.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 5. Who Benefits the Most from Heartsave CPR AED Certification? Section -->
  <section class="py-14 md:py-20 bg-surface border-b border-border" data-ps="src/pages/heartsaver-cpr-aed.astro:who-sec">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/heartsaver-cpr-aed.astro:who-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/heartsaver-cpr-aed.astro:who-badge">
          Audience &amp; Participants
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/heartsaver-cpr-aed.astro:who-h2">
          Who Benefits the Most from Heartsave CPR AED Certification?
        </h2>
        <div class="w-16 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/heartsaver-cpr-aed.astro:who-line"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/heartsaver-cpr-aed.astro:who-grid">
        <!-- 1. Workplace Safety Teams -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:who-card-1">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-cpr-aed.astro:u7ixyl">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:who-icon-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-cpr-aed.astro:u7ixym">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:who-title-1">
                Workplace Safety Teams
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:who-desc-1">
                Ensure your team is prepared to handle emergencies at work.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Teachers and Coaches -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:who-card-2">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-cpr-aed.astro:u7ixyn">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:who-icon-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-cpr-aed.astro:u7ixyo">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:who-title-2">
                Teachers and Coaches
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:who-desc-2">
                Be prepared to protect your students and athletes.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Parents and Caregivers -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border hover:border-primary/50 transition-colors shadow-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:who-card-3">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-cpr-aed.astro:u7ixyp">
            <div class="w-10 h-10 rounded-xl bg-amber-subtle text-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-cpr-aed.astro:who-icon-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-cpr-aed.astro:u7ixyq">
              <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/heartsaver-cpr-aed.astro:who-title-3">
                Parents and Caregivers
              </h3>
              <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-cpr-aed.astro:who-desc-3">
                Gain peace of mind knowing you can respond to your child's needs.
              </p>
            </div>
          </div>
        </div>

        <!-- 4. Community Members -->
