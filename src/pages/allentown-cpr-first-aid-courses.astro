---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'Allentown CPR & First Aid Training | Eastern PA Educators';
const description = 'Our Allentown first aid instructors lead educational courses that cover CPR, AED, bloodborne pathogens, basic life support & more vital safety topics.';
const canonicalUrl = 'https://www.easternpaeducators.com/allentown-cpr-first-aid-courses/';
---

<BaseLayout headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Allentown CPR & First Aid Training',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US'
      }
    }
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:65npao">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte2c">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="Allentown CPR Teachers Demonstrating Proper CPR Technique"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1905"
        height="250" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:t82ieq" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte2b"></div>
      
      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte2a">
        <Container>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:3116fz">
            ALLENTOWN CPR & FIRST AID TRAINING
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Regional Education Overview & 4 Key Benefits -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:65npan">
    <Container class="max-w-6xl">
      <!-- Badge + Heading -->
      <div class="text-center mb-12" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1o">
        <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr38w">
          Certified Regional Education
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground tracking-tight font-heading uppercase" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:hpg3nm">
          ALLENTOWN PENNSYLVANIA'S BEST FIRST AID COURSES
        </h2>
      </div>

      <!-- Top Row: Video/Thumbnail Left (5 Cols) + Content Right (7 Cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-16" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1n">
        <!-- Media Block -->
        <div class="lg:col-span-6" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1m">
          <div class="relative rounded-2xl overflow-hidden border border-border shadow-xl bg-dark-background aspect-[16/10] group" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1l">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/63861c_e045c4fbd32242aebf8d84d0fa599553f000-0a755b-320.webp"
              alt="cpr certification classes in pa - first aid training king of prussia pa red cross"
              class="w-full h-full object-cover brightness-90 group-hover:scale-105 transition-transform duration-500"
              width="526"
              height="294"
              loading="lazy" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:t82iep" />
            <div class="absolute inset-0 bg-dark-background/40 flex items-center justify-center" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1k">
              <div class="w-16 h-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center shadow-lg transition-transform group-hover:scale-110" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1j">
                <svg class="w-8 h-8 ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
            <div class="absolute bottom-0 inset-x-0 bg-dark-background/90 backdrop-blur-sm px-4 py-2.5 flex items-center justify-between text-xs text-dark-muted-foreground border-t border-dark-border" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1i">
              <span class="inline-flex items-center gap-1.5 font-medium text-dark-foreground" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr38x">
                <span class="w-2 h-2 rounded-full bg-red-500" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr38y"></span>
                On-Site & Class Training
              </span>
              <span data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr38z">Allentown, PA</span>
            </div>
          </div>
        </div>

        <!-- Editorial Text -->
        <div class="lg:col-span-6 space-y-4" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1h">
          <p class="text-base sm:text-lg text-foreground/90 leading-relaxed" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9gm">
            Eastern PA Educators provides the most comprehensive first aid courses in Allentown, Pennsylvania, designed to teach essential life-saving skills. Our experienced, American Heart Association-certified instructors cover a wide range of first aid techniques, including CPR, wound care, choking response, and how to manage burns or fractures.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9gn">
            First aid training is important for everyone, regardless of age or profession. Emergencies can strike at any moment, and knowing how to respond, whether by stopping bleeding, performing CPR, or stabilizing an injury, can save lives. Equip yourself with the skills to make a difference in critical moments.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1g">
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte1f">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0t">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr390"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39m">Critical Preparation</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9go">Designed for educators, healthcare professionals, childcare staff, and local organizations.</p>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0s">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0r">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39n"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39o">Life-Saving Readiness</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9gp">Evidence-based instruction with hands-on clinical simulation for emergency scenarios.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Why Choose Section -->
      <div class="text-center mb-10 pt-6 border-t border-border" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0q">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-foreground font-heading tracking-tight mb-2" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:wdv0vu">
          Benefits of Choosing Our Allentown Instructors for BLS, CPR, & First Aid Training
        </h3>
        <p class="text-sm text-muted-foreground" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9gq">
          Trusted certified instructors delivering high-impact life safety training with realistic equipment.
        </p>
      </div>

      <!-- 4 Numbered Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0p">
        <!-- 01 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0o">
          <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39p">
            01
          </span>
          <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:nyu3vl">1. Instruction by Certified Professionals</h4>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9gr">
            Our courses are led by some of Pennsylvania's finest instructors whose extensive knowledge and first-hand experience helps ensure that you're receiving the best possible education. Training goes beyond basic concepts, providing advanced knowledge and skill sets needed for managing critical incidents with confidence and precision.
          </p>
        </div>

        <!-- 02 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0n">
          <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39q">
            02
          </span>
          <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:nyu3vm">2. Flexible Scheduling for Demanding Workloads</h4>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9hd">
            We understand the fluctuating schedules of healthcare professionals, which is why we offer tailored training sessions, including evenings, weekends, and group options, to fit the most demanding timetables.
          </p>
        </div>

        <!-- 03 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0m">
          <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39r">
            03
          </span>
          <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:nyu3vn">3. Industry-Approved, Employer-Recognized Certifications</h4>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9he">
            All programs align with Pennsylvania state regulations and are recognized across healthcare systems, academic institutions, and childcare organizations. Certifications are issued through the American Heart Association (AHA) and American Red Cross (ARC), guaranteeing compliance with industry mandates.
          </p>
        </div>

        <!-- 04 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0l">
          <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39s">
            04
          </span>
          <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:nyu3vo">4. Focus on Hands-On Clinical Proficiency</h4>
          <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9hf">
            Our curriculum emphasizes practical application, including high-fidelity training on advanced simulation manikins, AED (Automated External Defibrillator) operation, and high-quality CPR performance. Participants will gain the technical competencies required to effectively manage real-world emergencies.
          </p>
        </div>
      </div>

      <!-- Callout Highlight Quote Box -->
      <div class="p-6 rounded-2xl bg-amber-subtle border border-amber-200/80 text-center max-w-4xl mx-auto mb-14" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qpte0k">
        <p class="text-sm md:text-base text-foreground font-medium m-0 leading-relaxed" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9hg">
          KRE Security provides an interactive, scenario-based learning experience using advanced CPR mannequins, AED simulators, and first aid tools to ensure realistic skill application. Our mission is to equip participants with practical, hands-on training to confidently handle real-world medical emergencies.
        </p>
      </div>

      <!-- Accreditation Row -->
      <div class="text-center pt-6 border-t border-border" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzy">
        <span class="block text-xs uppercase tracking-widest text-muted-foreground font-bold mb-6" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39t">
          Nationally Recognized Training Standards & Certifications
        </span>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzx">
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzw">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/american_heart_association_logo-8fc04c-122.webp"
              alt="AHA Logo"
              class="h-10 w-auto object-contain"
              width="122"
              height="60"
              loading="lazy" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:t82ieo" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzv">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc~-824966-114.webp"
              alt="Red Cross Logo"
              class="h-10 w-auto object-contain"
              width="114"
              height="112"
              loading="lazy" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:t82ien" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzu">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/osha-logo-dceaa1-100.webp"
              alt="OSHA Logo"
              class="h-7 w-auto object-contain"
              width="100"
              height="29"
              loading="lazy" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:t82iem" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzt">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/ashi-approved-training-center-logo-799753-67.webp"
              alt="ASHI Approved Training Center Logo"
              class="h-12 w-auto object-contain"
              width="67"
              height="70"
              loading="lazy" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:t82iel" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzs">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/nfpa-member-logo-31BDF5EC99-seeklogo_com-dec389-79.webp"
              alt="NFPA Member Logo"
              class="h-12 w-auto object-contain"
              width="79"
              height="90"
              loading="lazy" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:t82idz" />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. Comprehensive Course Offerings Card Container -->
  <section class="py-14 md:py-20 bg-surface text-foreground border-y border-border" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:65npam">
    <Container class="max-w-4xl">
      <div class="bg-background rounded-3xl border border-border shadow-xl overflow-hidden" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzr">
        <div class="p-8 sm:p-10 md:p-12" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzq">
          <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39u">
            Comprehensive Course Offerings
          </span>

          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground font-heading tracking-tight mb-4" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:hpg3nl">
            Get Certified by Our Allentown PA CPR & First Aid Instructors
          </h2>

          <div class="space-y-4 text-sm sm:text-base text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdzp">
            <p data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9hh">
              KRE Security delivers customized CPR certification, first aid, and automated external defibrillator (AED) training programs tailored to the unique requirements of businesses, healthcare facilities, community organizations, and private groups. Our courses are accredited by the American Heart Association (AHA) and the American Red Cross, guaranteeing industry-standard, evidence-based training methodologies.
            </p>
            <p data-ps="src/pages/allentown-cpr-first-aid-courses.astro:u0w9hi">
              Whether you are a medical professional, emergency responder, or community member, we offer a full spectrum of training options, including AHA-certified Basic Life Support (BLS) and advanced first aid courses.
            </p>
          </div>

          <!-- Courses Grid -->
          <div class="mb-8" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdz3">
            <h3 class="text-base font-bold text-foreground uppercase tracking-wider font-heading mb-4" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:wdv0vt">
              Our First Aid & CPR Training Options Include:
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdz2">
              <a href="/heartsaver-first-aid" class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:xpcsad">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdz1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr39v">Heartsaver First Aid</span>
              </a>

              <div class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border text-foreground" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdz0">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdyz">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm font-semibold" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr3ah">Heartsaver CPR/AED</span>
              </div>

              <div class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border text-foreground" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdyy">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdyx">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-sm font-semibold" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:jtr3ai">Friends and Family CPR Certification</span>
              </div>

              <a href="/basic-life-support-certification" class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:xpcsac">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0" data-ps="src/pages/allentown-cpr-first-aid-courses.astro:qptdyw">
