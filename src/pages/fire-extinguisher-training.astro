---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'Fire Extinguisher Training Courses | Eastern PA Educators';
const description = 'Our certified first aid and fire safety instructors offer comprehensive Fire Extinguisher Training classes across Eastern PA. Master fire safety, protect lives, and secure your property!';
const canonicalUrl = 'https://www.easternpaeducators.com/fire-extinguisher-training/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Fire Extinguisher Training',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US'
      }
    }
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/fire-extinguisher-training.astro:56yazb">
    <div class="relative w-full h-[220px] sm:h-[280px] md:h-[340px] lg:h-[380px] overflow-hidden" data-ps="src/pages/fire-extinguisher-training.astro:otn15w">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="Fire Extinguisher Training in Eastern PA"
        class="w-full h-full object-cover object-center brightness-60"
        loading="eager"
        fetchpriority="high"
        width="1905"
        height="250" data-ps="src/pages/fire-extinguisher-training.astro:rbw5i5" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background via-dark-background/60 to-transparent flex items-center justify-center" data-ps="src/pages/fire-extinguisher-training.astro:otn15v">
        <Container class="text-center">
          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-primary mb-3" data-ps="src/pages/fire-extinguisher-training.astro:vq4pk9">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse" data-ps="src/pages/fire-extinguisher-training.astro:vq4pk8"></span>
            Certified Public Safety Program
          </span>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/fire-extinguisher-training.astro:tv4sfq">
            Fire Extinguisher Training
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Learn How to Use a Fire Extinguisher Section -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/fire-extinguisher-training.astro:56yayp">
    <Container class="max-w-5xl">
      <div class="text-center max-w-3xl mx-auto mb-10" data-ps="src/pages/fire-extinguisher-training.astro:otn15u">
        <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/fire-extinguisher-training.astro:vq4pk7">
          Emergency Preparedness
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground tracking-tight font-heading uppercase" data-ps="src/pages/fire-extinguisher-training.astro:f6pv81">
          Learn How to Use a Fire Extinguisher with Eastern PA Educators
        </h2>
        <div class="w-20 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/fire-extinguisher-training.astro:otn15t"></div>
      </div>

      <div class="p-6 sm:p-8 md:p-10 rounded-2xl bg-surface border border-border shadow-sm" data-ps="src/pages/fire-extinguisher-training.astro:otn15s">
        <p class="text-base sm:text-lg md:text-xl text-foreground/90 leading-relaxed font-medium m-0" data-ps="src/pages/fire-extinguisher-training.astro:scmlun">
          Every year, fires cause significant damage to property, endanger lives, and lead to costly repairs and recovery. Being prepared and knowing how to use a fire extinguisher can make all the difference during an emergency. At Eastern PA Educators, we offer comprehensive Fire Extinguisher Training classes designed to equip you with the skills and knowledge needed to act swiftly and effectively when every second counts.
        </p>
      </div>
    </Container>
  </section>

  <!-- 3. Master Fire Safety Section -->
  <section class="py-14 md:py-20 bg-surface border-y border-border" data-ps="src/pages/fire-extinguisher-training.astro:56yayo">
    <Container class="max-w-5xl">
      <div class="text-center max-w-3xl mx-auto mb-12" data-ps="src/pages/fire-extinguisher-training.astro:otn156">
        <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/fire-extinguisher-training.astro:vq4pk6">
          Curriculum & Protocols
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground tracking-tight font-heading" data-ps="src/pages/fire-extinguisher-training.astro:f6pv82">
          Master Fire Safety, Protect Lives, &amp; Secure Your Property
        </h2>
        <p class="text-base text-muted-foreground mt-3" data-ps="src/pages/fire-extinguisher-training.astro:scmluo">
          Our expertly crafted courses cover everything you need to know about fire safety:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/fire-extinguisher-training.astro:otn155">
        <!-- Card 1 -->
        <div class="p-6 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/fire-extinguisher-training.astro:otn154">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/fire-extinguisher-training.astro:otn153">
            01
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/fire-extinguisher-training.astro:iaxzn">Understanding Fire Types</h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/fire-extinguisher-training.astro:scmlup">
            Learn about different types of fires and the appropriate extinguishers to use for each.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="p-6 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/fire-extinguisher-training.astro:otn152">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/fire-extinguisher-training.astro:otn151">
            02
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/fire-extinguisher-training.astro:iaxzo">Proper Extinguisher Use</h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/fire-extinguisher-training.astro:scmluq">
            Get hands-on training on how to use a fire extinguisher correctly, following the PASS (Pull, Aim, Squeeze, Sweep) technique.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="p-6 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/fire-extinguisher-training.astro:otn150">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/fire-extinguisher-training.astro:otn14z">
            03
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/fire-extinguisher-training.astro:iaxzp">Safety Protocols</h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/fire-extinguisher-training.astro:scmlvc">
            Understand the safety measures and protocols to follow before, during, and after using a fire extinguisher.
          </p>
        </div>

        <!-- Card 4 -->
        <div class="p-6 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/fire-extinguisher-training.astro:otn14y">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/fire-extinguisher-training.astro:otn14x">
            04
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/fire-extinguisher-training.astro:iaxzq">Fire Prevention Tips</h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/fire-extinguisher-training.astro:scmlvd">
            Gain valuable insights into preventing fires in the first place, safeguarding your workplace, facility, and loved ones.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. Why Choose Our Instructors Section -->
  <section class="py-14 md:py-20 bg-dark-background text-dark-foreground" data-ps="src/pages/fire-extinguisher-training.astro:56yayn">
    <Container class="max-w-5xl">
      <div class="text-center max-w-3xl mx-auto mb-12" data-ps="src/pages/fire-extinguisher-training.astro:otn14b">
        <span class="inline-block px-3 py-1 rounded bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-3 border border-primary/30" data-ps="src/pages/fire-extinguisher-training.astro:vq4pk5">
          Professional Pedigree
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary tracking-tight font-heading" data-ps="src/pages/fire-extinguisher-training.astro:f6pv83">
          Why Choose Our Instructors?
        </h2>
        <p class="text-sm sm:text-base text-dark-muted-foreground mt-4 leading-relaxed" data-ps="src/pages/fire-extinguisher-training.astro:scmlve">
          In a fire emergency, every second counts. Knowing how to operate a fire extinguisher can mean the difference between a small manageable incident and a catastrophic disaster. Here are some of the key reasons why our Fire Extinguisher Training classes are vital:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-ps="src/pages/fire-extinguisher-training.astro:otn14a">
        <!-- Item 1 -->
        <div class="p-6 rounded-2xl bg-dark-border/40 border border-dark-border shadow-sm flex flex-col justify-between" data-ps="src/pages/fire-extinguisher-training.astro:otn149">
          <div data-ps="src/pages/fire-extinguisher-training.astro:otn148">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/fire-extinguisher-training.astro:otn147">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-dark-foreground font-heading mb-2" data-ps="src/pages/fire-extinguisher-training.astro:iaxzr">Fire Safety for All Ages</h3>
            <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/fire-extinguisher-training.astro:scmlvf">
              Everyone should know how to use a fire extinguisher, regardless of age or physical ability. Our courses are designed to be accessible and informative for individuals of all backgrounds and abilities.
            </p>
          </div>
        </div>

        <!-- Item 2 -->
        <div class="p-6 rounded-2xl bg-dark-border/40 border border-dark-border shadow-sm flex flex-col justify-between" data-ps="src/pages/fire-extinguisher-training.astro:otn146">
          <div data-ps="src/pages/fire-extinguisher-training.astro:otn145">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/fire-extinguisher-training.astro:otn144">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-dark-foreground font-heading mb-2" data-ps="src/pages/fire-extinguisher-training.astro:iaxzs">Compliance with Regulations</h3>
            <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/fire-extinguisher-training.astro:scmlvg">
              In many workplaces, having staff trained in fire safety is mandatory to comply with health and safety regulations. Our classes ensure that you meet these requirements.
            </p>
          </div>
        </div>

        <!-- Item 3 -->
        <div class="p-6 rounded-2xl bg-dark-border/40 border border-dark-border shadow-sm flex flex-col justify-between" data-ps="src/pages/fire-extinguisher-training.astro:otn143">
          <div data-ps="src/pages/fire-extinguisher-training.astro:otn142">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/fire-extinguisher-training.astro:otn13g">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-dark-foreground font-heading mb-2" data-ps="src/pages/fire-extinguisher-training.astro:iaxzt">Peace of Mind</h3>
            <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/fire-extinguisher-training.astro:scmlvh">
              By learning how to use a fire extinguisher, you can have peace of mind knowing that you are prepared for any potential fire emergency.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 5. Ready to Get Started Section -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden py-16 md:py-24 border-b border-dark-border" data-ps="src/pages/fire-extinguisher-training.astro:56yaym">
    <div class="absolute inset-0 z-0" data-ps="src/pages/fire-extinguisher-training.astro:otn13f">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_469d743bfd38472a8549e40154518014~mv2_d_2016_1512_s_2-79015e-1536.webp"
        alt="Ready to get started with Fire Extinguisher Training"
        class="w-full h-full object-cover object-center brightness-40"
        loading="lazy"
        width="1905"
        height="275" data-ps="src/pages/fire-extinguisher-training.astro:rbw5i4" />
      <div class="absolute inset-0 bg-dark-background/80" data-ps="src/pages/fire-extinguisher-training.astro:otn13e"></div>
    </div>

    <Container class="relative z-10 text-center max-w-3xl">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight font-heading uppercase mb-4" data-ps="src/pages/fire-extinguisher-training.astro:f6pv84">
        Ready to Get Started?
      </h2>
      <p class="text-base sm:text-lg text-dark-foreground/90 leading-relaxed mb-2 font-medium" data-ps="src/pages/fire-extinguisher-training.astro:scmlvi">
        Don’t wait until an emergency happens. Equip yourself with the skills needed to save lives today.
      </p>
      <p class="text-base sm:text-lg text-dark-muted-foreground leading-relaxed mb-8" data-ps="src/pages/fire-extinguisher-training.astro:scmlvj">
        Sign up for our Heartsaver First Aid classes now and be prepared for any situation.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-md bg-primary text-primary-foreground font-bold text-base hover:bg-primary-hover transition-colors shadow-lg no-underline"
       data-ps="src/pages/fire-extinguisher-training.astro:xszbyk">
        Contact Us for a Quote
      </a>
    </Container>
  </section>

  <!-- 6. Contact / Quote Form & Stay Updated Section -->
  <section id="contact" class="relative isolate bg-background text-foreground py-16 md:py-24" data-ps="src/pages/fire-extinguisher-training.astro:56yayl">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12" data-ps="src/pages/fire-extinguisher-training.astro:otn13d">
        <!-- Left: Contact Details & Office Locations (5 Cols) -->
        <div class="lg:col-span-5 flex flex-col justify-between" data-ps="src/pages/fire-extinguisher-training.astro:otn13c">
          <div data-ps="src/pages/fire-extinguisher-training.astro:otn13b">
            <span class="text-xs font-bold uppercase tracking-wider text-primary mb-2 block" data-ps="src/pages/fire-extinguisher-training.astro:vq4pk4">
              Direct Contact
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight mb-4 uppercase font-heading" data-ps="src/pages/fire-extinguisher-training.astro:f6pv85">
              CONTACT US FOR A QUOTE
            </h2>

            <!-- Direct Phone & Email Cards -->
            <div class="space-y-4 mb-8" data-ps="src/pages/fire-extinguisher-training.astro:otn13a">
              <a
                href={`tel:${SITE.phone}`}
                class="flex items-center gap-4 p-4 rounded-xl bg-surface border border-border hover:border-primary transition-colors no-underline group shadow-sm"
               data-ps="src/pages/fire-extinguisher-training.astro:xszbyl">
                <div class="w-12 h-12 rounded-lg bg-amber-subtle flex items-center justify-center text-foreground font-bold shrink-0" data-ps="src/pages/fire-extinguisher-training.astro:otn139">
                  <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div data-ps="src/pages/fire-extinguisher-training.astro:otn138">
                  <span class="block text-xs uppercase tracking-wider text-muted-foreground font-bold" data-ps="src/pages/fire-extinguisher-training.astro:lw15f7">Direct Phone</span>
                  <span class="text-lg font-bold text-foreground group-hover:text-primary transition-colors" data-ps="src/pages/fire-extinguisher-training.astro:lw15f8">{SITE.phone}</span>
                </div>
              </a>

              <a
                href={`mailto:${SITE.email}`}
                class="flex items-center gap-4 p-4 rounded-xl bg-surface border border-border hover:border-primary transition-colors no-underline group shadow-sm"
               data-ps="src/pages/fire-extinguisher-training.astro:xszbym">
                <div class="w-12 h-12 rounded-lg bg-amber-subtle flex items-center justify-center text-foreground font-bold shrink-0" data-ps="src/pages/fire-extinguisher-training.astro:otn137">
                  <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div data-ps="src/pages/fire-extinguisher-training.astro:otn12l">
                  <span class="block text-xs uppercase tracking-wider text-muted-foreground font-bold" data-ps="src/pages/fire-extinguisher-training.astro:lw15f9">Email Inquiries</span>
                  <span class="text-base font-bold text-foreground group-hover:text-primary transition-colors" data-ps="src/pages/fire-extinguisher-training.astro:lw15fa">{SITE.email}</span>
                </div>
              </a>
            </div>

            <!-- Physical Offices -->
            <div class="p-5 rounded-xl bg-surface border border-border text-sm text-muted-foreground space-y-4" data-ps="src/pages/fire-extinguisher-training.astro:otn12k">
              <div data-ps="src/pages/fire-extinguisher-training.astro:otn12j">
                <span class="block font-bold text-foreground uppercase tracking-wider text-xs mb-1" data-ps="src/pages/fire-extinguisher-training.astro:lw15fb">MAIN OFFICE</span>
                <p class="m-0 text-foreground font-medium" data-ps="src/pages/fire-extinguisher-training.astro:scmlvk">301 Chris Drive, Lenhartsville, PA 19534</p>
              </div>
              <div class="pt-3 border-t border-border" data-ps="src/pages/fire-extinguisher-training.astro:otn12i">
                <span class="block font-bold text-foreground uppercase tracking-wider text-xs mb-1" data-ps="src/pages/fire-extinguisher-training.astro:lw15fc">TRAINING OFFICE</span>
                <p class="m-0 text-foreground font-medium" data-ps="src/pages/fire-extinguisher-training.astro:scmlvl">11 South 3rd Street, Hamburg, PA 19526</p>
              </div>
            </div>
          </div>

          <div class="mt-8 p-4 rounded-lg bg-amber-subtle border border-amber-200 text-xs text-foreground font-medium" data-ps="src/pages/fire-extinguisher-training.astro:otn12h">
            We Are Fully Licensed and Insured. We Accept All Major Credit Card and Payment Plans.
          </div>
        </div>

        <!-- Right: Interactive Quote Form & Newsletter (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col gap-8" data-ps="src/pages/fire-extinguisher-training.astro:otn12g">
          <!-- Quote Request Form -->
          <div class="p-8 bg-surface rounded-2xl border border-border shadow-md" data-ps="src/pages/fire-extinguisher-training.astro:otn12f">
            <h3 class="text-xl font-bold text-foreground mb-2" data-ps="src/pages/fire-extinguisher-training.astro:iaxzu">Get In Touch</h3>
            <p class="text-sm text-muted-foreground mb-6" data-ps="src/pages/fire-extinguisher-training.astro:scmlw7">
              Fill out the details below and our certified safety instructors will get back to you promptly with course information and pricing.
            </p>

            <form id="fire-training-form" class="space-y-4">
              <input type="hidden" name="_formId" value="fire-extinguisher-quote" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/fire-extinguisher-training.astro:otn12e">
                <div data-ps="src/pages/fire-extinguisher-training.astro:otn12d">
                  <label for="name" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/fire-extinguisher-training.astro:q1qxca">Your Name *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="e.g. John Doe"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
                <div data-ps="src/pages/fire-extinguisher-training.astro:otn12c">
                  <label for="organization" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/fire-extinguisher-training.astro:q1qxcb">Organization / Business</label>
                  <input
                    type="text"
                    id="organization"
                    name="organization"
                    placeholder="e.g. Facility / Workplace / Group"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/fire-extinguisher-training.astro:5dsvis">
                <div data-ps="src/pages/fire-extinguisher-training.astro:5dsvir">
                  <label for="email" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/fire-extinguisher-training.astro:q1qxcc">Email Address *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="you@example.com"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
                <div data-ps="src/pages/fire-extinguisher-training.astro:5dsviq">
                  <label for="phone" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/fire-extinguisher-training.astro:q1qxcd">Phone Number *</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="484-000-0000"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/fire-extinguisher-training.astro:5dsvip">
                <div data-ps="src/pages/fire-extinguisher-training.astro:5dsvio">
                  <label for="program" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/fire-extinguisher-training.astro:q1qxce">Program of Interest</label>
                  <select
                    id="program"
                    name="program"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  >
                    <option value="Fire Extinguisher Training" selected>Fire Extinguisher Training</option>
                    <option value="Heartsaver First Aid">Heartsaver First Aid</option>
                    <option value="Heartsaver CPR AED">Heartsaver CPR AED</option>
                    <option value="Friends & Family CPR">Friends & Family CPR</option>
                    <option value="BLS for Healthcare Providers">BLS for Healthcare Providers</option>
                    <option value="Pediatric First Aid">Pediatric First Aid</option>
                    <option value="Bloodborne Pathogen Training">Bloodborne Pathogen Training</option>
                    <option value="PennDOT Flagger Certification">PennDOT Flagger Certification</option>
                    <option value="Red Cross CPR & First Aid">Red Cross CPR & First Aid</option>
                  </select>
                </div>
                <div data-ps="src/pages/fire-extinguisher-training.astro:5dsvin">
                  <label for="group-size" class="block text-xs font-bold text-foreground uppercase tracking-wider mb-1.5" data-ps="src/pages/fire-extinguisher-training.astro:q1qxcf">Estimated Group Size</label>
                  <input
                    type="text"
                    id="group-size"
                    name="groupSize"
                    placeholder="e.g. 5-15 people"
                    class="w-full px-4 py-2.5 rounded-md bg-background border border-border text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                  />
