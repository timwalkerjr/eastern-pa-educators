<script>
  import 'altcha';

  const form = document.getElementById('fire-training-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
    statusEl.className = 'hidden';

    const formData = new FormData(form);
    const payload = {
      _formId: formData.get('_formId') || 'fire-extinguisher-quote',
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      organization: formData.get('organization'),
      program: formData.get('program'),
      groupSize: formData.get('groupSize'),
      message: formData.get('message'),
      altcha: formData.get('altcha'),
      subject: 'Fire Extinguisher Training Quote Request - Eastern PA Educators',
    };

    try {
      const res = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await res.json();

      if (res.ok && result.success !== false) {
        statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-green-100 text-green-800 border border-green-200';
        statusEl.textContent = 'Thanks for submitting! We will contact you promptly.';
        form.reset();
      } else {
        throw new Error(result.error || 'Submission failed');
      }
    } catch (err) {
      statusEl.className = 'block text-sm font-semibold p-3 rounded-md mt-2 text-center bg-red-100 text-red-800 border border-red-200';
      statusEl.textContent = err instanceof Error ? err.message : 'Submission error. Please call us directly at 484-334-3577.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit';
    }
  });

  const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const newsletterStatus = document.getElementById('newsletter-status');

  newsletterForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!newsletterStatus) return;

    const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
    const email = emailInput?.value;
    if (!email) return;

    try {
      const res = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _formId: 'newsletter',
          email,
          subject: 'Newsletter Signup - Eastern PA Educators',
        }),
      });

      if (res.ok) {
        newsletterStatus.className = 'block text-xs font-semibold p-2 rounded mt-2 text-center bg-green-100 text-green-800';
        newsletterStatus.textContent = 'Thanks for submitting!';
        newsletterForm.reset();
      } else {
        throw new Error('Failed');
      }
    } catch {
      newsletterStatus.className = 'block text-xs font-semibold p-2 rounded mt-2 text-center bg-green-100 text-green-800';
      newsletterStatus.textContent = 'Thanks for submitting!';
      newsletterForm.reset();
    }
  });
</script>
