---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const pageTitle = "Harrisburg CPR & First Aid Training | Eastern PA Educators";
const pageDescription = "From CPR & first aid classes to fire extinguisher & bloodborne pathogen training, we're proud to provide Harrisburg with PA's best educational courses.";
const canonicalUrl = "https://www.easternpaeducators.com/harrisburg-cpr-first-aid-courses/";
---

<BaseLayout
  headerVariant="solid"
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Harrisburg CPR & First Aid Training',
    description: pageDescription,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
    areaServed: {
      '@type': 'City',
      name: 'Harrisburg, Pennsylvania',
    },
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:ycxya2">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1p6">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="Harrisburg CPR Teachers Demonstrating Proper CPR Technique"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1905"
        height="250" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:yb261k" />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1p5"></div>

      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1p4">
        <Container>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:ncytfp">
            Harrisburg CPR &amp; First Aid Training
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Regional Education Overview & 4 Key Benefits -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:ycxya3">
    <Container class="max-w-6xl">
      <!-- Badge + Heading -->
      <div class="text-center mb-12" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1p3">
        <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pdj">
          Certified Regional Education
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground tracking-tight font-heading uppercase" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:wzqbb7">
          HARRISBURG PA'S BEST FIRST AID &amp; CPR COURSES
        </h2>
      </div>

      <!-- Top Row: Video/Thumbnail Left (6 Cols) + Content Right (6 Cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-16" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1oh">
        <!-- Media Block -->
        <div class="lg:col-span-6" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1og">
          <div class="relative rounded-2xl overflow-hidden border border-border shadow-xl bg-dark-background aspect-[16/10] group" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1of">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/63861c_e045c4fbd32242aebf8d84d0fa599553f000-0a755b-320.webp"
              alt="cpr certification classes in pa - first aid training king of prussia pa red cross"
              class="w-full h-full object-cover brightness-90 group-hover:scale-105 transition-transform duration-500"
              width="526"
              height="294"
              loading="lazy" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:yb261j" />
            <div class="absolute inset-0 bg-dark-background/40 flex items-center justify-center" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1oe">
              <a
                href={`tel:${SITE.phone}`}
                class="w-16 h-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center shadow-lg transition-transform group-hover:scale-110"
                aria-label="Call for Harrisburg CPR training details"
               data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:dqktm8">
                <svg class="w-8 h-8 ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </a>
            </div>
            <div class="absolute bottom-0 inset-x-0 bg-dark-background/90 backdrop-blur-sm px-4 py-2.5 flex items-center justify-between text-xs text-dark-muted-foreground border-t border-dark-border" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1od">
              <span class="inline-flex items-center gap-1.5 font-medium text-dark-foreground" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pdk">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pdl"></span>
                On-Site &amp; Class Training
              </span>
              <span data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pe7">Harrisburg, PA</span>
            </div>
          </div>
        </div>

        <!-- Editorial Text -->
        <div class="lg:col-span-6 space-y-4" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1oc">
          <p class="text-base sm:text-lg text-foreground/90 leading-relaxed" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1ftub">
            Eastern PA Educators is the trusted leader in CPR and first aid certification in Harrisburg, delivering expert training to individuals and organizations alike. Whether you’re a teacher, childcare provider, healthcare professional, or simply someone who values the ability to save lives, our courses are designed to equip you with the skills and confidence needed to act in emergencies.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1ftua">
            At Eastern PA Educators, we recognize the critical importance of lifesaving skills. Emergencies are unpredictable—they can happen anytime, anywhere. Knowing how to respond effectively can mean the difference between life and death. From performing CPR to administering first aid to using an AED, our training empowers you to take decisive, life-saving action when it matters most.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1ob">
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1oa">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1o9">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pe8"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pe9">Critical Skills</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1ftu9">
                Tailored for educators, healthcare workers, childcare staff, and Harrisburg organizations.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1o8">
              <div class="flex items-center gap-2 mb-1" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1nm">
                <span class="w-2 h-2 rounded-full bg-primary" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pea"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-foreground" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15peb">Decisive Action</span>
              </div>
              <p class="text-xs text-muted-foreground m-0" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1ftu8">
                Evidence-based instruction with hands-on practice for real-world emergency readiness.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Why Choose Section -->
      <div class="text-center mb-10 pt-6 border-t border-border" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1nl">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-foreground font-heading tracking-tight mb-2" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:ibbe3k">
          Why Choose Eastern PA Educators for CPR &amp; First Aid Training in Harrisburg?
        </h3>
        <p class="text-sm text-muted-foreground" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1fttm">
          Trusted certified instructors delivering high-impact life safety training with realistic equipment.
        </p>
      </div>

      <!-- 4 Numbered Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1nk">
        <!-- 01 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1nj">
          <div data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1ni">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pec">
              01
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:3mwgvv">1. Expert-Led Training</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1fttl">
              Our certified instructors bring years of hands-on emergency experience, teaching you far beyond the basics. They draw on real-world insights to prepare you for the unexpected, ensuring you leave with the skills to handle any scenario.
            </p>
          </div>
        </div>

        <!-- 02 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1nh">
          <div data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1ng">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15ped">
              02
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:3mwgvw">2. Flexible Scheduling for Busy Lives</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1fttk">
              We understand your time is valuable. That’s why we offer evening, weekend, and customized group sessions to fit into even the busiest schedules.
            </p>
          </div>
        </div>

        <!-- 03 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1nf">
          <div data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1ne">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pee">
              03
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:3mwgvx">3. Recognized, Employer-Approved Certifications</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1fttj">
              Our courses meet Pennsylvania state requirements and are widely accepted by employers, schools, healthcare facilities, and childcare organizations. With certifications backed by the American Heart Association (AHA) and American Red Cross, you can trust the quality and credibility of your training.
            </p>
          </div>
        </div>

        <!-- 04 -->
        <div class="p-6 rounded-2xl bg-surface border border-border hover:border-primary/50 transition-colors shadow-sm relative flex flex-col justify-between" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1nd">
          <div data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1mr">
            <span class="inline-block px-2.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold mb-3 border border-amber-200/60" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pef">
              04
            </span>
            <h4 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:3mwgvy">4. Hands-On, Practical Learning</h4>
            <p class="text-sm text-muted-foreground leading-relaxed m-0" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1ftti">
              We emphasize interactive, hands-on training that builds real-world confidence. From practicing CPR on state-of-the-art manikins to mastering AED use, you’ll leave our courses fully prepared to respond to emergencies with precision and clarity.
            </p>
          </div>
        </div>
      </div>

      <!-- Accreditation Row -->
      <div class="text-center pt-6 border-t border-border" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1mq">
        <span class="block text-xs uppercase tracking-widest text-muted-foreground font-bold mb-6" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15peg">
          Nationally Recognized Training Standards &amp; Certifications
        </span>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1mp">
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1mo">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/american_heart_association_logo-8fc04c-122.webp"
              alt="AHA Logo"
              class="h-10 w-auto object-contain"
              width="122"
              height="60"
              loading="lazy" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:yb261i" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1mn">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/39725c_bf51904ac9fe49bbaa66b0cd3459bcfc~-824966-114.webp"
              alt="Red Cross Logo"
              class="h-10 w-auto object-contain"
              width="114"
              height="112"
              loading="lazy" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:yb261h" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1mm">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/osha-logo-dceaa1-100.webp"
              alt="OSHA Logo"
              class="h-7 w-auto object-contain"
              width="100"
              height="29"
              loading="lazy" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:yb261g" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1ml">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/ashi-approved-training-center-logo-799753-67.webp"
              alt="ASHI Approved Training Center Logo"
              class="h-12 w-auto object-contain"
              width="67"
              height="70"
              loading="lazy" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:yb261f" />
          </div>
          <div class="p-3 rounded-xl bg-surface border border-border/80 shadow-sm hover:border-primary transition-colors flex items-center justify-center min-w-[100px] h-20" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1mk">
            <img
              src="https://pagesmith-cdn.com/e5b58edc/images/nfpa-member-logo-31BDF5EC99-seeklogo_com-dec389-79.webp"
              alt="NFPA Member Logo"
              class="h-12 w-auto object-contain"
              width="79"
              height="90"
              loading="lazy" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:yb261e" />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. Comprehensive Course Offerings Card Container -->
  <section class="py-14 md:py-20 bg-surface text-foreground border-y border-border" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:ycxya4">
    <Container class="max-w-4xl">
      <div class="bg-background rounded-3xl border border-border shadow-xl overflow-hidden" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1mj">
        <div class="p-8 sm:p-10 md:p-12" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1mi">
          <span class="inline-block px-3 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pf2">
            Comprehensive Course Offerings
          </span>

          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground font-heading tracking-tight mb-4" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:wzqbbt">
            Customized CPR, First Aid, and AED Training in Harrisburg PA
          </h2>

          <div class="space-y-4 text-sm sm:text-base text-muted-foreground leading-relaxed mb-8" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1lw">
            <p data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:l1ftth">
              Our Harrisburg safety instructors offer tailored certification programs to meet the unique needs of businesses, civic groups, and private organizations. Backed by the American Heart Association and American Red Cross, our training is synonymous with excellence. Whether you’re a seasoned healthcare professional or learning these skills for the first time, our comprehensive courses—including AHA and BLS curricula—are designed to meet your specific requirements. We ensure you’re equipped with the knowledge and techniques to save lives.
            </p>
          </div>

          <!-- Courses Grid -->
          <div class="mb-8" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1lv">
            <h3 class="text-base font-bold text-foreground uppercase tracking-wider font-heading mb-4" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:ibbe3l">
              Our Available Harrisburg First Aid Training Classes Include:
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1lu">
              <a
                href="/heartsaver-first-aid"
                class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group"
               data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:dqktm7">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1lt">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pf3">Heartsaver First Aid</span>
              </a>

              <div class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border text-foreground" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1ls">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1lr">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm font-semibold" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pf4">Heartsaver CPR/AED</span>
              </div>

              <a
                href="/friends-family-cpr-certification"
                class="flex items-center gap-3 p-3.5 rounded-xl bg-surface border border-border hover:border-primary transition-all no-underline text-foreground group"
               data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:dqktm6">
                <div class="w-5 h-5 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-primary-foreground transition-colors" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:vst1lq">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm font-semibold group-hover:text-primary transition-colors" data-ps="src/pages/harrisburg-cpr-first-aid-courses.astro:s15pf5">Friends and Family CPR Certification</span>
              </a>

              <a
                href="/basic-life-support-certification"
