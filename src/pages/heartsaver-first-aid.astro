---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const title = 'Heartsaver First Aid Training Courses | Eastern PA Educators';
const description = 'Our certified first aid instructors are here to help you learn everything you need to know about Heartsaver First Aid. For expert training, call today!';
const canonicalUrl = 'https://www.easternpaeducators.com/heartsaver-first-aid/';
---

<BaseLayout
  headerVariant="solid"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Heartsaver First Aid Training',
    description: description,
    provider: {
      '@type': 'EducationalOrganization',
      name: SITE.name,
      url: SITE.url,
      telephone: SITE.phone,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '16600 Pottsville Pike',
        addressLocality: 'Hamburg',
        addressRegion: 'PA',
        postalCode: '19526',
        addressCountry: 'US',
      },
    },
  }}
>
  <!-- 1. Hero Poster Banner -->
  <section class="relative isolate bg-dark-background text-dark-foreground overflow-hidden border-b border-dark-border" data-ps="src/pages/heartsaver-first-aid.astro:hero-section">
    <div class="relative w-full h-[240px] sm:h-[300px] md:h-[380px] lg:h-[420px] overflow-hidden" data-ps="src/pages/heartsaver-first-aid.astro:hero-wrap">
      <img
        src="https://pagesmith-cdn.com/e5b58edc/images/63861c_96646e8278fc401aad2881b42302b84b~mv2_d_2016_1512_s_2-05bb38-1536.webp"
        alt="cpr certification PA - first aid certification training ready response bucks county pa"
        class="w-full h-full object-cover object-center brightness-75"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="420"
        data-ps="src/pages/heartsaver-first-aid.astro:hero-img"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-dark-background/95 via-dark-background/60 to-dark-background/40" data-ps="src/pages/heartsaver-first-aid.astro:hero-overlay"></div>

      <div class="absolute inset-0 flex items-center justify-center text-center p-4" data-ps="src/pages/heartsaver-first-aid.astro:hero-content">
        <Container>
          <div class="inline-block px-4 py-1.5 rounded bg-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-3 border border-primary/30" data-ps="src/pages/heartsaver-first-aid.astro:hero-badge">
            Certified Public Safety Program
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight uppercase font-heading drop-shadow-md" data-ps="src/pages/heartsaver-first-aid.astro:hero-h1">
            Heartsaver First Aid Training
          </h1>
        </Container>
      </div>
    </div>
  </section>

  <!-- 2. Introduction & Overview Section -->
  <section class="py-14 md:py-20 bg-background text-foreground" data-ps="src/pages/heartsaver-first-aid.astro:intro-section">
    <Container class="max-w-4xl text-center">
      <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200" data-ps="src/pages/heartsaver-first-aid.astro:intro-badge">
        Vital Emergency Education
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-6 uppercase" data-ps="src/pages/heartsaver-first-aid.astro:intro-h2">
        Learn Life-Saving Skills with Heartsaver First Aid Classes
      </h2>
      <div class="w-16 h-1 bg-primary mx-auto mb-8 rounded-full" data-ps="src/pages/heartsaver-first-aid.astro:intro-cadence"></div>
      <div class="p-6 sm:p-8 md:p-10 rounded-2xl bg-surface border border-border shadow-sm text-left sm:text-center space-y-4" data-ps="src/pages/heartsaver-first-aid.astro:intro-card">
        <p class="text-base sm:text-lg text-foreground/90 leading-relaxed font-medium m-0" data-ps="src/pages/heartsaver-first-aid.astro:intro-p1">
          At Eastern PA Educators, we are dedicated to providing top-notch Heartsaver First Aid classes designed to equip you with the vital skills needed to respond confidently in emergency situations. Our certified first aid instructors bring years of experience and a passion for teaching, ensuring that you receive the highest quality first aid education available.
        </p>
        <p class="text-base sm:text-lg text-foreground/90 leading-relaxed font-medium m-0" data-ps="src/pages/heartsaver-first-aid.astro:intro-p2">
          Enroll in our Heartsaver First Aid courses and gain the knowledge that can save lives.
        </p>
      </div>
    </Container>
  </section>

  <!-- 3. Heartsaver First Aid Courses led by Certified Instructors (Amber Tone) -->
  <section class="py-14 md:py-20 bg-primary text-primary-foreground border-y border-amber-500/30" data-ps="src/pages/heartsaver-first-aid.astro:courses-section">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/heartsaver-first-aid.astro:courses-header">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary-foreground font-heading tracking-tight uppercase" data-ps="src/pages/heartsaver-first-aid.astro:courses-h2">
          Heartsaver First Aid Courses led by Certified Instructors
        </h2>
        <div class="w-16 h-1 bg-black mx-auto mt-4 rounded-full" data-ps="src/pages/heartsaver-first-aid.astro:courses-line"></div>
        <p class="text-base sm:text-lg font-medium text-primary-foreground/90 mt-4 max-w-2xl mx-auto" data-ps="src/pages/heartsaver-first-aid.astro:courses-intro">
          Our Heartsaver First Aid classes cover a comprehensive range of topics, including:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8" data-ps="src/pages/heartsaver-first-aid.astro:topics-grid">
        <!-- 1. Basic First Aid Techniques -->
        <div class="bg-black/90 text-white rounded-2xl p-6 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/heartsaver-first-aid.astro:topic-card-1">
          <div data-ps="src/pages/heartsaver-first-aid.astro:nm7kn8">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/heartsaver-first-aid.astro:topic-icon-1">
              01
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-first-aid.astro:topic-title-1">
              Basic First Aid Techniques
            </h3>
            <p class="text-sm text-neutral-300 leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:topic-desc-1">
              Learn how to address common injuries and emergencies.
            </p>
          </div>
        </div>

        <!-- 2. CPR and AED Training -->
        <div class="bg-black/90 text-white rounded-2xl p-6 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/heartsaver-first-aid.astro:topic-card-2">
          <div data-ps="src/pages/heartsaver-first-aid.astro:nm7kn7">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/heartsaver-first-aid.astro:topic-icon-2">
              02
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-first-aid.astro:topic-title-2">
              CPR and AED Training
            </h3>
            <p class="text-sm text-neutral-300 leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:topic-desc-2">
              Gain certification in cardiopulmonary resuscitation and automated external defibrillator use.
            </p>
          </div>
        </div>

        <!-- 3. Choking Relief -->
        <div class="bg-black/90 text-white rounded-2xl p-6 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/heartsaver-first-aid.astro:topic-card-3">
          <div data-ps="src/pages/heartsaver-first-aid.astro:nm7kn6">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/heartsaver-first-aid.astro:topic-icon-3">
              03
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-first-aid.astro:topic-title-3">
              Choking Relief
            </h3>
            <p class="text-sm text-neutral-300 leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:topic-desc-3">
              Understand the steps to assist a choking person effectively.
            </p>
          </div>
        </div>

        <!-- 4. Injury Prevention -->
        <div class="bg-black/90 text-white rounded-2xl p-6 shadow-md border border-black/40 flex flex-col justify-between" data-ps="src/pages/heartsaver-first-aid.astro:topic-card-4">
          <div data-ps="src/pages/heartsaver-first-aid.astro:nm7kn5">
            <div class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center font-extrabold text-sm mb-4" data-ps="src/pages/heartsaver-first-aid.astro:topic-icon-4">
              04
            </div>
            <h3 class="text-lg font-bold text-white font-heading mb-2" data-ps="src/pages/heartsaver-first-aid.astro:topic-title-4">
              Injury Prevention
            </h3>
            <p class="text-sm text-neutral-300 leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:topic-desc-4">
              Learn proactive measures to prevent accidents and injuries.
            </p>
          </div>
        </div>
      </div>

      <div class="p-6 rounded-2xl bg-black/80 text-white text-center border border-black/50 shadow-md max-w-3xl mx-auto" data-ps="src/pages/heartsaver-first-aid.astro:hands-on-note">
        <p class="text-sm sm:text-base font-medium m-0 leading-relaxed" data-ps="src/pages/heartsaver-first-aid.astro:hands-on-text">
          Our hands-on training approach ensures that you are not just learning theory but also practicing essential skills in a supportive environment.
        </p>
      </div>
    </Container>
  </section>

  <!-- 4. Who Should Attend? (Dark Obsidian Section) -->
  <section class="py-14 md:py-20 bg-dark-background text-dark-foreground border-b border-dark-border" data-ps="src/pages/heartsaver-first-aid.astro:who-section">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/heartsaver-first-aid.astro:who-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle/10 text-primary text-xs font-bold uppercase tracking-wider mb-3 border border-primary/20" data-ps="src/pages/heartsaver-first-aid.astro:who-badge">
          Target Audience
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-primary font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/heartsaver-first-aid.astro:who-h2">
          Who Should Attend?
        </h2>
        <p class="text-base sm:text-lg text-white max-w-3xl mx-auto leading-relaxed" data-ps="src/pages/heartsaver-first-aid.astro:who-intro">
          Our Heartsaver First Aid classes are perfect for:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/heartsaver-first-aid.astro:who-grid">
        <!-- 1. Parents and Caregivers -->
        <div class="p-6 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/heartsaver-first-aid.astro:who-card-1">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-first-aid.astro:nm7kn4">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-first-aid.astro:nm7kn3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-first-aid.astro:nm7kn2">
              <h3 class="text-lg font-bold text-white font-heading mb-1.5" data-ps="src/pages/heartsaver-first-aid.astro:who-title-1">
                Parents and Caregivers
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:who-desc-1">
                Ensure you can protect your loved ones.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Teachers and School Staff -->
        <div class="p-6 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/heartsaver-first-aid.astro:who-card-2">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-first-aid.astro:nm7kn1">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-first-aid.astro:nm7kn0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-first-aid.astro:nm7kmz">
              <h3 class="text-lg font-bold text-white font-heading mb-1.5" data-ps="src/pages/heartsaver-first-aid.astro:who-title-2">
                Teachers and School Staff
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:who-desc-2">
                Create a safer educational environment.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Workplace Safety Officers -->
        <div class="p-6 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between" data-ps="src/pages/heartsaver-first-aid.astro:who-card-3">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-first-aid.astro:nm7kmd">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-first-aid.astro:nm7kmc">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-first-aid.astro:nm7kmb">
              <h3 class="text-lg font-bold text-white font-heading mb-1.5" data-ps="src/pages/heartsaver-first-aid.astro:who-title-3">
                Workplace Safety Officers
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:who-desc-3">
                Enhance your company's emergency preparedness.
              </p>
            </div>
          </div>
        </div>

        <!-- 4. Community Volunteers -->
        <div class="p-6 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between md:col-span-1 lg:col-span-1" data-ps="src/pages/heartsaver-first-aid.astro:who-card-4">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-first-aid.astro:nm7kma">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-first-aid.astro:nm7km9">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-first-aid.astro:nm7km8">
              <h3 class="text-lg font-bold text-white font-heading mb-1.5" data-ps="src/pages/heartsaver-first-aid.astro:who-title-4">
                Community Volunteers
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:who-desc-4">
                Be ready to assist in local events and activities.
              </p>
            </div>
          </div>
        </div>

        <!-- 5. Anyone -->
        <div class="p-6 rounded-2xl bg-surface/5 border border-dark-border hover:border-primary/50 transition-colors shadow-sm flex flex-col justify-between md:col-span-2 lg:col-span-2" data-ps="src/pages/heartsaver-first-aid.astro:who-card-5">
          <div class="flex items-start gap-4" data-ps="src/pages/heartsaver-first-aid.astro:nm7km7">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center font-bold shrink-0 text-sm" data-ps="src/pages/heartsaver-first-aid.astro:nm7km6">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div data-ps="src/pages/heartsaver-first-aid.astro:nm7km5">
              <h3 class="text-lg font-bold text-white font-heading mb-1.5" data-ps="src/pages/heartsaver-first-aid.astro:who-title-5">
                Anyone
              </h3>
              <p class="text-sm text-dark-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:who-desc-5">
                Everyone can benefit from learning first aid skills.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 5. Benefits of Heartsaver First Aid Training Section -->
  <section class="py-14 md:py-20 bg-surface border-b border-border" data-ps="src/pages/heartsaver-first-aid.astro:benefits-section">
    <Container class="max-w-5xl">
      <div class="text-center mb-12" data-ps="src/pages/heartsaver-first-aid.astro:benefits-header">
        <span class="inline-block px-3.5 py-1 rounded bg-amber-subtle text-foreground text-xs font-bold uppercase tracking-wider mb-3 border border-amber-200" data-ps="src/pages/heartsaver-first-aid.astro:benefits-badge">
          Course Advantages
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-foreground font-heading tracking-tight mb-4 uppercase" data-ps="src/pages/heartsaver-first-aid.astro:benefits-h2">
          Benefits of Heartsaver First Aid Training
        </h2>
        <div class="w-16 h-1 bg-primary mx-auto mt-4 rounded-full" data-ps="src/pages/heartsaver-first-aid.astro:benefits-line"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/pages/heartsaver-first-aid.astro:benefits-grid">
        <!-- Benefit 1 -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/heartsaver-first-aid.astro:benefit-card-1">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/heartsaver-first-aid.astro:b-num-1">
            01
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/heartsaver-first-aid.astro:benefit-title-1">
            Certified Instructors
          </h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:benefit-desc-1">
            Learn from highly qualified first aid teachers with real-world experience.
          </p>
        </div>

        <!-- Benefit 2 -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/heartsaver-first-aid.astro:benefit-card-2">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/heartsaver-first-aid.astro:b-num-2">
            02
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/heartsaver-first-aid.astro:benefit-title-2">
            Comprehensive Curriculum
          </h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:benefit-desc-2">
            Our courses are designed to cover all essential first aid topics thoroughly.
          </p>
        </div>

        <!-- Benefit 3 -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/heartsaver-first-aid.astro:benefit-card-3">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/heartsaver-first-aid.astro:b-num-3">
            03
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/heartsaver-first-aid.astro:benefit-title-3">
            Hands-On Practice
          </h3>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed m-0" data-ps="src/pages/heartsaver-first-aid.astro:benefit-desc-3">
            Engage in practical exercises to build confidence in your abilities.
          </p>
        </div>

        <!-- Benefit 4 -->
        <div class="p-6 sm:p-8 rounded-2xl bg-background border border-border shadow-sm hover:border-primary/50 transition-colors" data-ps="src/pages/heartsaver-first-aid.astro:benefit-card-4">
          <div class="w-10 h-10 rounded-lg bg-amber-subtle text-foreground font-extrabold flex items-center justify-center mb-4 text-sm" data-ps="src/pages/heartsaver-first-aid.astro:b-num-4">
            04
          </div>
          <h3 class="text-lg font-bold text-foreground font-heading mb-2" data-ps="src/pages/heartsaver-first-aid.astro:benefit-title-4">
            Flexible Scheduling
          </h3>
